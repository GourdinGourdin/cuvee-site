# Adresse d'envoi du formulaire d'inscription (ex. Formspree : https://formspree.io/f/xxxxxxxx).
# Vide : succès simulé en local uniquement, message d'erreur en production.
PUBLIC_FORM_ENDPOINT=

# URL publique du site (utilisée pour les balises Open Graph et le sitemap).
# Inutile sur Netlify et Vercel : elle est détectée automatiquement.
SITE_URL=
