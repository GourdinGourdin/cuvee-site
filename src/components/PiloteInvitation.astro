---
import TitreSection from './TitreSection.astro';
import ACompleter from './ACompleter.astro';
import { avecPlaceholders } from '../lib/texte';

// TODO : conditions du pilote à valider par l’équipe (durée, prix, nombre de places, rythme des échanges).
const propose = [
  'Cuvée [À COMPLÉTER : offert / à prix réduit] pendant toute la durée du pilote ([À COMPLÉTER : durée]).',
  'La mise en place faite avec vous : on reprend votre inventaire actuel, même s’il est sur Excel ou dans un carnet.',
  'Un contact direct avec l’équipe : vos remarques sont lues par ceux qui construisent l’outil.',
  '[À COMPLÉTER : conditions après le pilote, par exemple un tarif préférentiel pour les lieux pilotes ?]',
];
const demande = [
  'Être un lieu indépendant qui travaille le vin : cave à manger, bar à vin ou restaurant avec une vraie carte des vins, entre 100 et 600 références.',
  'Nous laisser connecter votre caisse et nous transmettre vos factures fournisseurs pendant le pilote.',
  'Un court échange régulier ([À COMPLÉTER : fréquence et durée]) pour nous dire ce qui marche et ce qui coince.',
  'Votre franc-parler : si quelque chose ne sert à rien, dites-le. C’est le plus utile pour nous.',
];
const colonnes = [
  { id: 'propose-titre', titre: 'Ce que nous vous proposons', items: propose },
  { id: 'demande-titre', titre: 'Ce que nous vous demandons', items: demande },
];
---
<section id="pilote" aria-labelledby="invitation-titre" class="section bg-creme">
  <div class="conteneur">
    <div class="invitation-tete">
      <TitreSection libelle="Une invitation" id="invitation-titre" titre="Construisons-le ensemble, chez vous" />
      <div class="invitation-intro">
        <p class="texte-courant" data-reveal data-reveal-delai="3">
          Nous cherchons <ACompleter texte="nombre" /> bars à vin et caves à manger indépendants pour essayer Cuvée pendant
          le service, à partir de <ACompleter texte="mois de démarrage" />. Les conditions ci-dessous sont encore à valider
          par l’équipe.
        </p>
        <!-- TODO : n’afficher ce cartouche que si le nombre de places est réellement limité. -->
        <p class="surtitre mt-6 inline-block border border-dore px-4 py-2 text-encre" data-reveal data-reveal-delai="4">
          <ACompleter texte="N" /> places
        </p>
      </div>
    </div>

    <div class="fiche invitation-fiche mt-12 lg:mt-16" data-reveal data-reveal-delai="2">
      {
        colonnes.map((c) => (
          <section class="invitation-col" aria-labelledby={c.id}>
            <h3 id={c.id}>{c.titre}</h3>
            <ol role="list" class="invitation-liste">
              {c.items.map((item, i) => (
                <li>
                  <span class="invitation-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <p class="texte-courant" set:html={avecPlaceholders(item)} />
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .invitation-tete { display: grid; gap: var(--space-5); }
  .invitation-intro .texte-courant { max-width: 52ch; }
  @media (min-width: 64rem) {
    .invitation-tete { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-7); align-items: end; }
  }

  .invitation-fiche { padding: 0; display: grid; }
  .invitation-col { padding: var(--space-5) var(--space-5) var(--space-6); }
  .invitation-col + .invitation-col { border-top: 1px solid var(--color-filet); }
  @media (min-width: 40rem) { .invitation-col { padding: var(--space-7); } }
  @media (min-width: 64rem) {
    .invitation-fiche { grid-template-columns: 1fr 1fr; }
    .invitation-col { padding: var(--space-8); }
    .invitation-col + .invitation-col { border-top: 0; border-left: 1px solid var(--color-filet); }
  }

  .invitation-col h3 { color: var(--color-encre); }
  .invitation-liste { list-style: none; margin: var(--space-5) 0 0; padding: 0; }
  .invitation-liste li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-filet);
  }
  .invitation-liste li:first-child { border-top: 0; padding-top: 0; }
  .invitation-liste li:last-child { padding-bottom: 0; }
  .invitation-num {
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: calc(1.65 * 1.0625rem);
    color: var(--color-bordeaux);
    font-variant-numeric: tabular-nums;
  }
  .invitation-liste .texte-courant { margin: 0; }
  .invitation-liste mark { box-decoration-break: clone; -webkit-box-decoration-break: clone; }
</style>
