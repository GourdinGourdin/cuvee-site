---
import FonctionnementTitre from './FonctionnementTitre.astro';
import { avecPlaceholders } from '../lib/texte';

const principes = [
  {
    titre: 'Rien ne part sans votre feu vert',
    texte:
      "Aucune commande, aucun message à un domaine ne part sans votre validation. Cuvée peut se tromper : c’est pour ça que le dernier mot vous revient.",
  },
  {
    titre: 'Vos seuils, vos règles',
    texte:
      "Stock minimum par référence, délai au bout duquel une bouteille est considérée comme dormante : vous réglez, Cuvée suit. [À COMPLÉTER : autres réglages prévus pour le pilote]",
  },
  {
    titre: 'Tout est noté',
    texte:
      "Chaque proposition, chaque validation, chaque message envoyé est noté dans un journal, avec la date et l’heure. Vous savez toujours qui a décidé quoi.",
  },
  {
    titre: 'Vos vignerons restent les vôtres',
    texte:
      'Cuvée ne vend pas de vin et ne choisit pas vos fournisseurs. Il prépare les commandes pour les domaines et négociants avec qui vous travaillez déjà, et vous relisez chaque message avant qu’il parte.',
  },
];

type Statut = 'propose' | 'valide' | 'attente' | 'refuse';

// Journal d’exemple, cohérent avec les exemples de la page.
const journal: { jour: string; heure: string; action: string; statut: Statut }[] = [
  { jour: 'lun.', heure: '7 h 02', action: 'Commande préparée pour Domaine A (48 bouteilles)', statut: 'propose' },
  { jour: 'lun.', heure: '8 h 15', action: 'Commande Domaine A validée par vous, envoyée par email', statut: 'valide' },
  { jour: 'mar.', heure: '10 h 14', action: 'Facture Négociant B lue, 1 ligne confirmée par vous', statut: 'valide' },
  { jour: 'mer.', heure: '8 h 30', action: 'Muscadet sur lie au comptoir : idée retenue par vous', statut: 'valide' },
  { jour: 'jeu.', heure: '9 h 00', action: 'Relance livraison Domaine C préparée', statut: 'attente' },
  { jour: 'ven.', heure: '18 h 30', action: 'Côtes-du-Rhône blanc au verre : refusé par vous', statut: 'refuse' },
];

const libellesStatut: Record<Statut, string> = {
  propose: 'Proposé',
  valide: 'Validé',
  attente: 'En attente',
  refuse: 'Refusé',
};

const couleursStatut: Record<Statut, string> = {
  propose: 'text-encre-douce',
  valide: 'text-vert',
  attente: 'text-encre-douce',
  refuse: 'text-bordeaux',
};
---
<section id="controle" aria-labelledby="controle-titre" class="py-20 lg:py-28">
  <div class="conteneur grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
    <div>
      <FonctionnementTitre
        numero="03"
        libelle="Vous gardez la main"
        id="controle-titre"
        titre="C’est votre cave. Cuvée propose, <em class='text-bordeaux'>vous décidez</em>."
      />

      <dl class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {
          principes.map((p, i) => (
            <div class="principe border-t border-encre pt-4" data-reveal data-reveal-delai={String((i % 4) + 1)}>
              <dt class="font-serif text-xl leading-snug font-medium">{p.titre}</dt>
              <dd class="mt-2 text-encre-douce" set:html={avecPlaceholders(p.texte)} />
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="papier journal self-start lg:sticky lg:top-28" aria-labelledby="journal-legende" data-journal>
      <div class="flex items-center justify-between gap-3 border-b-2 border-encre px-5 py-4 sm:px-6">
        <figcaption id="journal-legende">
          <span class="block font-serif text-xl font-medium">Journal de cave</span>
          <span class="chiffres text-[0.8rem] text-encre-douce">Une semaine type · exemple illustratif</span>
        </figcaption>
        <svg width="34" height="34" viewBox="0 0 34 34" fill="none" stroke="currentColor" stroke-width="1.3" class="shrink-0 text-dore" aria-hidden="true">
          <rect x="6" y="3" width="22" height="28" rx="1.5" />
          <path d="M10 3v28M14 10h10M14 15h10M14 20h10M14 25h6" />
        </svg>
      </div>
      <ol role="list" class="journal-lignes divide-y divide-filet">
        {
          journal.map((e, i) => (
            <li style={`--i:${i}`} class="journal-ligne grid grid-cols-[4rem_minmax(0,1fr)] gap-x-3 gap-y-1.5 px-5 py-3.5 sm:grid-cols-[4.5rem_minmax(0,1fr)_auto] sm:items-center sm:px-6">
              <span class="chiffres text-[0.8rem] leading-tight text-encre-douce">
                {e.jour}
                <br />
                {e.heure}
              </span>
              <span class="text-[0.95rem] leading-snug" data-frappe>{e.action}</span>
              <span class:list={['cachet col-start-2 sm:col-start-3', couleursStatut[e.statut]]}>
                {e.statut === 'valide' && (
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M1.5 5.2l2.2 2.2L8.5 2.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                )}
                {e.statut === 'refuse' && (
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M2 2l6 6M8 2L2 8" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                )}
                {libellesStatut[e.statut]}
              </span>
            </li>
          ))
        }
      </ol>
    </figure>
  </div>
</section>

<style is:global>
  /* Journal : chaque ligne apparaît, l’action est tapée à la machine, puis le cachet tombe. Sans JavaScript, tout est visible. */
  .journal.journal-pret .journal-ligne { opacity: 0; }
  .journal.journal-pret .journal-ligne.en-cours,
  .journal.journal-pret .journal-ligne.est-ecrite { opacity: 1; transition: opacity 0.2s ease; }
  .journal.journal-pret .journal-ligne .cachet { opacity: 0; transform: scale(1.6) rotate(-6deg); }
  .journal.journal-pret .journal-ligne.est-ecrite .cachet {
    opacity: 1; transform: none;
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3);
  }
  .caret-machine {
    display: inline-block; width: 0.5ch; height: 1em; margin-left: 1px; vertical-align: -0.12em;
    background: var(--color-bordeaux); animation: caret 0.8s steps(1) infinite;
  }
  @keyframes caret { 50% { opacity: 0; } }
  .journal-ligne { position: relative; }
  .journal-ligne:hover { background: rgb(233 221 191 / 0.28); }
  .principe { transition: border-color 0.3s ease; }
  .principe:hover { border-color: var(--color-bordeaux); }
</style>

<script>
  const journal = document.querySelector<HTMLElement>('[data-journal]');
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (journal && !reduit && 'IntersectionObserver' in window) {
    const lignes = Array.from(journal.querySelectorAll<HTMLElement>('.journal-ligne'));
    const cibles = lignes.map((l) => l.querySelector<HTMLElement>('[data-frappe]')!);
    const textes = cibles.map((c) => c.textContent ?? '');
    // Version lisible pour les lecteurs d’écran, texte tapé masqué pour eux.
    cibles.forEach((c, i) => {
      c.style.display = 'block';
      c.style.minHeight = c.offsetHeight + 'px';
      c.innerHTML = '';
      const vrai = document.createElement('span');
      vrai.className = 'sr-only';
      vrai.textContent = textes[i];
      const tape = document.createElement('span');
      tape.setAttribute('aria-hidden', 'true');
      c.append(vrai, tape);
    });
    journal.classList.add('journal-pret');
    const taper = async () => {
      for (let i = 0; i < lignes.length; i++) {
        lignes[i].classList.add('en-cours');
        const tape = cibles[i].lastElementChild as HTMLElement;
        const caret = document.createElement('span');
        caret.className = 'caret-machine';
        caret.setAttribute('aria-hidden', 'true');
        tape.after(caret);
        await new Promise<void>((fin) => {
          let k = 0;
          const pas = () => {
            k++;
            tape.textContent = textes[i].slice(0, k);
            if (k >= textes[i].length) { caret.remove(); lignes[i].classList.add('est-ecrite'); fin(); }
            else setTimeout(pas, 16 + Math.random() * 18);
          };
          pas();
        });
        await new Promise((r) => setTimeout(r, 140));
      }
    };
    const obs = new IntersectionObserver(
      (entrees) => {
        if (entrees.some((e) => e.isIntersecting)) {
          obs.disconnect();
          taper();
        }
      },
      { threshold: 0.3 },
    );
    obs.observe(journal);
  }
</script>
