---
interface Props {
  numero: string;
  libelle: string;
  id: string;
  titre: string;
  sombre?: boolean;
  class?: string;
}
const { numero, libelle, id, titre, sombre = false, class: classe = '' } = Astro.props;
---
<div class:list={['max-w-3xl', classe]}>
  <p class:list={['surtitre flex items-center gap-3', sombre ? 'text-dore-clair' : 'text-bordeaux']}>
    <span>N° {numero}</span>
    <span class:list={['h-px w-8', sombre ? 'bg-dore-clair' : 'bg-dore']} aria-hidden="true"></span>
    <span>{libelle}</span>
  </p>
  <h2 id={id} class="mt-4 text-[2rem] leading-[1.1] font-medium tracking-[-0.015em] sm:text-[2.6rem] lg:text-5xl">
    <Fragment set:html={titre} />
  </h2>
  <slot />
</div>
