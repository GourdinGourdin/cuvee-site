---
/**
 * « En un coup d’œil » : une facture entre, la cave se met à jour, un bon de commande est préparé.
 * Trois objets de papier au trait fin (filet doré, encre, un seul accent bordeaux), reliés par un fil doré.
 * Données inventées, illustrations décoratives (le sens est porté par les légendes en texte).
 */
import TitreSection from './TitreSection.astro';

const etapes = [
  { objet: 'facture', libelle: 'Facture', titre: 'Lue en photo ou en PDF', texte: 'Les lignes douteuses vous sont soumises.' },
  { objet: 'cave', libelle: 'Cave', titre: 'Suivie au jour le jour', texte: 'Les bouteilles qui dorment sont repérées.' },
  { objet: 'bon', libelle: 'Bon de commande', titre: 'Préparé pour vous', texte: 'Vous relisez, vous validez, il part.' },
];
const bouteilles = [0, 1, 2].flatMap((r) => [0, 1, 2, 3].map((c) => ({ x: 14 + c * 44, y: 12 + r * 38, dort: r === 1 && c === 2 })));
---
<section aria-labelledby="coup-doeil-titre" class="section-serree bg-creme border-t border-filet">
  <div class="conteneur">
    <TitreSection libelle="En un coup d’œil" id="coup-doeil-titre" titre="Une facture entre, un bon de commande sort." />

    <ol role="list" class="scene mt-12 lg:mt-16">
      {
        etapes.map((e, i) => (
          <>
            {i > 0 && (
              <li class="scene-lien" aria-hidden="true" data-reveal data-reveal-delai={String(i * 2)}>
                <svg viewBox="0 0 48 12" preserveAspectRatio="none">
                  <path d="M0 6h46M41 1.5L46 6l-5 4.5" />
                </svg>
              </li>
            )}
            <li class="scene-etape" data-reveal data-reveal-delai={String(i * 2 + 1)}>
              <figure class="objet papier" aria-hidden="true">
                <figcaption class="surtitre">{e.libelle}</figcaption>
                <svg viewBox="0 0 188 124" class="objet-dessin">
                  {e.objet === 'facture' && (
                    <>
                      {[0, 1, 2, 3].map((r) => (
                        <g transform={`translate(0 ${6 + r * 28})`}>
                          {r < 3 ? <path d="M4 8l4 4 8-9" class="trait-encre" /> : <circle cx="10" cy="8" r="7" class="trait-accent" />}
                          <path d={`M28 8h${r === 1 ? 84 : 96}M156 8h24`} class="trait-fin" />
                        </g>
                      ))}
                    </>
                  )}
                  {e.objet === 'cave' &&
                    bouteilles.map((b) => (
                      <path
                        transform={`translate(${b.x} ${b.y})`}
                        d="M10 2h4v9c0 4 4 5 4 11v13h-12v-13c0-6 4-7 4-11z"
                        class={b.dort ? 'trait-accent bouteille-dort' : 'trait-encre'}
                      />
                    ))}
                  {e.objet === 'bon' && (
                    <>
                      {[0, 1, 2].map((r) => (
                        <path d={`M4 ${14 + r * 24}h${r === 0 ? 100 : 180}`} class="trait-fin" />
                      ))}
                      <path d="M4 92h110M150 92h34" class="trait-fin" />
                    </>
                  )}
                </svg>
                {e.objet === 'bon' && <span class="cachet objet-cachet">À valider</span>}
              </figure>
              <h3 class="mt-6">{e.titre}</h3>
              <p class="texte-courant mt-2">{e.texte}</p>
            </li>
          </>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .scene {
    display: grid;
    gap: var(--space-4);
  }
  .scene-etape {
    max-width: 22rem;
  }
  .objet {
    position: relative;
    margin: 0;
    padding: var(--space-4);
    box-shadow: var(--ombre-1);
    border-color: color-mix(in srgb, var(--color-dore) 55%, var(--color-filet));
  }
  .objet-dessin {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-3);
    fill: none;
    overflow: visible;
  }
  /* mêmes épaisseurs partout : 1.25 px à l’écran, quelle que soit la taille du dessin */
  .objet-dessin path,
  .objet-dessin circle,
  .scene-lien path {
    vector-effect: non-scaling-stroke;
    stroke-width: 1.25px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trait-fin { stroke: var(--color-bordure); opacity: 0.5; }
  .trait-encre { stroke: var(--color-encre-douce); }
  .trait-accent { stroke: var(--color-bordeaux); }
  .bouteille-dort { fill: var(--color-bordeaux); }
  .objet-cachet {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    color: var(--color-bordeaux);
    background: var(--color-papier);
  }
  /* le fil doré entre deux objets : vertical sur mobile, horizontal dès 1024 px */
  .scene-lien {
    height: var(--space-6);
    width: 1px;
    margin-left: var(--space-5);
    background: var(--color-dore);
  }
  .scene-lien svg { display: none; }
  @media (min-width: 64rem) {
    .scene {
      grid-template-columns: minmax(0, 1fr) var(--space-7) minmax(0, 1fr) var(--space-7) minmax(0, 1fr);
      gap: 0;
      align-items: start;
    }
    .scene-etape { max-width: none; }
    .scene-lien {
      width: auto;
      height: 12.5rem; /* hauteur approximative de l’objet : le trait tombe à son milieu */
      margin: 0;
      background: none;
      display: grid;
      place-items: center;
      padding-inline: var(--space-2);
    }
    .scene-lien svg { display: block; width: 100%; height: 0.75rem; overflow: visible; }
    .scene-lien path { fill: none; stroke: var(--color-dore); }
  }
</style>
