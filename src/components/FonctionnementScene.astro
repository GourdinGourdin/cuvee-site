---
/** Scène « en un coup d’œil » : une facture entre, la cave se met à jour, un bon de commande est préparé. Se dessine à l’entrée dans l’écran. */
import FonctionnementTitre from './FonctionnementTitre.astro';
---
<section aria-labelledby="coup-doeil-titre" class="fct-coup bg-papier py-24 lg:py-32">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-8">
    <FonctionnementTitre
      libelle="En un coup d’œil"
      id="coup-doeil-titre"
      titre="Une facture entre, un bon de commande sort."
      signature="et vous au milieu"
    />

    <div class="fct-scene mx-auto mt-14 max-w-4xl lg:mt-20" data-scene data-reveal data-reveal-delai="2">
      <svg
        class="fct-frise"
        viewBox="0 0 600 190"
        role="img"
        aria-label="Schéma : une facture entre, la cave se met à jour, un bon de commande est préparé ; un fil doré relie les trois."
      >
        <path class="fct-fil-or" d="M96 96 C 170 30, 230 30, 300 92 S 430 150, 504 88" pathLength="1" />
        <g class="fct-obj" style="--k:0">
          <g transform="translate(40 24) rotate(-4 50 55)">
            <rect width="100" height="120" rx="1.5" class="fct-papier" />
            <path d="M14 22h46M14 40h72M14 54h72M14 68h72M14 82h40" class="fct-trait" />
            <path d="M72 100l6 6 12-14" class="fct-ok" />
          </g>
        </g>
        <g class="fct-obj" style="--k:1">
          <g transform="translate(250 22)">
            <rect width="100" height="124" rx="1.5" class="fct-papier" />
            <path d="M8 44h84M8 84h84M8 122h84" class="fct-trait" />
            {
              [0, 1, 2].flatMap((r) =>
                [0, 1, 2, 3].map((c) => (
                  <g transform={`translate(${16 + c * 20} ${r * 40 + 8})`} class:list={['fct-btl', r === 1 && c === 2 && 'fct-dort']}>
                    <rect x="3" y="12" width="9" height="20" rx="2.5" />
                    <rect x="6" y="3" width="3" height="10" />
                  </g>
                ))
              )
            }
          </g>
        </g>
        <g class="fct-obj" style="--k:2">
          <g transform="translate(460 20) rotate(3 50 55)">
            <rect width="100" height="124" rx="1.5" class="fct-papier" />
            <path d="M14 22h50M14 42h72M14 56h72M14 70h72" class="fct-trait" />
            <g transform="translate(58 82) rotate(-10)">
              <rect x="0" y="0" width="34" height="20" rx="1.5" class="fct-tampon" />
              <path d="M9 10.5l5 5 11-11" class="fct-tampon-ok" />
            </g>
          </g>
        </g>
        <g class="fct-lib">
          <text x="90" y="178" text-anchor="middle">Facture</text>
          <text x="300" y="178" text-anchor="middle">Cave</text>
          <text x="510" y="178" text-anchor="middle">Bon de commande</text>
        </g>
      </svg>

      <ul role="list" class="fct-legendes mt-10 grid gap-8 text-center sm:grid-cols-3">
        <li>
          <p class="surtitre text-bordeaux">Lue en photo ou en PDF</p>
          <p class="mt-2 text-[0.98rem] text-encre-douce">Les lignes douteuses vous sont soumises.</p>
        </li>
        <li>
          <p class="surtitre text-bordeaux">Suivie au jour le jour</p>
          <p class="mt-2 text-[0.98rem] text-encre-douce">Les bouteilles qui dorment sont repérées.</p>
        </li>
        <li>
          <p class="surtitre text-bordeaux">Préparée pour vous</p>
          <p class="mt-2 text-[0.98rem] text-encre-douce">Vous relisez, vous validez, elle part.</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<style is:global>
  .fct-frise {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .fct-papier { fill: var(--color-creme); stroke: var(--color-dore); stroke-width: 1; }
  .fct-trait { fill: none; stroke: var(--color-bordure); stroke-width: 2; stroke-linecap: round; opacity: 0.55; }
  .fct-ok { fill: none; stroke: var(--color-vert); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .fct-btl rect { fill: var(--color-bordeaux); opacity: 0.8; }
  .fct-btl.fct-dort rect { fill: var(--color-dore); opacity: 1; }
  .fct-tampon { fill: var(--color-vert-clair); stroke: var(--color-vert); stroke-width: 1.5; }
  .fct-tampon-ok { fill: none; stroke: var(--color-vert); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .fct-lib text {
    font-family: var(--font-texte);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    fill: var(--color-encre-douce);
  }
  .fct-fil-or {
    fill: none;
    stroke: var(--color-dore);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  /* animation : seulement si html.anim ; le conteneur reçoit .est-visible à l'entrée dans l'écran */
  @media (prefers-reduced-motion: no-preference) {
    html.anim .fct-scene .fct-obj { opacity: 0; transform: translateY(14px); }
    html.anim .fct-scene .fct-fil-or { stroke-dashoffset: 1; }
    html.anim .fct-scene.est-visible .fct-obj {
      opacity: 1;
      transform: none;
      transition: opacity 0.9s ease calc(0.3s + var(--k) * 0.45s), transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.3s + var(--k) * 0.45s);
    }
    html.anim .fct-scene.est-visible .fct-fil-or {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 2.2s cubic-bezier(0.5, 0, 0.2, 1) 0.7s;
    }
    html.anim .fct-scene.est-visible .fct-btl.fct-dort {
      transform-box: fill-box;
      transform-origin: center;
      animation: fct-dort 3.2s ease-in-out 2.6s infinite;
    }
  }
  @keyframes fct-dort { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
</style>
