---
import TitreSection from './TitreSection.astro';
import { avecPlaceholders } from '../lib/texte';

// TODO : étapes et durées à valider par l’équipe ; seules les étapes déjà décrites sur le site sont rédigées.
const etapes = [
  { titre: 'Votre inscription', texte: 'Vous remplissez le bon ci-dessous, en deux minutes.', quand: '' },
  { titre: 'Un premier échange', texte: 'Nous faisons connaissance et vérifions que Cuvée peut vous être utile. Sinon, nous vous le disons avant de commencer.', quand: '[À COMPLÉTER : délai après l’inscription]' },
  { titre: 'La mise en place', texte: 'Nous connectons votre caisse, lisons quelques factures fournisseurs récentes et montons l’inventaire de départ, que vous relisez.', quand: '[À COMPLÉTER : durée de mise en place]' },
  { titre: 'Le pilote en service', texte: 'Vous utilisez Cuvée pendant le service. Rien d’engageant ne part sans votre validation.', quand: '[À COMPLÉTER : durée du pilote]' },
  { titre: 'Le bilan', texte: '[À COMPLÉTER : format du bilan et suite proposée aux lieux pilotes]', quand: '' },
];
---
<section aria-labelledby="frise-titre" class="section bg-creme">
  <div class="conteneur frise-grille">
    <div class="frise-tete">
      <TitreSection libelle="Le déroulé" id="frise-titre" titre="Du premier mot au bilan" />
    </div>

    <ol role="list" class="frise" data-frise>
      <li class="frise-rail" aria-hidden="true" role="presentation"><span class="frise-trace"></span></li>
      {
        etapes.map((e, i) => (
          <li class="frise-etape" data-etape={i} data-reveal data-reveal-delai={String(Math.min(i + 1, 4))}>
            <span class="frise-point" aria-hidden="true"></span>
            <span class="frise-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3><span class="sr-only">Étape {i + 1} : </span>{e.titre}</h3>
            <p class="texte-courant" set:html={avecPlaceholders(e.texte)} />
            {e.quand && <p class="frise-quand" set:html={avecPlaceholders(e.quand)} />}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .frise-grille { display: grid; gap: var(--space-7); }
  @media (min-width: 64rem) {
    .frise-grille { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-8); align-items: start; }
    .frise-tete { position: sticky; top: var(--space-9); }
  }

  .frise { --p: 1; --dernier: 4rem; position: relative; list-style: none; margin: 0; padding: 0; }
  html.anim .frise { --p: 0; }

  /* rail : un filet pâle, et le trait doré qui se dessine au défilement ; de centre de point en centre de point */
  .frise-rail {
    position: absolute;
    list-style: none;
    pointer-events: none;
    background: var(--color-filet);
    left: 0.4375rem;
    top: 0.5625rem;
    bottom: calc(var(--dernier) - 0.5625rem);
    width: 2px;
    translate: -1px 0;
  }
  .frise-trace {
    position: absolute;
    inset: 0;
    background: var(--color-dore);
    transform-origin: top;
    transform: scaleY(var(--p));
  }

  .frise-etape { position: relative; padding: 0 0 var(--space-7) 2.5rem; }
  .frise-etape:last-child { padding-bottom: 0; }
  .frise-num {
    display: block;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.125rem;
    color: var(--color-bordeaux);
  }
  .frise-point {
    position: absolute;
    left: 0;
    top: 0.125rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    border: 2px solid var(--color-dore);
    background: var(--color-creme);
    transition: background-color var(--duree-3) ease, border-color var(--duree-3) ease;
  }
  .frise-etape.atteint .frise-point { background: var(--color-bordeaux); border-color: var(--color-bordeaux); }
  .frise-etape h3 { margin-top: var(--space-2); color: var(--color-encre); }
  .frise-etape .texte-courant { margin-top: var(--space-2); }
  .frise-quand { margin-top: var(--space-3); font-size: 0.9375rem; line-height: 1.7; }
  .frise-etape mark { box-decoration-break: clone; -webkit-box-decoration-break: clone; }

  @media (min-width: 40rem) {
    .frise-etape { padding-left: var(--space-7); }
  }
</style>

<script>
  const frise = document.querySelector<HTMLElement>('[data-frise]');
  if (frise) {
    const etapes = Array.from(frise.querySelectorAll<HTMLElement>('[data-etape]'));
    const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const dernier = etapes[etapes.length - 1];
    const mesurer = () => frise.style.setProperty('--dernier', dernier.offsetHeight + 'px');
    mesurer();
    addEventListener('resize', mesurer);
    addEventListener('load', mesurer);
    document.fonts?.ready.then(mesurer);

    const appliquer = (p: number) => {
      frise.style.setProperty('--p', p.toFixed(4));
      etapes.forEach((e, i) => e.classList.toggle('atteint', p >= i / (etapes.length - 1) - 0.001));
    };

    if (reduit || !document.documentElement.classList.contains('anim')) {
      appliquer(1);
    } else {
      let attente = false;
      const maj = () => {
        attente = false;
        const r = frise.getBoundingClientRect();
        const vh = window.innerHeight;
        const debut = vh * 0.66;
        appliquer(Math.min(1, Math.max(0, (debut - r.top) / (r.height * 0.9))));
      };
      const demander = () => {
        if (!attente) { attente = true; requestAnimationFrame(maj); }
      };
      addEventListener('scroll', demander, { passive: true });
      addEventListener('resize', demander);
      maj();
    }
  }
</script>
