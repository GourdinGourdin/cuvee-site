---
import { avecPlaceholders } from '../lib/texte';

// TODO : étapes et durées à valider par l’équipe ; seules les étapes déjà décrites sur le site sont rédigées.
const etapes = [
  { num: 'I', titre: 'Votre inscription', texte: 'Vous remplissez le bon ci-dessous, en deux minutes.', quand: '' },
  { num: 'II', titre: 'Un premier échange', texte: 'Nous faisons connaissance et vérifions que Cuvée peut vous être utile. Sinon, nous vous le disons avant de commencer.', quand: '[À COMPLÉTER : délai après l’inscription]' },
  { num: 'III', titre: 'La mise en place', texte: 'Nous connectons votre caisse, lisons quelques factures fournisseurs récentes et montons l’inventaire de départ, que vous relisez.', quand: '[À COMPLÉTER : durée de mise en place]' },
  { num: 'IV', titre: 'Le pilote en service', texte: 'Vous utilisez Cuvée pendant le service. Rien d’engageant ne part sans votre validation.', quand: '[À COMPLÉTER : durée du pilote]' },
  { num: 'V', titre: 'Le bilan', texte: '[À COMPLÉTER : format du bilan et suite proposée aux lieux pilotes]', quand: '' },
];
---
<section aria-labelledby="frise-titre" class="bg-papier py-24 lg:py-32">
  <div class="mx-auto max-w-[76rem] px-6 sm:px-10">
    <div class="text-center">
      <p class="surtitre text-bordeaux" data-reveal>Le déroulé</p>
      <h2 id="frise-titre" class="mx-auto mt-5 max-w-3xl text-[clamp(1.8rem,3.6vw,3rem)]" data-reveal data-reveal-delai="1">
        Du premier mot au bilan
      </h2>
      <span class="signature mt-3" data-reveal data-reveal-delai="2">pas à pas</span>
    </div>

    <ol role="list" class="frise relative mt-16 lg:mt-24 lg:grid lg:grid-cols-5 lg:gap-4" data-frise>
      <li class="frise-rail" aria-hidden="true" role="presentation"><span class="frise-trace"></span></li>
      {
        etapes.map((e, i) => (
          <li class="frise-etape" data-etape={i} data-reveal data-reveal-delai={String(Math.min(i + 1, 6))}>
            <span class="frise-num" aria-hidden="true">{e.num}</span>
            <span class="frise-point" aria-hidden="true"></span>
            <div class="frise-texte">
              <h3 class="text-[1.15rem]"><span class="sr-only">Étape {i + 1} : </span>{e.titre}</h3>
              <p class="mt-3 text-[1rem] leading-relaxed text-encre-douce" set:html={avecPlaceholders(e.texte)} />
              {e.quand && <p class="mt-3 text-[0.95rem]" set:html={avecPlaceholders(e.quand)} />}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .frise { --p: 1; --rail-haut: 4.2rem; }
  html.anim .frise { --p: 0; }

  /* rail : un filet pâle, et le trait doré qui se dessine au défilement */
  .frise-rail {
    position: absolute;
    list-style: none;
    pointer-events: none;
    background: var(--color-filet);
    left: 0.7rem;
    top: 0.9rem;
    bottom: calc(var(--dernier, 4rem) - 1.65rem);
    width: 2px;
  }
  .frise-trace {
    position: absolute;
    inset: 0;
    background: var(--color-dore);
    transform-origin: top;
    transform: scaleY(var(--p));
  }
  .frise-etape { position: relative; padding: 0 0 2.75rem 3.25rem; }
  .frise-etape:last-child { padding-bottom: 0; }
  .frise-num {
    display: block;
    font-family: var(--font-titre);
    font-weight: 300;
    font-size: 1.1rem;
    letter-spacing: 0.18em;
    color: var(--color-bordeaux);
    margin-bottom: 0.4rem;
  }
  .frise-point {
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 999px;
    border: 2px solid var(--color-dore);
    background: var(--color-papier);
    transition: background-color 0.5s ease, border-color 0.5s ease, scale 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .frise-etape.atteint .frise-point { background: var(--color-bordeaux); border-color: var(--color-bordeaux); scale: 1.12; }
  .frise-etape h3 { color: var(--color-encre); }

  @media (min-width: 64rem) {
    .frise-rail { left: 10%; right: 10%; top: calc(var(--rail-haut) + 0.72rem - 1px); bottom: auto; width: auto; height: 2px; }
    .frise-trace { transform-origin: left; transform: scaleX(var(--p)); }
    .frise-etape { padding: 0 0.5rem; text-align: center; }
    .frise-etape:last-child { padding-bottom: 0; }
    .frise-num { font-size: 2.4rem; line-height: 1; height: 2.7rem; margin-bottom: 0; letter-spacing: 0.12em; padding-left: 0.12em; }
    .frise-point { position: relative; display: block; left: auto; top: auto; margin: 1.5rem auto 0; width: 1.45rem; height: 1.45rem; }
    .frise-texte { margin-top: 2rem; }
  }
</style>

<script>
  const frise = document.querySelector<HTMLElement>('[data-frise]');
  if (frise) {
    const etapes = Array.from(frise.querySelectorAll<HTMLElement>('[data-etape]'));
    const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const dernier = etapes[etapes.length - 1];
    const mesurer = () => frise.style.setProperty('--dernier', dernier.offsetHeight + 'px');
    mesurer();
    addEventListener('resize', mesurer);
    addEventListener('load', mesurer);
    document.fonts?.ready.then(mesurer);

    const appliquer = (p: number) => {
      frise.style.setProperty('--p', p.toFixed(4));
      etapes.forEach((e, i) => e.classList.toggle('atteint', p >= i / (etapes.length - 1) - 0.001));
    };

    if (reduit || !document.documentElement.classList.contains('anim')) {
      appliquer(1);
    } else {
      let attente = false;
      const maj = () => {
        attente = false;
        const r = frise.getBoundingClientRect();
        const vh = window.innerHeight;
        const horizontal = matchMedia('(min-width: 64rem)').matches;
        const debut = vh * (horizontal ? 0.78 : 0.62);
        const longueur = horizontal ? r.height + vh * 0.1 : r.height * 0.95;
        appliquer(Math.min(1, Math.max(0, (debut - r.top) / longueur)));
      };
      const demander = () => {
        if (!attente) { attente = true; requestAnimationFrame(maj); }
      };
      addEventListener('scroll', demander, { passive: true });
      addEventListener('resize', demander);
      maj();
    }
  }
</script>
