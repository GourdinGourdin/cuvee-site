---
import TitreSection from './TitreSection.astro';
---
<section id="calcul" aria-labelledby="calcul-titre" class="sur-fond-sombre overflow-x-clip bg-vert py-20 text-creme lg:py-28">
  <div
    class="conteneur grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:grid-rows-[auto_1fr] lg:gap-x-16 lg:gap-y-10"
  >
    <div data-reveal="gauche">
      <TitreSection numero="2" libelle="Faites le calcul" id="calcul-titre" titre="Combien dort dans votre cave ?" sombre />
      <p class="mt-6 max-w-lg text-lg text-creme-sourde" data-reveal data-reveal-delai="2">Trois chiffres, de tête. Rien n’est enregistré ni envoyé.</p>
    </div>

    <form
      data-reveal="droite"
      class="papier papier-ombre p-5 text-encre sm:p-8 lg:col-start-2 lg:row-span-2 lg:row-start-1"
      aria-label="Calculateur : argent qui dort en cave"
      data-calculateur
      novalidate
    >
      <div class="flex items-center justify-between gap-3">
        <p class="surtitre text-encre-douce">Fiche de calcul</p>
        <p class="cachet text-bordeaux" data-calc-exemple>Valeurs d’exemple</p>
      </div>

      <div class="mt-5 grid gap-6">
        <div>
          <label for="calc-stock" class="etiquette-champ">Valeur de votre stock de vin, en euros</label>
          <span id="calc-stock-aide" class="aide-champ -mt-1 mb-2">Au prix d’achat, hors taxes</span>
          <div class="relative">
            <input
              id="calc-stock"
              name="stock"
              type="text"
              inputmode="numeric"
              enterkeyhint="done"
              autocomplete="off"
              spellcheck="false"
              class="champ chiffres pr-10 text-lg"
              value="30 000"
              aria-describedby="calc-stock-aide"
              data-calc-stock
            />
            <span class="chiffres pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-encre-douce" aria-hidden="true">€</span>
          </div>
        </div>

        <div>
          <label for="calc-dormant" class="etiquette-champ">Part du stock qui n’a pas bougé depuis 3 mois</label>
          <span id="calc-dormant-aide" class="aide-champ -mt-1 mb-2">Une estimation à la louche suffit</span>
          <div class="flex items-center gap-4">
            <input
              id="calc-dormant"
              name="dormant"
              type="range"
              min="0"
              max="80"
              step="1"
              value="15"
              class="h-11 w-full cursor-pointer accent-bordeaux"
              aria-describedby="calc-dormant-aide"
              data-calc-dormant
            />
            <output for="calc-dormant" class="chiffres w-14 shrink-0 text-right text-lg font-medium" aria-hidden="true" data-calc-dormant-valeur>15 %</output>
          </div>
        </div>

        <div>
          <label for="calc-heures" class="etiquette-champ">Heures par semaine sur les commandes et l’inventaire</label>
          <span id="calc-heures-aide" class="aide-champ -mt-1 mb-2">Commandes, relances, comptage, saisie des factures</span>
          <div class="relative max-w-[12rem]">
            <input
              id="calc-heures"
              name="heures"
              type="text"
              inputmode="decimal"
              enterkeyhint="done"
              autocomplete="off"
              spellcheck="false"
              class="champ chiffres pr-10 text-lg"
              value="4"
              aria-describedby="calc-heures-aide"
              data-calc-heures
            />
            <span class="chiffres pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-encre-douce" aria-hidden="true">h</span>
          </div>
        </div>
      </div>

      <div class="mt-8 border-t-2 border-encre pt-6">
        <!-- jauge : part du stock qui dort -->
        <div class="mb-6" aria-hidden="true">
          <div class="h-2 w-full bg-creme-fonce">
            <div class="jauge h-full bg-bordeaux" data-calc-jauge style="width:15%"></div>
          </div>
          <p class="surtitre mt-2 flex justify-between text-encre-douce"><span>Part qui dort</span><span>Reste du stock</span></p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2" aria-hidden="true">
          <div>
            <p class="surtitre text-encre-douce">Argent qui dort en cave</p>
            <p class="mt-2 font-serif text-[clamp(2rem,9vw,2.6rem)] leading-none font-medium break-words text-bordeaux" data-calc-tresorerie>
              4 500 €
            </p>
            <p class="mt-2 text-[0.92rem] leading-snug text-encre-douce">dans des bouteilles qui ne sortent pas.</p>
          </div>
          <div>
            <p class="surtitre text-encre-douce">Temps sur une année</p>
            <p class="mt-2 font-serif text-[clamp(2rem,9vw,2.6rem)] leading-none font-medium text-bordeaux" data-calc-heures-an>
              192 h
            </p>
            <p class="mt-2 text-[0.92rem] leading-snug text-encre-douce" data-calc-journees>
              soit environ 24 journées de 8 heures.
            </p>
          </div>
        </div>
        <!-- Résumé unique pour les lecteurs d’écran, annoncé quand la saisie s’arrête. -->
        <p class="sr-only" role="status" aria-atomic="true" data-calc-resume></p>
      </div>

      <p class="mt-6 text-[0.875rem] leading-snug text-encre-douce">
        Notre hypothèse : 48 semaines d’ouverture par an. Les valeurs de départ sont des exemples, pas des moyennes :
        mettez les vôtres.
      </p>
      <noscript>
        <p class="mt-3 text-[0.875rem] text-encre-douce">
          Le calcul a besoin de JavaScript. Les chiffres ci-dessus correspondent aux valeurs d’exemple.
        </p>
      </noscript>
    </form>

    <div data-reveal data-reveal-delai="2" class="max-w-lg lg:col-start-1 lg:row-start-2 lg:self-start lg:border-t lg:border-creme/25 lg:pt-6">
      <p class="text-creme-sourde">
        <span class="font-semibold text-creme">Ce que nous visons avec Cuvée :</span> remettre une partie de cette somme en
        circulation et vous rendre une partie de ces heures. Combien exactement ? Nous ne le savons pas encore. C’est
        précisément ce que le pilote doit mesurer, lieu par lieu.
      </p>
      <a href="/pilote#inscription" class="lien lien-seul mt-3 text-creme">Le mesurer avec nous</a>
    </div>
  </div>
</section>

<script>
  const formulaire = document.querySelector<HTMLFormElement>('[data-calculateur]');

  if (formulaire) {
    const stock = formulaire.querySelector<HTMLInputElement>('[data-calc-stock]')!;
    const dormant = formulaire.querySelector<HTMLInputElement>('[data-calc-dormant]')!;
    const dormantValeur = formulaire.querySelector<HTMLOutputElement>('[data-calc-dormant-valeur]')!;
    const heures = formulaire.querySelector<HTMLInputElement>('[data-calc-heures]')!;
    const tresorerie = formulaire.querySelector<HTMLElement>('[data-calc-tresorerie]')!;
    const heuresAn = formulaire.querySelector<HTMLElement>('[data-calc-heures-an]')!;
    const journees = formulaire.querySelector<HTMLElement>('[data-calc-journees]')!;
    const resume = formulaire.querySelector<HTMLElement>('[data-calc-resume]')!;
    const jauge = formulaire.querySelector<HTMLElement>('[data-calc-jauge]')!;
    const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let touche = false;
    const badgeExemple = formulaire.querySelector<HTMLElement>('[data-calc-exemple]')!;

    const SEMAINES_OUVERTES = 48;
    const MAX_STOCK = 10_000_000;
    const MAX_HEURES = 168;
    const euros = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const nombre = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 });

    /**
     * Lit un nombre tapé à la française : « 30 000 », « 25.000 € », « 1 234,5 », « 4h30 ».
     * Négatif, vide ou illisible : 0. Plafonné à `max`.
     */
    const lireNombre = (saisie: string, max: number) => {
      let s = saisie.trim().replace(/[\s  €]/g, '').toLowerCase();
      if (/^[-−–]/.test(s)) return 0;
      const heuresMinutes = s.match(/^(\d+)h(\d{1,2})?$/);
      if (heuresMinutes) return Math.min(Number(heuresMinutes[1]) + Number(heuresMinutes[2] ?? 0) / 60, max);
      s = s.replace(/[^\d.,]/g, '');
      if (/^\d{1,3}(\.\d{3})+(,\d+)?$/.test(s)) s = s.replace(/\./g, '').replace(',', '.'); // 25.000 ; 1.234,5
      else if (/^\d{1,3}(,\d{3})+(\.\d+)?$/.test(s)) s = s.replace(/,/g, ''); // 1,234.56
      else s = s.replace(',', '.');
      const n = Number(s);
      return Number.isFinite(n) && n > 0 ? Math.min(n, max) : 0;
    };

    let minuterie: number | undefined;

    const calculer = (annoncer = true) => {
      const pourcentage = Number(dormant.value);
      dormantValeur.textContent = `${pourcentage} %`;

      const valeurStock = lireNombre(stock.value, MAX_STOCK);
      const immobilise = Math.round((valeurStock * pourcentage) / 100 / 10) * 10;
      jauge.style.width = `${pourcentage}%`;
      tresorerie.textContent = valeurStock ? euros.format(immobilise) : '—';

      const total = Math.round(lireNombre(heures.value, MAX_HEURES) * SEMAINES_OUVERTES);
      heuresAn.textContent = total ? `${nombre.format(total)} h` : '—';
      const jours = Math.round(total / 8);
      journees.textContent = jours
        ? `soit environ ${nombre.format(jours)} journée${jours > 1 ? 's' : ''} de 8 heures.`
        : total
          ? "soit moins d’une journée."
          : 'Indiquez vos heures par semaine.';

      if (annoncer && !reduit) {
        [tresorerie, heuresAn].forEach((el) => {
          el.classList.remove('pop');
          void el.offsetWidth;
          el.classList.add('pop');
        });
      }
      if (!annoncer) return;
      window.clearTimeout(minuterie);
      minuterie = window.setTimeout(() => {
        resume.textContent =
          `Argent qui dort en cave : ${valeurStock ? euros.format(immobilise) : 'non calculé'}. ` +
          `Temps sur une année : ${total ? `${nombre.format(total)} heures` : 'non calculé'}.`;
      }, 700);
    };

    // Remet en forme la valeur du stock (30000 → 30 000) quand on quitte le champ.
    stock.addEventListener('blur', () => {
      const n = lireNombre(stock.value, MAX_STOCK);
      stock.value = n ? new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(n) : '';
    });

    formulaire.addEventListener('input', () => {
      touche = true;
      badgeExemple.hidden = true;
      calculer();
    });
    formulaire.addEventListener('submit', (e) => e.preventDefault());
    calculer(false);

    // À la première apparition, les chiffres d’exemple se comptent à l’écran (sauf saisie entre-temps).
    if (!reduit && 'IntersectionObserver' in window) {
      const finT = tresorerie.textContent ?? '';
      const finH = heuresAn.textContent ?? '';
      const nT = lireNombre(stock.value, MAX_STOCK) * 0.15;
      const nH = lireNombre(heures.value, MAX_HEURES) * SEMAINES_OUVERTES;
      const obs = new IntersectionObserver((entrees) => {
        if (!entrees.some((e) => e.isIntersecting)) return;
        obs.disconnect();
        const debut = performance.now();
        const pas = (t: number) => {
          if (touche) return;
          const k = Math.min((t - debut) / 1100, 1);
          const e = 1 - Math.pow(1 - k, 3);
          if (k >= 1) {
            tresorerie.textContent = finT;
            heuresAn.textContent = finH;
            return;
          }
          tresorerie.textContent = euros.format(Math.round((nT * e) / 10) * 10);
          heuresAn.textContent = `${nombre.format(Math.round(nH * e))} h`;
          requestAnimationFrame(pas);
        };
        requestAnimationFrame(pas);
      }, { threshold: 0.5 });
      obs.observe(formulaire);
    }
  }
</script>

<style>
  .jauge {
    transition: width 0.5s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .pop {
    animation: pop 0.45s ease-out;
  }
  @keyframes pop {
    from {
      opacity: 0.35;
      transform: translateY(6px);
    }
  }
</style>
