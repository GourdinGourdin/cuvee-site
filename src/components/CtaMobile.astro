---
/**
 * Bouton fixe en bas d’écran, sur mobile et tablette. Il apparaît une fois le premier écran passé
 * (et le bouton du hero hors champ s’il existe), s’efface quand le pied de page ou un bloc
 * d’appel `[data-page-cta]` est à l’écran. Absent de /pilote, qui est déjà l’inscription.
 */
import { lienInscription } from '../data/site';
const chemin = Astro.url.pathname.replace(/\/+$/, '');
const masque = chemin === '/pilote';
---
{
  !masque && (
    <div class="cta-mobile" data-cta-mobile data-visible="false" inert>
      <a href={lienInscription} class="btn btn-primaire w-full" tabindex="-1" data-cta-lien>
        Rejoindre le pilote
      </a>
    </div>
  )
}

<style>
  .cta-mobile {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 45;
    padding: var(--space-3) var(--marge) max(var(--space-3), env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-creme) 96%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transform: translateY(105%);
    transition: transform var(--duree-3) var(--ease-sortie);
  }
  .cta-mobile[data-visible='true'] {
    transform: none;
  }
  /* filet doré fin au-dessus du bouton */
  .cta-mobile::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-dore), transparent);
  }
  .cta-mobile :global(.btn) {
    padding-inline: var(--space-3);
  }
  @media (min-width: 64rem) {
    .cta-mobile {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-mobile {
      transition: none;
    }
  }
</style>

<script>
  const barre = document.querySelector<HTMLElement>('[data-cta-mobile]');
  const lien = barre?.querySelector<HTMLAnchorElement>('[data-cta-lien]');

  if (barre && lien) {
    const hero = document.querySelector('[data-hero-cta]');
    const cibles = [document.querySelector('[data-page-cta]'), document.querySelector('footer')].filter(Boolean) as Element[];
    const ciblesVisibles = new Set<Element>();
    let heroVisible = !!hero;
    let passeEcran = false;

    const mettreAJour = () => {
      const visible = passeEcran && !heroVisible && ciblesVisibles.size === 0;
      barre.dataset.visible = String(visible);
      // Hors écran, le bouton ne doit pas recevoir le focus clavier ni être lu.
      lien.tabIndex = visible ? 0 : -1;
      barre.toggleAttribute('inert', !visible);
    };

    // « Après le premier écran » : on a défilé de plus de 85 % de la hauteur de l’écran.
    const surDefilement = () => {
      passeEcran = window.scrollY > window.innerHeight * 0.85;
      mettreAJour();
    };
    window.addEventListener('scroll', surDefilement, { passive: true });
    window.addEventListener('resize', surDefilement);

    if ('IntersectionObserver' in window) {
      if (hero) {
        new IntersectionObserver(([entree]) => {
          heroVisible = entree.isIntersecting;
          mettreAJour();
        }).observe(hero);
      }
      const observateur = new IntersectionObserver((entrees) => {
        entrees.forEach((e) => (e.isIntersecting ? ciblesVisibles.add(e.target) : ciblesVisibles.delete(e.target)));
        mettreAJour();
      });
      cibles.forEach((c) => observateur.observe(c));
    }
    surDefilement();
  }
</script>
