---
/**
 * Bouton fixe en bas d’écran sur mobile. Il apparaît une fois le haut de page passé
 * (bouton du hero sur l’accueil, sinon un peu de défilement) et s’efface quand le pied de page
 * ou un bloc d’appel au pilote est à l’écran. Absent de la page /pilote, qui est déjà l’inscription.
 */
import { lienInscription } from '../data/site';
const chemin = Astro.url.pathname.replace(/\/+$/, '');
const masque = chemin === '/pilote';
---
{
  !masque && (
    <div
      class="fixed inset-x-0 bottom-0 z-50 translate-y-full border-t border-filet bg-creme/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-sm transition-transform duration-300 data-[visible=true]:translate-y-0 lg:hidden"
      data-cta-mobile
      data-visible="false"
    >
      <a href={lienInscription} class="btn btn-primaire w-full" tabindex="-1" data-cta-lien>
        Rejoindre le programme pilote
      </a>
    </div>
  )
}

<script>
  const barre = document.querySelector<HTMLElement>('[data-cta-mobile]');
  const lien = barre?.querySelector<HTMLAnchorElement>('[data-cta-lien]');

  if (barre && lien && 'IntersectionObserver' in window) {
    // Sentinelle : le bouton du hero s’il existe, sinon une sentinelle posée à 500 px du haut.
    let hero: Element | null = document.querySelector('[data-hero-cta]');
    if (!hero) {
      const s = document.createElement('div');
      s.setAttribute('aria-hidden', 'true');
      s.style.cssText = 'position:absolute;top:500px;left:0;width:1px;height:1px;pointer-events:none';
      document.body.style.position ||= 'relative';
      document.body.prepend(s);
      hero = s;
    }
    const cibles = [document.querySelector('[data-page-cta]'), document.querySelector('footer')].filter(Boolean) as Element[];
    let heroVisible = true;
    const ciblesVisibles = new Set<Element>();

    const mettreAJour = () => {
      const visible = !heroVisible && ciblesVisibles.size === 0;
      barre.dataset.visible = String(visible);
      // Hors écran, le bouton ne doit pas recevoir le focus clavier.
      lien.tabIndex = visible ? 0 : -1;
      barre.toggleAttribute('inert', !visible);
    };

    new IntersectionObserver(([entree]) => {
      heroVisible = entree.isIntersecting || entree.boundingClientRect.top > 0;
      mettreAJour();
    }).observe(hero);

    const observateur = new IntersectionObserver((entrees) => {
      entrees.forEach((e) => (e.isIntersecting ? ciblesVisibles.add(e.target) : ciblesVisibles.delete(e.target)));
      mettreAJour();
    });
    cibles.forEach((c) => observateur.observe(c));
  }
</script>
