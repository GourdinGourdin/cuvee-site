---
import ACompleter from './ACompleter.astro';

// TODO : remplacer par les vrais membres de l’équipe (prénom, rôle, parcours en une ligne).
// Pas de photo tant qu’il n’y a pas de vrai portrait : le monogramme (chiffre romain) pourra être
// remplacé par les initiales de chaque membre, ou par un <Photo> dans `.membre-portrait`.
const membres = ['I', 'II', 'III'];
---
<section id="equipe" aria-labelledby="equipe-titre" class="equipe section bg-creme">
  <div class="conteneur">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-end lg:gap-24">
      <div>
        <p class="surtitre" data-reveal>Qui on est</p>
        <h2 id="equipe-titre" class="mt-4" data-reveal data-reveal-delai="1">
          Une petite équipe, qui veut construire avec le métier.
        </h2>
      </div>
      <div>
        <p class="texte-courant" data-reveal data-reveal-delai="2">
          Nous ne voulons pas inventer un outil dans un bureau puis venir vous le vendre. Nous voulons le mettre au point
          dans de vrais lieux, avec les gens qui les font tourner.
        </p>
        <p class="texte-courant mt-4" data-reveal data-reveal-delai="3">
          <ACompleter texte="qui vous êtes en deux phrases : parcours, lien avec le vin, pourquoi ce projet" />
        </p>
      </div>
    </div>

    <ul role="list" class="mt-12 grid gap-12 sm:grid-cols-3 sm:gap-8 lg:mt-16 lg:gap-12">
      {
        membres.map((rang, i) => (
          <li class="membre" data-reveal data-reveal-delai={String(i + 1)}>
            <div class="membre-portrait" aria-hidden="true">
              <span class="membre-rang">{rang}</span>
              <span class="membre-legende">Portrait à venir</span>
            </div>
            <div class="mt-6">
              <h3 class="membre-nom"><ACompleter texte="prénom nom" /></h3>
              <p class="texte-courant mt-2"><ACompleter texte="rôle, parcours en une ligne" /></p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  .equipe .membre-portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bordeaux-clair);
    border-radius: var(--rayon);
    color: var(--color-bordeaux);
  }
  /* cadre intérieur doré, comme une photo encadrée en attente */
  .equipe .membre-portrait::after {
    content: "";
    position: absolute;
    inset: var(--space-3);
    border: 1px solid var(--color-dore);
    border-radius: 1px;
    pointer-events: none;
  }
  .equipe .membre-rang {
    font-family: var(--font-titre);
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    letter-spacing: 0.12em;
    padding-left: 0.12em;
    line-height: 1;
  }
  .equipe .membre-legende {
    position: absolute;
    bottom: var(--space-5);
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-encre-douce);
  }
  @media (min-width: 40rem) {
    .equipe .membre-portrait { aspect-ratio: 4 / 5; }
  }
  .equipe .membre-nom { line-height: 1.35; }
</style>
