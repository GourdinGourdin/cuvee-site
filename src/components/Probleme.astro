---
import TitreSection from './TitreSection.astro';

const scenes = [
  {
    moment: 'Lundi, 9 h',
    titre: 'La matinée des commandes',
    texte:
      "Le tableur d’un côté, les factures de la semaine de l’autre. On recompte, on devine ce qui va partir, on écrit à six domaines. À midi, ce n’est pas fini.",
  },
  {
    moment: 'Vendredi, 21 h',
    titre: "La rupture qu’on n’a pas vue venir",
    texte:
      "Le blanc qui part le mieux au verre est terminé. Personne n’avait vu le stock baisser, et la prochaine livraison n’arrive que mardi.",
  },
  {
    moment: 'Au fond de la réserve',
    titre: 'Les cartons qui prennent la poussière',
    texte:
      "Des bouteilles achetées sur un coup de cœur il y a un an. Personne ne pense à les proposer. C’est de l’argent qui dort.",
  },
];
---
<section id="probleme" aria-labelledby="probleme-titre" class="relative overflow-hidden border-t border-filet bg-creme-fonce py-20 lg:py-28">
  <div class="conteneur">
    <div data-reveal>
      <TitreSection
        numero="1"
        libelle="Le problème"
        id="probleme-titre"
        titre="Une belle carte des vins, et beaucoup d’heures derrière."
      >
        <p class="mt-5 max-w-2xl text-lg text-encre-douce">
          Trois situations que nous voulons régler. Si elles vous parlent, ou si nous nous trompons, dites-le-nous.
        </p>
      </TitreSection>
    </div>

    <ol role="list" class="mt-14 grid gap-12 lg:grid-cols-3 lg:gap-0">
      {
        scenes.map((scene, i) => (
          <li
            data-reveal
            data-reveal-delai={String(i + 1)}
            class:list={[
              'relative border-t border-encre pt-5 lg:px-8',
              i === 0 && 'lg:pl-0',
              i > 0 && 'lg:border-l lg:border-l-filet',
              i === 2 && 'lg:pr-0',
            ]}
          >
            <span class="chiffre-contour font-serif text-[4.5rem] leading-none font-light select-none" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="surtitre mt-4 text-bordeaux">{scene.moment}</p>
            <h3 class="mt-3 text-2xl leading-snug font-medium">{scene.titre}</h3>
            <p class="mt-3 text-encre-douce">{scene.texte}</p>
          </li>
        ))
      }
    </ol>

    <figure class="relative mt-16 max-w-3xl border-t border-dore pt-8 pl-0 sm:pl-14" data-reveal="gauche">
      <span class="absolute -top-2 left-0 hidden font-serif text-8xl leading-none text-bordeaux/25 sm:block" aria-hidden="true">“</span>
      <p class="font-serif text-2xl leading-snug font-light sm:text-3xl">
        Votre métier, c’est de choisir les vins et de les faire découvrir, pas de compter des cartons.{' '}
        <em class="font-normal text-bordeaux">Le suivi, Cuvée veut s’en charger.</em>
      </p>
    </figure>
  </div>
</section>

<style>
  .chiffre-contour {
    color: transparent;
    -webkit-text-stroke: 1px var(--color-bordeaux);
  }
</style>
