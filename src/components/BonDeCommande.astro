---
/**
 * Aperçu stylisé d’une proposition de commande, à valider d’un clic.
 * Domaine, vins et quantités sont inventés pour l’illustration.
 */
const BOUTEILLES_PAR_CARTON = 6;
const FRANCO = 48;

const lignes = [
  { vin: 'Anjou blanc 2022', ventes: 18, stock: 4, commande: 24 },
  { vin: 'Saumur-Champigny 2021', ventes: 11, stock: 7, commande: 12 },
  { vin: 'Crémant de Loire brut', ventes: 9, stock: 2, commande: 12 },
];
const total = lignes.reduce((somme, l) => somme + l.commande, 0);
const cartons = (bouteilles: number) => bouteilles / BOUTEILLES_PAR_CARTON;
---
<div class="relative mx-auto w-full max-w-md lg:max-w-none">
  <!-- feuille du dessous, pour l’effet de carnet -->
  <div
    class="papier absolute inset-0 translate-x-2 translate-y-3 rotate-[2.2deg] opacity-80 lg:translate-x-3"
    aria-hidden="true"
  >
  </div>

  <article
    class="papier papier-ombre relative lg:rotate-[-0.8deg]"
    data-demo
    aria-label="Exemple illustratif : proposition de commande préparée par Cuvée"
  >
    <div class="perforation" aria-hidden="true"></div>

    <div class="marge-carnet px-4 pt-5 pb-5 pl-9 sm:px-7 sm:pb-6 sm:pl-12">
      <div class="flex items-start justify-between gap-3">
        <p class="surtitre text-encre-douce">Proposition de commande</p>
        <p class="cachet shrink-0 text-bordeaux">Exemple illustratif</p>
      </div>
      <p class="mt-3 font-serif text-2xl leading-tight font-medium">Domaine A · Anjou</p>
      <p class="chiffres mt-1 text-[0.85rem] text-encre-douce">Préparée lundi à 7 h 02</p>

      <table class="mt-5 w-full text-left">
        <caption class="sr-only">Quantités proposées par référence</caption>
        <thead>
          <tr class="surtitre border-b border-encre text-encre-douce">
            <th scope="col" class="pb-2 font-medium">Référence</th>
            <th scope="col" class="pb-2 text-right font-medium whitespace-nowrap">
              <span class="sm:hidden">Cave</span><span class="hidden sm:inline">En cave</span>
            </th>
            <th scope="col" class="pb-2 pl-3 text-right font-medium whitespace-nowrap">
              <span class="sm:hidden">Commande</span><span class="hidden sm:inline">À commander</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            lignes.map((l, i) => (
              <tr class="ligne-pointillee ligne-ecrite align-top" style={`--i:${i}`}>
                <th scope="row" class="py-2.5 pr-2 font-semibold">
                  {l.vin}
                  <span class="block text-[0.85rem] font-normal text-encre-douce">{l.ventes} vendues en 4 semaines</span>
                </th>
                <td class="chiffres py-2.5 text-right">{l.stock}</td>
                <td class="py-2.5 pl-3 text-right">
                  <span class="chiffres font-medium text-bordeaux">{l.commande}</span>
                  <span class="block text-[0.85rem] whitespace-nowrap text-encre-douce">
                    {cartons(l.commande)} carton{cartons(l.commande) > 1 && 's'}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr class="total-ligne">
            <th scope="row" class="pt-3 align-top font-semibold">Total</th>
            <td colspan="2" class="pt-3 pl-3 text-right">
              <span class="chiffres font-medium whitespace-nowrap"><span data-total-nb>{total}</span> bouteilles</span>
              <span class="block text-[0.85rem] text-encre-douce">{cartons(total)} cartons de {BOUTEILLES_PAR_CARTON}</span>
            </td>
          </tr>
        </tfoot>
      </table>

      <p class="mt-3 flex items-center gap-2 text-[0.9rem] text-vert">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="shrink-0">
          <path d="M2.5 7.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" />
        </svg>
        Franco du domaine ({FRANCO} bouteilles) atteint
      </p>

      <p class="mt-4 border-l-2 border-dore bg-creme/60 py-2 pr-2 pl-3 text-[0.95rem] leading-snug text-encre-douce">
        <span class="font-semibold text-encre">Pourquoi maintenant :</span> à ce rythme, il ne restera plus d’Anjou blanc
        samedi. Le domaine livre en 5 jours : c’est à commander aujourd’hui.
      </p>

      <div class="mt-5 flex flex-wrap gap-2.5">
        <button
          type="button"
          class="btn btn-primaire btn-mini"
          data-demo-action="valider"
          data-demo-message="Validée. La commande partirait par email au domaine. Ici, c’est une démonstration : rien n’a été envoyé."
        >
          Valider et envoyer
        </button>
        <button
          type="button"
          class="btn btn-contour btn-mini"
          data-demo-action="modifier"
          data-demo-message="Dans Cuvée, vous ajusteriez chaque quantité avant l’envoi."
        >
          Modifier
        </button>
      </div>
      <p class="mt-3 min-h-[1.25rem] text-[0.875rem] text-vert" role="status" data-demo-statut></p>
    </div>

    <span class="tampon tampon-auto bottom-8 right-8 max-sm:hidden" aria-hidden="true">Validé</span>
  </article>
</div>

<style>
  /* les lignes s’écrivent de gauche à droite, l’une après l’autre */
  .ligne-ecrite {
    animation: ecrire 0.8s cubic-bezier(0.3, 0.6, 0.2, 1) both;
    animation-delay: calc(0.7s + var(--i) * 0.55s);
  }
  .total-ligne {
    animation: ecrire 0.6s ease-out both;
    animation-delay: 2.5s;
  }
  @keyframes ecrire {
    from {
      clip-path: inset(0 100% 0 0);
      opacity: 0.2;
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }
  /* tampon posé automatiquement, comme si la commande venait d’être relue */
  .tampon-auto {
    animation: tamponner-auto 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.25) 3.6s forwards;
  }
  @keyframes tamponner-auto {
    to {
      opacity: 0.92;
      transform: rotate(-11deg) scale(1);
    }
  }
</style>

<script>
  // Le total se calcule à l’écran ; sans animation (ou sans JS), la valeur finale reste affichée.
  const nb = document.querySelector<HTMLElement>('[data-total-nb]');
  if (nb && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const fin = Number(nb.textContent);
    const debut = performance.now() + 2500;
    nb.textContent = '0';
    const pas = (t: number) => {
      const k = Math.min(Math.max((t - debut) / 700, 0), 1);
      nb.textContent = String(Math.round(fin * k));
      if (k < 1) requestAnimationFrame(pas);
    };
    requestAnimationFrame(pas);
  }
</script>
