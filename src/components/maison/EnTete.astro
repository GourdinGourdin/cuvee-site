---
/**
 * En-tête de toutes les pages.
 * - Grand écran : MENU à gauche, onglets répartis de part et d’autre de l’emblème central,
 *   bouton « Rejoindre le pilote » à droite. Un filet doré glisse d’un onglet à l’autre.
 * - Mobile / tablette : MENU, emblème centré, bouton du pilote.
 * - Transparent (texte crème) sur l’image d’en-tête, fond crème dès qu’on défile ; il se masque
 *   en descendant et réapparaît en remontant.
 * - Le menu s’ouvre en plein écran dans un <dialog> natif (Échap, focus piégé et rendu au bouton,
 *   défilement bloqué), avec sur grand écran un panneau d’image qui change selon l’onglet visé.
 * Le script de cet en-tête est à la fin du fichier ; les animations de lecture sont dans animations.ts.
 */
import Logo from '../Logo.astro';
import Photo from '../Photo.astro';
import { navigation, lienInscription } from '../../data/site';

const chemin = Astro.url.pathname.replace(/\/+$/, '') || '/';
const actif = (href: string) => (href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(href + '/'));
const romain = ['I', 'II', 'III', 'IV', 'V', 'VI'];

// Image du panneau du menu, par onglet.
const visuels: Record<string, string> = {
  '/': '/media/cave-lumiere-poster.jpg',
  '/comment-ca-marche': '/media/vitrine-cave.jpg',
  '/pilote': '/media/assiette-ardoise.jpg',
  '/equipe': '/media/comptoir-soir.jpg',
  '/questions': '/media/cave-futs.jpg',
};
const onglets = navigation.map((item) => ({ ...item, courant: actif(item.href), image: visuels[item.href] ?? visuels['/'] }));
const courant = onglets.find((o) => o.courant) ?? onglets[0];
const gauche = onglets.slice(0, 2);
const droite = onglets.slice(2);
---
<header class="entete fixed inset-x-0 top-0 z-40 text-creme" data-entete data-plein="false" data-cache="false">
  <div class="entete-barre grid grid-cols-[1fr_auto_1fr] items-center gap-4 px-4 sm:px-8 lg:px-12">
    <button type="button" class="entete-menu flex min-h-12 min-w-12 flex-col items-center justify-center gap-1.5 justify-self-start" data-menu-ouvrir aria-haspopup="dialog" aria-expanded="false">
      <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
      <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
      <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
      <span class="entete-menu-mot">MENU</span>
    </button>
    {/* sans JavaScript le menu plein écran ne s'ouvre pas : le bouton est masqué et remplacé par un lien vers la navigation du pied de page */}
    <noscript>
      <style>
        [data-menu-ouvrir] { display: none !important; }
      </style>
      <a href="#pied-nav" class="entete-menu flex min-h-12 min-w-12 flex-col items-center justify-center gap-1.5 justify-self-start">
        <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
        <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
        <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
        <span class="entete-menu-mot">MENU</span>
      </a>
    </noscript>

    <a href="/" class="entete-logo entete-logo-mobile" aria-label="Cuvée, accueil">
      <Logo variante="pile" taille={26} heritee />
    </a>

    <nav aria-label="Navigation principale" class="entete-nav" data-nav-desktop>
      <ul role="list" class="entete-onglets entete-onglets-g">
        {
          gauche.map((o) => (
            <li>
              <a href={o.href} class="onglet" aria-current={o.courant ? 'page' : undefined}>{o.libelle}</a>
            </li>
          ))
        }
      </ul>
      <a href="/" class="entete-logo" aria-label="Cuvée, accueil">
        <Logo variante="pile" taille={26} heritee />
      </a>
      <ul role="list" class="entete-onglets entete-onglets-d">
        {
          droite.map((o) => (
            <li>
              <a href={o.href} class="onglet" aria-current={o.courant ? 'page' : undefined}>{o.libelle}</a>
            </li>
          ))
        }
      </ul>
      <span class="entete-indicateur" aria-hidden="true" data-indicateur></span>
    </nav>

    <a href={lienInscription} class="btn btn-primaire btn-petit entete-cta entete-cta-xl">Rejoindre le pilote</a>
    <a href={lienInscription} class="btn btn-primaire btn-petit entete-cta entete-cta-md">Le pilote</a>
    <a href={lienInscription} class="lien-cap entete-cta-sm">Pilote</a>
  </div>
</header>

<dialog class="menu-plein" aria-label="Menu" data-menu>
  <div class="menu-grille">
    <div class="menu-contenu">
      <div class="menu-haut">
        <button type="button" class="lien-cap" data-menu-fermer>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.4"></path></svg>
          Fermer
        </button>
        <a href="/" class="entete-logo menu-logo" aria-label="Cuvée, accueil">
          <Logo variante="pile" taille={26} heritee />
        </a>
        <span aria-hidden="true"></span>
      </div>

      <nav aria-label="Menu" class="menu-nav" data-menu-liste>
        <ol role="list">
          {
            onglets.map((o, i) => (
              <li style={`--i:${i}`}>
                <a href={o.href} class="menu-lien" aria-current={o.courant ? 'page' : undefined} data-image={o.image}>
                  <span class="menu-num" aria-hidden="true">{romain[i]}</span>
                  <span class="menu-texte">{o.libelle}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="menu-bas">
        <a href={lienInscription} class="btn btn-creme">Rejoindre le programme pilote</a>
      </div>
    </div>

    <div class="menu-visuel" aria-hidden="true" data-menu-visuel data-defaut={courant.image}>
      {
        Array.from(new Set(onglets.map((o) => o.image))).map((src) => (
          <Photo src={src} alt="" sizes="50vw" loading="lazy" data-src={src} />
        ))
      }
      <div class="menu-visuel-voile"></div>
    </div>
  </div>
</dialog>

<style>
  /* ---------- barre ---------- */
  .entete {
    --h: 5rem;
    transition:
      background-color 0.45s ease,
      color 0.45s ease,
      box-shadow 0.45s ease,
      translate 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    view-transition-name: entete;
  }
  @media (min-width: 64rem) {
    .entete {
      --h: 6rem;
    }
  }
  /* voile léger sous l’en-tête transparent : le texte crème reste lisible sur une image claire */
  .entete::before {
    content: '';
    position: absolute;
    inset: 0 0 -1.5rem 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(42 34 32 / 0.5), transparent);
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  .entete[data-plein='true']::before {
    opacity: 0;
  }
  .entete[data-plein='true'] {
    --h: 4.5rem;
    background: var(--color-creme);
    color: var(--color-encre);
    box-shadow: 0 1px 0 var(--color-filet);
  }
  .entete[data-cache='true'] {
    translate: 0 -105%;
    box-shadow: none;
  }
  .entete-barre {
    height: var(--h);
    transition: height 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .entete-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    justify-content: center;
    color: inherit;
    text-decoration: none;
  }
  .entete-menu-mot {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    margin-right: -0.2em;
  }

  /* ---------- onglets (grand écran) ---------- */
  .entete-nav {
    position: relative;
    display: none;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: clamp(1.5rem, 3vw, 3rem);
  }
  .entete-onglets {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2vw, 2rem);
  }
  .entete-onglets-g {
    justify-content: flex-end;
  }
  .entete-onglets-d {
    justify-content: flex-start;
  }
  .onglet {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-top: 0.1rem;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
    opacity: 0.85;
    transition: opacity var(--duree-2) ease;
  }
  .onglet:hover,
  .onglet:focus-visible,
  .onglet[aria-current='page'] {
    opacity: 1;
  }
  .onglet[aria-current='page'] {
    font-weight: 700;
  }
  .entete-indicateur {
    position: absolute;
    left: 0;
    top: 0;
    height: 1px;
    width: 0;
    background: var(--color-dore);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }
  /* repli sans JS : souligné doré sur l’onglet actif */
  .entete-nav:not([data-indic]) .onglet[aria-current='page'] {
    background: linear-gradient(var(--color-dore), var(--color-dore)) 0 calc(50% + 0.95rem) / 100% 1px no-repeat;
  }

  .entete-cta,
  .entete-cta-sm {
    justify-self: end;
  }
  .entete-cta-xl,
  .entete-cta-md {
    display: none;
  }
  .entete-cta-sm {
    display: inline-flex;
  }
  @media (min-width: 40rem) {
    .entete-cta-sm {
      display: none;
    }
    .entete-cta-md {
      display: inline-flex;
    }
  }
  @media (min-width: 64rem) {
    .entete-logo-mobile {
      display: none;
    }
    .entete-nav {
      display: grid;
    }
    /* entre 1024 et 1279 px, l'onglet « Le pilote » suffit : pas de bouton en plus */
    .entete-cta-md {
      display: none;
    }
  }
  @media (min-width: 80rem) {
    .entete-cta-md {
      display: none;
    }
    .entete-cta-xl {
      display: inline-flex;
    }
  }
  .entete-cta {
    padding-inline: 1.25rem;
  }

  /* ---------- menu plein écran ---------- */
  .menu-plein {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--color-bordeaux);
    color: var(--color-creme);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.55s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .menu-plein::backdrop {
    background: transparent;
  }
  .menu-plein[data-etat='ouvert'] {
    clip-path: inset(0 0 0 0);
    transition-duration: 0.8s;
    transition-timing-function: cubic-bezier(0.76, 0, 0.18, 1);
  }
  .menu-grille {
    display: grid;
    height: 100%;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 64rem) {
    .menu-grille {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    }
  }
  .menu-contenu {
    display: flex;
    min-height: 0;
    flex-direction: column;
    overflow-y: auto;
    padding: 1.25rem 1rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .menu-contenu {
      padding: 1.5rem 2rem 2rem;
    }
  }
  @media (min-width: 64rem) {
    .menu-contenu {
      padding: 1.75rem 3rem 2.5rem;
    }
  }
  .menu-haut {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .menu-haut .lien-cap {
    justify-self: start;
  }
  .menu-nav {
    display: flex;
    flex: 1;
    align-items: center;
    padding-block: 2rem;
  }
  .menu-nav ol {
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }
  @media (min-width: 64rem) {
    .menu-nav ol {
      margin-inline: 0;
      padding-left: min(4vw, 4rem);
    }
  }
  .menu-lien {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.15rem;
    font-family: var(--font-titre);
    font-weight: 800;
    font-size: clamp(1.5rem, 6vw, 2.75rem);
    white-space: normal;
    letter-spacing: 0.07em;
    line-height: 1.25;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    transition:
      color 0.35s ease,
      opacity 0.35s ease,
      translate 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 64rem) {
    .menu-lien {
      font-size: clamp(1.9rem, 2.8vw, 2.5rem);
      white-space: nowrap;
    }
  }
  .menu-num {
    flex: none;
    width: 2.5rem;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--color-dore-clair);
  }
  .menu-texte {
    position: relative;
    flex: 0 1 auto;
  }
  .menu-texte::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1em;
    height: 1px;
    background: var(--color-dore-clair);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu-lien[aria-current='page'] .menu-texte::after {
    transform: scaleX(1);
  }
  .menu-lien:hover .menu-texte::after,
  .menu-lien:focus-visible .menu-texte::after {
    transform: scaleX(1);
  }
  .menu-nav ol:hover .menu-lien:not(:hover),
  .menu-nav ol:focus-within .menu-lien:not(:focus-visible) {
    opacity: 0.55;
  }
  .menu-lien:hover,
  .menu-lien:focus-visible {
    translate: 0.5rem 0;
  }
  .menu-bas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 2.5rem;
    padding-top: 1rem;
  }
  @media (min-width: 64rem) {
    .menu-bas {
      justify-content: flex-start;
      padding-left: min(4vw, 4rem);
    }
  }

  /* panneau d’image : grand écran seulement */
  .menu-visuel {
    display: none;
    position: relative;
    overflow: hidden;
    background: var(--color-chai);
  }
  @media (min-width: 64rem) {
    .menu-visuel {
      display: block;
    }
  }
  .menu-visuel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    scale: 1.07;
    transition:
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      scale 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu-visuel :global(img.est-actif) {
    opacity: 1;
    scale: 1;
  }
  .menu-visuel-voile {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(74 20 32 / 0.55), transparent 35%);
  }

  /* entrée / sortie : la liste monte en cascade, l’image se découvre */
  .menu-lien,
  .menu-bas,
  .menu-haut {
    opacity: 0;
  }
  .menu-lien {
    translate: 0 1.4rem;
  }
  .menu-plein[data-etat='ouvert'] .menu-lien {
    opacity: 1;
    translate: 0 0;
    transition-duration: 0.8s;
    transition-delay: calc(var(--i) * 70ms + 280ms);
    transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transition-property: opacity, translate, color;
  }
  .menu-plein[data-etat='ouvert'] .menu-bas,
  .menu-plein[data-etat='ouvert'] .menu-haut {
    opacity: 1;
    transition: opacity 0.7s ease 0.55s;
  }
  .menu-plein[data-etat='ouvert'] .menu-lien:hover,
  .menu-plein[data-etat='ouvert'] .menu-lien:focus-visible {
    translate: 0.5rem 0;
    transition-delay: 0s;
    transition-duration: 0.5s;
  }
  .menu-plein[data-etat='ouvert'] .menu-nav ol:hover .menu-lien:not(:hover),
  .menu-plein[data-etat='ouvert'] .menu-nav ol:focus-within .menu-lien:not(:focus-visible) {
    opacity: 0.55;
    transition-delay: 0s;
  }
  .menu-visuel {
    clip-path: inset(0 0 0 100%);
    transition: clip-path 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .menu-plein[data-etat='ouvert'] .menu-visuel {
    clip-path: inset(0);
    transition: clip-path 1.1s cubic-bezier(0.76, 0, 0.18, 1) 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-plein,
    .menu-lien,
    .menu-bas,
    .menu-haut,
    .menu-visuel {
      transition: none !important;
    }
    .menu-lien {
      translate: 0 0;
    }
    .entete {
      transition: none;
    }
  }

  :global(html.menu-ouvert) {
    scrollbar-gutter: stable;
  }
</style>

<script>
  const entete = document.querySelector<HTMLElement>('[data-entete]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const ouvrir = document.querySelector<HTMLButtonElement>('[data-menu-ouvrir]');
  const reduit = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- fond crème au défilement, masquage en descendant ---------- */
  if (entete) {
    let dernier = window.scrollY;
    let attente = false;
    const majEntete = () => {
      attente = false;
      const y = Math.max(window.scrollY, 0);
      entete.dataset.plein = String(y > 60);
      const delta = y - dernier;
      const verrou = menu?.open || !!entete.querySelector(':focus-visible');
      if (verrou || y < 140) {
        entete.dataset.cache = 'false';
        dernier = y;
      } else if (delta > 8) {
        entete.dataset.cache = 'true';
        dernier = y;
      } else if (delta < -8) {
        entete.dataset.cache = 'false';
        dernier = y;
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!attente) {
          attente = true;
          requestAnimationFrame(majEntete);
        }
      },
      { passive: true },
    );
    entete.addEventListener('focusin', () => {
      if (entete.querySelector(':focus-visible')) entete.dataset.cache = 'false';
    });
    majEntete();

    /* ---------- filet doré qui glisse d’un onglet à l’autre ---------- */
    const nav = entete.querySelector<HTMLElement>('[data-nav-desktop]');
    const indic = nav?.querySelector<HTMLElement>('[data-indicateur]');
    if (nav && indic) {
      const liens = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a.onglet'));
      const courant = () => nav.querySelector<HTMLAnchorElement>('a[aria-current="page"]');
      const placer = (a: HTMLElement | null, animer: boolean) => {
        if (!a || nav.offsetWidth === 0) {
          indic.style.opacity = '0';
          return;
        }
        const n = nav.getBoundingClientRect();
        const r = a.getBoundingClientRect();
        // le filet se pose sous le texte, sans le dernier interlettrage
        const x = r.left - n.left;
        const y = r.top - n.top + r.height / 2 + 14;
        if (!animer) indic.style.transition = 'none';
        indic.style.width = `${Math.round(r.width - 3)}px`;
        indic.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
        indic.style.opacity = '1';
        if (!animer) {
          void indic.offsetWidth;
          indic.style.transition = '';
        }
      };
      nav.dataset.indic = 'oui';
      const retour = () => placer(courant(), true);
      liens.forEach((a) => {
        a.addEventListener('mouseenter', () => placer(a, true));
        a.addEventListener('focus', () => placer(a, true));
        a.addEventListener('blur', retour);
      });
      nav.addEventListener('mouseleave', retour);
      window.addEventListener('resize', () => placer(courant(), false));
      document.fonts?.ready.then(() => placer(courant(), false));
      placer(courant(), false);
    }
  }

  /* ---------- menu plein écran ---------- */
  if (menu && ouvrir) {
    const visuel = menu.querySelector<HTMLElement>('[data-menu-visuel]');
    const images = Array.from(visuel?.querySelectorAll<HTMLImageElement>('img') ?? []);
    const defaut = visuel?.dataset.defaut ?? '';
    let ferme = false;
    let minuterie = 0;

    const montrer = (src: string) => images.forEach((img) => img.classList.toggle('est-actif', img.dataset.src === src));
    const precharger = () => images.forEach((img) => (img.loading = 'eager'));
    ['pointerenter', 'focus', 'touchstart'].forEach((ev) => ouvrir.addEventListener(ev, precharger, { once: true, passive: true }));

    const ouvrirMenu = () => {
      if (menu.open) return;
      clearTimeout(minuterie);
      precharger();
      montrer(defaut);
      menu.showModal();
      document.documentElement.classList.add('menu-ouvert');
      ouvrir.setAttribute('aria-expanded', 'true');
      menu.dataset.etat = '';
      // deux images de rendu : le <dialog> doit être peint dans son état fermé avant de s’ouvrir
      requestAnimationFrame(() => requestAnimationFrame(() => (menu.dataset.etat = 'ouvert')));
    };

    const fermerMenu = (rendreFocus = true) => {
      if (!menu.open || ferme) return;
      ferme = true;
      menu.dataset.etat = 'ferme';
      const fin = () => {
        ferme = false;
        menu.close();
        document.documentElement.classList.remove('menu-ouvert');
        ouvrir.setAttribute('aria-expanded', 'false');
        if (rendreFocus) ouvrir.focus({ preventScroll: true });
      };
      if (reduit()) fin();
      else minuterie = window.setTimeout(fin, 560);
    };

    ouvrir.addEventListener('click', ouvrirMenu);
    menu.querySelector('[data-menu-fermer]')?.addEventListener('click', () => fermerMenu());
    // Échap : fermeture animée plutôt que brutale
    menu.addEventListener('cancel', (e) => {
      e.preventDefault();
      fermerMenu();
    });
    // lien interne vers la même page ou une ancre : on referme avant de naviguer
    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((a) =>
      a.addEventListener('click', () => {
        const url = new URL(a.href, location.href);
        if (url.pathname === location.pathname) fermerMenu(false);
      }),
    );
    // un clic hors du contenu (bord du dialog) ne ferme pas : le menu couvre tout l’écran
    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => {
      // le menu reste utilisable ; on garde simplement le bon visuel
      montrer(defaut);
    });

    // image du panneau selon l’onglet survolé ou focalisé
    menu.querySelectorAll<HTMLAnchorElement>('[data-image]').forEach((a) => {
      const viser = () => montrer(a.dataset.image ?? defaut);
      a.addEventListener('mouseenter', viser);
      a.addEventListener('focus', viser);
    });
    const liste = menu.querySelector<HTMLElement>('[data-menu-liste]');
    liste?.addEventListener('mouseleave', () => {
      const focus = document.activeElement as HTMLElement | null;
      montrer(focus && liste.contains(focus) ? (focus.dataset.image ?? defaut) : defaut);
    });

    // focus piégé dans le menu
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusables = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button')).filter((el) => el.offsetParent !== null);
      if (!focusables.length) return;
      const premier = focusables[0];
      const dernierEl = focusables[focusables.length - 1];
      const actif = document.activeElement;
      if (e.shiftKey && (actif === premier || actif === menu)) {
        e.preventDefault();
        dernierEl.focus();
      } else if (!e.shiftKey && actif === dernierEl) {
        e.preventDefault();
        premier.focus();
      }
    });
  }
</script>
