---
/**
 * En-tête de l'accueil : transparent sur la vidéo, il prend un fond rosé dès qu'on défile.
 * Le menu s'ouvre en plein écran dans un <dialog> natif (Échap, focus gardé dedans).
 */
import Embleme from './Embleme.astro';
import { navigation, lienInscription } from '../../data/site';
---
<header class="entete fixed inset-x-0 top-0 z-40 text-creme" data-entete data-plein="false">
  <div class="flex h-20 items-center justify-between gap-4 px-4 sm:px-8 lg:h-24 lg:px-12">
    <button type="button" class="entete-menu flex min-h-12 min-w-12 flex-col items-center justify-center gap-1.5" data-menu-ouvrir aria-haspopup="dialog">
      <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
      <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
      <span class="block h-px w-8 bg-current" aria-hidden="true"></span>
      <span class="text-[0.7rem] font-semibold tracking-[0.2em]">MENU</span>
    </button>

    <a href="/" class="absolute left-1/2 flex -translate-x-1/2 flex-col items-center gap-1" aria-label="Cuvée, accueil">
      <Embleme taille={15} />
      <span class="font-[family-name:var(--font-titre)] text-[0.95rem] font-extrabold tracking-[0.32em] [margin-right:-0.32em]">CUVÉE</span>
    </a>

    <a href={lienInscription} class="btn btn-primaire hidden sm:inline-flex">Rejoindre le pilote</a>
    <a href={lienInscription} class="lien-cap sm:hidden">Pilote</a>
  </div>
</header>

<dialog class="menu-plein" aria-label="Menu" data-menu>
  <div class="flex min-h-full flex-col px-4 py-6 sm:px-8 lg:px-12">
    <button type="button" class="lien-cap self-start" data-menu-fermer>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.4" /></svg>
      Fermer
    </button>
    <nav aria-label="Navigation principale" class="flex flex-1 flex-col items-center justify-center gap-2 py-10 text-center">
      {
        navigation.map((item, i) => (
          <a href={item.href} class="menu-lien" style={`--i:${i}`}>
            {item.libelle}
          </a>
        ))
      }
      <span class="signature mt-8 !text-dore-clair">à votre service</span>
    </nav>
    <div class="flex flex-wrap items-center justify-center gap-4 pb-4">
      <a href={lienInscription} class="btn btn-creme">Rejoindre le programme pilote</a>
    </div>
  </div>
</dialog>

<style>
  .entete {
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      box-shadow 0.4s ease;
  }
  .entete[data-plein='true'] {
    background: var(--color-creme);
    color: var(--color-encre);
    box-shadow: 0 1px 0 var(--color-filet);
  }
  .menu-plein {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bordeaux);
    color: var(--color-creme);
  }
  .menu-plein::backdrop {
    background: rgb(42 34 32 / 0.6);
  }
  .menu-lien {
    font-family: var(--font-titre);
    font-weight: 800;
    font-size: clamp(1.9rem, 5vw, 3.4rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    line-height: 1.3;
    min-height: 2.75rem;
    transition: color 0.3s ease;
  }
  .menu-lien:hover,
  .menu-lien:focus-visible {
    color: var(--color-dore-clair);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu-plein[open] .menu-lien {
      animation: menu-entree 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--i) * 70ms + 80ms);
    }
    .menu-plein[open] {
      animation: menu-fondu 0.35s ease both;
    }
  }
  @keyframes menu-entree {
    from {
      opacity: 0;
      translate: 0 1.2rem;
    }
  }
  @keyframes menu-fondu {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const entete = document.querySelector<HTMLElement>('[data-entete]');
  if (entete) {
    const maj = () => (entete.dataset.plein = String(window.scrollY > 60));
    window.addEventListener('scroll', maj, { passive: true });
    maj();
  }

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const ouvrir = document.querySelector<HTMLButtonElement>('[data-menu-ouvrir]');
  if (menu && ouvrir) {
    ouvrir.addEventListener('click', () => menu.showModal());
    menu.querySelector('[data-menu-fermer]')?.addEventListener('click', () => menu.close());
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
  }
</script>
