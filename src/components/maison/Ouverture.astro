---
/**
 * Ouverture de l'accueil : vidéo plein cadre + titre.
 * Révélation orchestrée juste après l'intro bouteille (événement `cuvee:intro-fin` / classe `html.intro-vue`),
 * ou tout de suite au chargement quand l'intro n'est pas jouée : la vidéo passe d'un léger zoom à l'échelle
 * normale, le titre monte mot à mot, la signature s'écrit de gauche à droite, puis les boutons apparaissent.
 * Sans JavaScript ou en mouvement réduit, tout est visible d'emblée.
 */
import Video from './Video.astro';
import { lienInscription } from '../../data/site';
---
<section class="ouverture media-cadre voile sur-image relative flex min-h-[100svh] flex-col text-creme" aria-labelledby="hero-titre" data-ouverture>
  <Video src="/media/cave-lumiere.mp4" affiche="/media/cave-lumiere-poster.jpg" prioritaire />

  <div class="ouv-contenu relative z-10 flex flex-1 flex-col items-center justify-center px-5 pt-28 pb-24 text-center">
    <p class="ouv-h ouv-surtitre surtitre text-creme/85">Assistant de cave · bars à vin &amp; caves à manger</p>
    <h1 id="hero-titre" class="ouv-h ouv-titre mt-6 max-w-[72rem] text-[clamp(1.7rem,3.5vw,3.2rem)]">
      <span class="titre-a">Moins de bouteilles qui dorment, moins d’heures sur les commandes.</span>
      <span class="titre-b">Et si vos commandes aux domaines étaient prêtes dès le lundi matin&nbsp;?</span>
    </h1>
    <span class="signature ouv-h ouv-signature mt-5">Cuvée propose, vous décidez</span>
    <div class="ouv-h ouv-boutons mt-10 flex flex-wrap justify-center gap-4">
      <a href={lienInscription} class="btn btn-primaire" data-hero-cta>Rejoindre le programme pilote</a>
      <a href="#proposition" class="btn btn-voile">Voir un exemple</a>
    </div>
  </div>

  <div class="ouv-h ouv-bas relative z-10 flex items-end justify-between px-4 pb-6 sm:px-8 lg:px-12">
    <a href="#manifeste" class="lien-cap text-creme/85">Découvrir</a>
    <button type="button" class="lien-cap text-creme/85" data-video-bascule aria-pressed="false">
      <span data-video-libelle>Pause</span>
    </button>
  </div>
</section>

<style is:global>
  /* ------------------------------------------------------------------
     Effets partagés de l'accueil (utilisés par les autres sections)
       data-reveal="ecriture"  signature manuscrite qui s'écrit de gauche à droite
       data-reveal="filet"     filet doré horizontal qui se trace (« filet-v » : vertical)
     ------------------------------------------------------------------ */
  @media (prefers-reduced-motion: no-preference) {
    html.anim [data-reveal][data-reveal='ecriture'] {
      width: fit-content;
      opacity: 0;
      transform: none;
      transition: none;
    }
    html.anim [data-reveal][data-reveal='ecriture'].est-visible {
      opacity: 1;
      animation: ecriture-trace 2s cubic-bezier(0.5, 0.1, 0.3, 1) calc(var(--d, 0) * 90ms + 0.25s) backwards;
    }
    @keyframes ecriture-trace {
      from {
        clip-path: inset(-35% 101% -35% -8%);
      }
      to {
        clip-path: inset(-35% -8% -35% -8%);
      }
    }

    html.anim [data-reveal][data-reveal='filet'],
    html.anim [data-reveal][data-reveal='filet-v'] {
      opacity: 0;
      transform: none;
      transform-origin: left center;
      transition: none;
    }
    html.anim [data-reveal][data-reveal='filet-v'] {
      transform-origin: top center;
    }
    html.anim [data-reveal][data-reveal='filet'].est-visible,
    html.anim [data-reveal][data-reveal='filet-v'].est-visible {
      opacity: 1;
      animation: filet-trace 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--d, 0) * 90ms + 0.1s) backwards;
    }
    html.anim [data-reveal][data-reveal='filet-v'].est-visible {
      animation-name: filet-trace-v;
    }
    @keyframes filet-trace {
      from {
        transform: scaleX(0);
      }
    }
    @keyframes filet-trace-v {
      from {
        transform: scaleY(0);
      }
    }
  }

  /* ------------------------------------------------------------------
     Ouverture : séquence d'entrée
     ------------------------------------------------------------------ */
  .ouverture {
    /* début de la signature : après le dernier mot du titre */
    --sig: calc(0.6s + var(--n, 11) * 65ms + 0.5s);
  }

  /* la vidéo glisse un peu plus lentement que la page (navigateurs compatibles) */
  .ouverture > video {
    inset: -10svh 0 0 0;
    height: calc(100% + 10svh);
  }

  .ouv-m {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0.24em 0.04em 0.16em;
    margin: -0.24em -0.04em -0.16em;
  }
  .ouv-m > span {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* état de départ : tout est masqué jusqu'à la fin de l'intro */
    html.anim .ouverture:not([data-pret]) .ouv-h {
      opacity: 0;
    }
    html.anim .ouverture:not([data-pret]) > video {
      opacity: 0;
      scale: 1.16;
    }
    html.anim .ouverture > video {
      transition:
        scale 3.6s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 1.8s ease;
    }

    html.anim .ouverture[data-pret] .ouv-surtitre {
      animation: ouv-fondu 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s backwards;
    }
    html.anim .ouverture[data-pret] .ouv-m > span {
      animation: ouv-monte 1.15s cubic-bezier(0.16, 1, 0.3, 1) calc(0.6s + var(--i, 0) * 65ms) backwards;
    }
    html.anim .ouverture[data-pret] .ouv-signature {
      animation: ouv-ecrit 2.1s cubic-bezier(0.5, 0.1, 0.3, 1) var(--sig) backwards;
    }
    html.anim .ouverture[data-pret] .ouv-boutons > * {
      animation: ouv-fondu 1s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--sig) + 1.1s) backwards;
    }
    html.anim .ouverture[data-pret] .ouv-boutons > :nth-child(2) {
      animation-delay: calc(var(--sig) + 1.3s);
    }
    html.anim .ouverture[data-pret] .ouv-bas {
      animation: ouv-fondu 1.4s ease calc(var(--sig) + 1.9s) backwards;
    }

    @keyframes ouv-fondu {
      from {
        opacity: 0;
        translate: 0 0.9rem;
      }
    }
    @keyframes ouv-monte {
      from {
        transform: translateY(118%) rotate(3deg);
      }
    }
    @keyframes ouv-ecrit {
      from {
        clip-path: inset(-35% 101% -35% -8%);
      }
      to {
        clip-path: inset(-35% -8% -35% -8%);
      }
    }

    /* au défilement, le texte s'efface en douceur et la vidéo prend du retard */
    @supports (animation-timeline: scroll()) {
      .ouv-contenu {
        animation: ouv-sortie linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 75svh;
      }
      .ouverture > video {
        animation: ouv-defile linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 100svh;
      }
      @keyframes ouv-sortie {
        to {
          opacity: 0;
          translate: 0 5rem;
        }
      }
      @keyframes ouv-defile {
        to {
          translate: 0 9svh;
        }
      }
    }
  }
</style>

<script>
  /* bouton pause / lecture de la vidéo */
  const bouton = document.querySelector<HTMLButtonElement>('[data-video-bascule]');
  const video = bouton?.closest('section')?.querySelector<HTMLVideoElement>('video');
  const libelle = bouton?.querySelector<HTMLElement>('[data-video-libelle]');
  if (bouton && video && libelle) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) bouton.hidden = true;
    bouton.addEventListener('click', () => {
      if (video.paused) {
        delete video.dataset.pause;
        video.play().catch(() => {});
        libelle.textContent = 'Pause';
        bouton.setAttribute('aria-pressed', 'false');
      } else {
        video.dataset.pause = 'manuelle';
        video.pause();
        libelle.textContent = 'Lecture';
        bouton.setAttribute('aria-pressed', 'true');
      }
    });
  }

  /* séquence d'entrée : attend la fin de l'intro bouteille */
  const ouverture = document.querySelector<HTMLElement>('[data-ouverture]');
  if (ouverture) {
    const html = document.documentElement;
    const anime = html.classList.contains('anim');

    if (anime) {
      // le titre se découpe mot à mot (les espaces insécables restent soudés)
      let max = 0;
      ouverture.querySelectorAll<HTMLElement>('.titre-a, .titre-b').forEach((variante) => {
        const texte = variante.textContent ?? '';
        variante.textContent = '';
        let i = 0;
        for (const mot of texte.trim().split(/[ \t\n]+/)) {
          if (i) variante.append(' ');
          const masque = document.createElement('span');
          masque.className = 'ouv-m';
          const interieur = document.createElement('span');
          interieur.style.setProperty('--i', String(i++));
          interieur.textContent = mot;
          masque.append(interieur);
          variante.append(masque);
        }
        const visible = getComputedStyle(variante).display !== 'none';
        if (visible) max = i;
      });
      if (max) ouverture.style.setProperty('--n', String(max));
    }

    let lance = false;
    const go = () => {
      if (lance) return;
      lance = true;
      requestAnimationFrame(() => requestAnimationFrame(() => ouverture.setAttribute('data-pret', '')));
    };

    if (!anime || html.classList.contains('intro-vue')) go();
    else {
      document.addEventListener('cuvee:intro-fin', go, { once: true });
      // intro absente (ou pas encore branchée) : on révèle sans attendre
      window.setTimeout(() => {
        if (!html.classList.contains('intro-active') && !html.classList.contains('intro-vue')) go();
        else if (html.classList.contains('intro-vue')) go();
      }, 1200);
      window.setTimeout(go, 40000);
    }
  }
</script>
