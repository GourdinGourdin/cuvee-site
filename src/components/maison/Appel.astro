---
import Video from './Video.astro';
import { lienInscription } from '../../data/site';
---
<section class="appel grid bg-bordeaux text-creme lg:grid-cols-2" aria-labelledby="appel-titre" data-page-cta>
  <div class="media-cadre order-last min-h-[56vh] lg:order-first lg:min-h-[78vh]" data-reveal="rideau">
    <Video src="/media/casier-main.mp4" affiche="/media/casier-main-poster.jpg" sizes="(min-width: 1024px) 50vw, 100vw" />
  </div>
  <div class="appel-texte flex flex-col justify-center py-16 lg:py-24">
    <div class="filet-double mb-8 w-20" aria-hidden="true" data-reveal="filet"></div>
    <p class="surtitre" data-reveal>Programme pilote</p>
    <h2 id="appel-titre" class="mt-4 max-w-[14ch] text-balance" data-reveal-lignes>Prêt à essayer avec nous&nbsp;?</h2>
    <p class="texte-courant mt-6" data-reveal data-reveal-delai="2">
      Quelques lieux, quelques mois, et une équipe qui construit l’outil avec vous, pendant le service.
    </p>
    <span class="signature mt-4" data-reveal="ecriture">deux minutes, pas plus</span>
    <a href={lienInscription} class="btn btn-creme mt-8 self-start" data-reveal data-reveal-delai="3">Rejoindre le programme pilote</a>
  </div>
</section>

<style>
  /* le texte s'aligne sur la grille du site : bord gauche du .conteneur côté mobile, marge intérieure en desktop */
  .appel-texte {
    padding-inline: var(--marge);
  }
  @media (min-width: 64rem) {
    .appel-texte {
      padding-inline: var(--space-9) max(var(--marge), calc((100vw - 75rem) / 2 + var(--marge)));
      padding-left: var(--space-9);
    }
  }
</style>
