---
/**
 * Vidéo d'ambiance muette, en boucle. Chargée et lancée seulement quand elle entre à l'écran,
 * mise en pause quand elle en sort. Avec « réduire les animations », seule l'affiche est montrée.
 * `prioritaire` : vidéo du haut de page, démarrée tout de suite ; son affiche est alors l'attribut `poster` (WebP 1600 px).
 * `sizes` : largeur d'affichage de l'affiche des vidéos non prioritaires (défaut 100vw).
 * Les affiches passent par les variantes optimisées de public/media/opt/ (voir Photo.astro).
 */
import Photo from '../Photo.astro';
import { medias } from '../../data/medias';

interface Props {
  src: string;
  affiche: string;
  prioritaire?: boolean;
  class?: string;
  sizes?: string;
}
const { src, affiche, prioritaire = false, class: classe = '', sizes = '100vw' } = Astro.props;

// L'attribut poster n'accepte qu'une URL : on prend la variante WebP la plus proche de 1600 px.
const nomAffiche = /^\/media\/([^/]+)\.jpg$/i.exec(affiche)?.[1];
const infos = nomAffiche ? medias[nomAffiche] : undefined;
const largeurPoster = infos ? (infos.variantes.filter((w) => w <= 1600).pop() ?? infos.variantes[0]) : 0;
const poster = infos ? `/media/opt/${nomAffiche}-${largeurPoster}.webp` : affiche;
---
{
  /* Vidéo non prioritaire : l'affiche est une image chargée paresseusement (l'attribut poster, lui, se télécharge
     toujours tout de suite). Elle reste visible sans JavaScript ou en mouvement réduit, la vidéo la recouvre ensuite. */
  !prioritaire && <Photo src={affiche} alt="" sizes={sizes} class={classe} />
}
<video
  class={classe}
  muted
  loop
  playsinline
  preload="none"
  poster={prioritaire ? poster : undefined}
  aria-hidden="true"
  data-video
  data-src={src}
  data-prioritaire={prioritaire ? '' : undefined}
></video>

<script>
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-video]');

  const charger = (v: HTMLVideoElement) => {
    if (!v.src && v.dataset.src) v.src = v.dataset.src;
  };

  if (!reduit) {
    const obs =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entrees) => {
              for (const e of entrees) {
                const v = e.target as HTMLVideoElement;
                if (v.dataset.pause === 'manuelle') continue;
                if (e.isIntersecting) {
                  charger(v);
                  v.play().catch(() => {});
                } else {
                  v.pause();
                }
              }
            },
            { rootMargin: '200px 0px' },
          )
        : null;

    videos.forEach((v) => {
      if (v.hasAttribute('data-prioritaire')) {
        charger(v);
        v.play().catch(() => {});
      }
      if (obs) obs.observe(v);
      else {
        charger(v);
        v.play().catch(() => {});
      }
    });
  }
</script>
