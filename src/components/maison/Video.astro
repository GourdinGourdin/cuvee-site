---
/**
 * Vidéo d'ambiance muette, en boucle. Chargée et lancée seulement quand elle entre à l'écran,
 * mise en pause quand elle en sort. Avec « réduire les animations », seule l'affiche est montrée.
 * `prioritaire` : vidéo du haut de page, chargée tout de suite.
 */
interface Props {
  src: string;
  affiche: string;
  prioritaire?: boolean;
  class?: string;
}
const { src, affiche, prioritaire = false, class: classe = '' } = Astro.props;
---
<video
  class={classe}
  muted
  loop
  playsinline
  preload={prioritaire ? 'auto' : 'none'}
  poster={affiche}
  aria-hidden="true"
  data-video
  data-src={src}
  data-prioritaire={prioritaire ? '' : undefined}
></video>

<script>
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-video]');

  const charger = (v: HTMLVideoElement) => {
    if (!v.src && v.dataset.src) v.src = v.dataset.src;
  };

  if (!reduit) {
    const obs =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entrees) => {
              for (const e of entrees) {
                const v = e.target as HTMLVideoElement;
                if (v.dataset.pause === 'manuelle') continue;
                if (e.isIntersecting) {
                  charger(v);
                  v.play().catch(() => {});
                } else {
                  v.pause();
                }
              }
            },
            { rootMargin: '200px 0px' },
          )
        : null;

    videos.forEach((v) => {
      if (v.hasAttribute('data-prioritaire')) {
        charger(v);
        v.play().catch(() => {});
      }
      if (obs) obs.observe(v);
      else {
        charger(v);
        v.play().catch(() => {});
      }
    });
  }
</script>
