---
import BonDeCommande from '../BonDeCommande.astro';
import Photo from '../Photo.astro';

const etapes = ['Vos ventes, lues depuis la caisse', 'Vos entrées, lues sur les factures', 'Votre feu vert, toujours'];
---
<section id="proposition" class="section bg-creme" aria-labelledby="proposition-titre">
  <div class="conteneur grid items-center gap-12 lg:grid-cols-2 lg:gap-x-16 xl:gap-x-24">
    <div>
      <p class="surtitre" data-reveal>Un exemple, lundi à 7 h 02</p>
      <h2 id="proposition-titre" class="mt-4 text-encre" data-reveal-lignes>La commande est prête avant vous</h2>
      <p class="texte-courant mt-6" data-reveal data-reveal-delai="2">
        Cuvée compare ce qui sort et ce qui reste, voit venir la rupture et prépare le bon pour le domaine,{' '}
        <strong class="font-semibold text-encre">franco compris</strong>. Vous ajustez une quantité, vous validez, il part par
        email ou WhatsApp.
      </p>
      <ol class="mt-8 max-w-xl" role="list">
        {
          etapes.map((e, i) => (
            <li class="flex items-baseline gap-4 border-b border-dore/50 py-3 text-encre-douce first:border-t" data-reveal data-reveal-delai={String(i + 3)}>
              <span class="chiffres w-6 shrink-0 font-extrabold text-bordeaux">{String(i + 1).padStart(2, '0')}</span>
              {e}
            </li>
          ))
        }
      </ol>
      <a href="/comment-ca-marche" class="lien-cap mt-6" data-reveal data-reveal-delai="6">Voir le fonctionnement</a>
    </div>

    <!-- le bon de commande est posé sur la photo : le cadre rogne tout (rotation, feuille du dessous) -->
    <div class="proposition-media media-cadre zoom-lent flex items-center justify-center px-3 py-8 sm:px-12 sm:py-14 lg:order-first lg:px-10 lg:py-14" data-reveal="rideau">
      <Photo src="/media/mur-bouteilles.jpg" alt="" sizes="(min-width: 1024px) 50vw, 100vw" data-parallaxe="-0.08" class="proposition-photo" />
      <div class="absolute inset-0 bg-chai/45" aria-hidden="true"></div>
      <div class="relative z-10 w-full max-w-md">
        <BonDeCommande />
      </div>
    </div>
  </div>
</section>

<style>
  /* l'image dépasse du cadre pour que la parallaxe ne laisse jamais de bord vide */
  .proposition-media :global(.proposition-photo) {
    inset: -10% 0 auto 0;
    height: 120%;
  }
</style>
