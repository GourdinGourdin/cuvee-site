---
/**
 * Pied de page de toutes les pages : emblème et signature, navigation, contact, mentions.
 * La mention santé est obligatoire et doit rester lisible.
 */
import Logo from '../Logo.astro';
import ACompleter from '../ACompleter.astro';
import { site, navigation, lienInscription } from '../../data/site';

const annee = new Date().getFullYear();
const chemin = Astro.url.pathname.replace(/\/+$/, '') || '/';
const actif = (href: string) => (href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(href + '/'));
---
<footer class="pied sur-fond-sombre bg-chai text-creme" aria-label="Pied de page">
  <div class="conteneur pied-interieur">
    <div class="pied-grille">
      <div class="pied-marque">
        <a href="/" class="pied-logo" aria-label="Cuvée, retour à l’accueil">
          <Logo variante="pile" taille={44} clair />
        </a>
        <span class="signature pied-signature">assistant de cave</span>
        <p class="texte-courant">Cuvée est en construction, avec des lieux indépendants.</p>
      </div>

      <nav aria-label="Pied de page" class="pied-colonne" id="pied-nav">
        <p class="surtitre">Explorer</p>
        <ul role="list">
          {
            navigation.map((n) => (
              <li>
                <a href={n.href} class="pied-nav" aria-current={actif(n.href) ? 'page' : undefined}>{n.libelle}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="pied-colonne">
        <p class="surtitre">Nous écrire</p>
        <p class="texte-courant pied-contact">
          {site.emailContact ? <a href={`mailto:${site.emailContact}`} class="lien">{site.emailContact}</a> : <ACompleter texte="email de contact" />}
        </p>
        <a href={lienInscription} class="btn btn-creme pied-btn">Rejoindre le programme pilote</a>
      </div>
    </div>

    <div class="filet-double pied-filet" aria-hidden="true"></div>

    <div class="pied-bas petit">
      <p class="pied-legal">
        <span>© {annee} Cuvée</span>
        <a href="/mentions-legales/" class="lien">Mentions légales</a>
        <a href="/confidentialite/" class="lien">Confidentialité</a>
      </p>
      <p class="pied-credits">Photos et vidéos : Pexels (licence libre), à remplacer par nos propres prises de vue.</p>
      <p class="pied-sante">L’abus d’alcool est dangereux pour la santé, à consommer avec modération.</p>
    </div>
  </div>
</footer>

<style>
  .pied-interieur {
    padding-top: clamp(4rem, 3rem + 4vw, 6rem);
    padding-bottom: max(var(--space-6), env(safe-area-inset-bottom));
  }
  .pied-grille {
    display: grid;
    gap: var(--space-7);
    text-align: center;
  }
  @media (min-width: 64rem) {
    .pied-grille {
      grid-template-columns: 1fr 0.8fr 1.25fr;
      gap: var(--space-8);
      text-align: left;
    }
  }
  .pied-marque,
  .pied-colonne {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .pied-marque,
    .pied-colonne {
      align-items: flex-start;
    }
  }
  .pied-logo {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
  }
  .pied-signature {
    margin-top: var(--space-4);
    font-size: 2.25rem;
  }
  .pied-marque .texte-courant {
    margin-top: var(--space-4);
    max-width: 22rem;
  }
  .pied-colonne ul {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: inherit;
  }
  .pied-contact {
    margin-top: var(--space-3);
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  .pied-btn {
    margin-top: var(--space-4);
    max-width: 100%;
  }
  @media (max-width: 30rem) {
    .pied-btn {
      width: 100%;
      padding-inline: var(--space-3);
      letter-spacing: 0.1em;
    }
  }
  .pied-filet {
    margin-top: var(--space-8);
    opacity: 0.5;
  }
  .pied-bas {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    text-align: center;
    color: var(--creme-85);
  }
  /* zone tactile de 44 px sans éloigner le souligné du texte */
  .pied-legal .lien {
    position: relative;
  }
  .pied-legal .lien::after {
    content: '';
    position: absolute;
    inset: -0.75rem -0.25rem;
  }
  .pied-legal {
    display: flex;
    row-gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: var(--space-5);
  }
  .pied-sante {
    font-size: 0.9375rem;
  }
  @media (min-width: 64rem) {
    .pied-bas {
      grid-template-columns: 1fr auto;
      justify-items: start;
      text-align: left;
      align-items: center;
    }
    .pied-legal {
      justify-content: flex-start;
    }
    .pied-credits {
      text-align: right;
      justify-self: end;
    }
    .pied-sante {
      grid-column: 1 / -1;
    }
  }

  .pied-nav {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-label);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--creme-85);
    transition:
      color var(--duree-2) ease,
      translate var(--duree-3) var(--ease-sortie);
  }
  .pied-nav::before {
    content: '';
    width: 0;
    height: 1px;
    margin-right: 0;
    background: var(--color-dore);
    transition:
      width var(--duree-3) var(--ease-sortie),
      margin-right var(--duree-3) var(--ease-sortie);
  }
  .pied-nav:hover,
  .pied-nav:focus-visible,
  .pied-nav[aria-current='page'] {
    color: var(--color-creme);
  }
  .pied-nav:hover::before,
  .pied-nav:focus-visible::before,
  .pied-nav[aria-current='page']::before {
    width: 1.25rem;
    margin-right: 0.7rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .pied-nav,
    .pied-nav::before {
      transition: none;
    }
  }
</style>
