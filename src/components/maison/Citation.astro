---
interface Props {
  image: string;
  alt?: string;
}
const { image, alt = '' } = Astro.props;
---
<section class="media-cadre voile sur-image zoom-lent relative flex min-h-[90vh] items-center justify-center px-4 py-32 text-center text-creme" data-reveal>
  <img src={image} alt={alt} loading="lazy" decoding="async" />
  <figure class="relative z-10 mx-auto max-w-4xl">
    <blockquote>
      <p class="font-[family-name:var(--font-titre)] text-[clamp(1.5rem,3.4vw,2.8rem)] leading-[1.25] font-extrabold tracking-[0.05em] uppercase">
        Votre métier, c’est de choisir les vins et de les faire découvrir, pas de compter des cartons.
      </p>
    </blockquote>
    <figcaption class="signature mt-6">le suivi, Cuvée veut s’en charger</figcaption>
  </figure>
</section>
