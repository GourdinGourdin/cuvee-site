---
const pistes = [
  { titre: 'Comment ça marche', texte: 'De la facture au bon de commande', href: '/comment-ca-marche', image: 'vitrine-cave', slug: 'comment-ca-marche' },
  { titre: 'Le programme pilote', texte: 'Ce que nous proposons, ce que nous demandons', href: '/pilote', image: 'assiette-ardoise', slug: 'pilote' },
  { titre: 'Équipe & questions', texte: 'Qui construit Cuvée, et pourquoi', href: '/equipe', image: 'comptoir-soir', slug: 'equipe' },
];
---
<section class="px-4 py-24 lg:py-32" aria-labelledby="pistes-titre">
  <div class="mx-auto max-w-[76rem]">
    <div class="text-center">
      <p class="surtitre text-encre-douce" data-reveal>La suite</p>
      <h2 id="pistes-titre" class="mt-4 text-[clamp(1.7rem,3vw,2.6rem)] text-bordeaux" data-reveal-lignes>Pour aller plus loin</h2>
      <span class="signature mx-auto mt-1" data-reveal="ecriture" style="--d: 7">prenez le temps</span>
    </div>
    <ul class="mt-14 grid gap-5 md:grid-cols-3" role="list">
      {
        pistes.map((p, i) => (
          <li>
            <a href={p.href} class="piste media-cadre voile sur-image group flex aspect-[3/4] items-end p-7 text-creme no-underline" data-reveal="rideau" data-reveal-delai={String(i + 1)}>
              <img src={`/media/${p.image}.jpg`} alt="" loading="lazy" decoding="async" style={`view-transition-name: media-${p.slug}`} />
              <span class="relative z-10 flex w-full flex-col items-center gap-3 text-center">
                <span class="font-[family-name:var(--font-titre)] text-2xl font-extrabold tracking-[0.06em] uppercase">{p.titre}</span>
                <span class="text-[1rem] text-creme/85">{p.texte}</span>
                <span class="lien-cap">Découvrir</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* voile renforcé en bas de carte : le texte reste lisible sur les photos claires */
  .piste::after {
    background: linear-gradient(180deg, rgb(42 34 32 / 0.18) 0%, rgb(42 34 32 / 0.05) 25%, rgb(42 34 32 / 0.6) 55%, rgb(42 34 32 / 0.88) 100%);
  }
  .piste img {
    transition: scale 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .piste:hover img {
      scale: 1.06;
    }
  }
</style>
