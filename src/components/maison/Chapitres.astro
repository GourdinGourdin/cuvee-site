---
/** Les trois situations que Cuvée veut régler, en chapitres : une vidéo, un texte, en alternance. */
import Video from './Video.astro';

const chapitres = [
  {
    num: 'I',
    quand: 'Lundi, 9 h',
    titre: 'La matinée des commandes',
    texte:
      'Le tableur d’un côté, les factures de la semaine de l’autre. On recompte, on devine ce qui va partir, on écrit à six domaines. À midi, ce n’est pas fini.',
    cuvee: 'Notre objectif : que les bons soient prêts avant votre arrivée. Vous n’avez plus qu’à relire.',
    video: 'carnet',
  },
  {
    num: 'II',
    quand: 'Vendredi, 21 h',
    titre: 'La rupture qu’on n’a pas vue venir',
    texte:
      'Le blanc qui part le mieux au verre est terminé. Personne n’avait vu le stock baisser, et la prochaine livraison n’arrive que mardi.',
    cuvee: 'Notre objectif : voir venir la rupture et vous prévenir à temps pour commander.',
    video: 'comptoir-verres',
  },
  {
    num: 'III',
    quand: 'Au fond de la réserve',
    titre: 'Les cartons qui prennent la poussière',
    texte:
      'Des bouteilles achetées sur un coup de cœur il y a un an. Personne ne pense à les proposer. C’est de l’argent qui dort.',
    cuvee: 'Notre objectif : repérer ce qui ne tourne plus et vous suggérer comment l’écouler.',
    video: 'reserve-cartons',
  },
];
---
<section aria-labelledby="chapitres-titre" class="section-serree bg-creme">
  <h2 id="chapitres-titre" class="sr-only">Trois situations que nous voulons régler</h2>
  <div class="conteneur grid gap-16 lg:gap-24">
    {
      chapitres.map((c, i) => (
        <article class="grid items-center gap-8 lg:grid-cols-2 lg:gap-x-16 xl:gap-x-24">
          <div class:list={['media-cadre aspect-[4/3] sm:aspect-[16/10] lg:aspect-[5/4]', i % 2 === 1 && 'lg:order-2']} data-reveal="rideau">
            <Video src={`/media/${c.video}.mp4`} affiche={`/media/${c.video}-poster.jpg`} sizes="(min-width: 1024px) 50vw, 100vw" />
          </div>
          <div class="max-w-xl">
            <p class="surtitre" data-reveal>
              Chapitre {c.num} · {c.quand}
            </p>
            <h3 class="mt-4 text-encre" data-reveal data-reveal-delai="1">
              {c.titre}
            </h3>
            <p class="texte-courant mt-4" data-reveal data-reveal-delai="2">
              {c.texte}
            </p>
            <p class="mt-6 border-l-2 border-dore pl-5 font-semibold text-encre" data-reveal data-reveal-delai="3">
              {c.cuvee}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>
