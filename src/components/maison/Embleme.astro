---
/**
 * Emblème Cuvée : une bouteille de type bordelaise, capsule dorée, étiquette au « C »,
 * sous une voûte de cave en arc fin. Grille 40 × 64 ; la couleur suit `currentColor`
 * (bordeaux sur fond clair, crème sur fond sombre) ; seule la capsule reste dorée.
 * Charte : docs/logo.md
 */
interface Props {
  taille?: number;
  class?: string;
}
const { taille = 18, class: classe = '' } = Astro.props;
---
<svg
  width={taille}
  height={Math.round(taille * 1.6)}
  viewBox="0 0 40 64"
  aria-hidden="true"
  focusable="false"
  class:list={['embleme', classe]}
>
  <path d="M3 62V23A17 17 0 0 1 37 23V62" fill="none" stroke="currentColor" stroke-width="1.2" />
  <path d="M6.5 62V23.5A13.5 13.5 0 0 1 33.5 23.5V62" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.55" />
  <g>
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M18.4 15h3.2v10c0 4 4.4 4.6 4.4 10.5V57q0 2-2 2h-8q-2 0-2-2V35.5c0-5.9 4.4-6.5 4.4-10.5zM14.9 40h10.2v11.5H14.9z"
    />
    <path d="M20 43.1a2.3 2.3 0 1 0 0 4.6M16.9 49.3h6.2" fill="none" stroke="currentColor" stroke-width="0.8" />
    <path d="M17.6 13.4h4.8v2h-.5v6.2h-3.8v-6.2h-.5z" fill="#a88a4a" />
  </g>
  <path d="M1 62h38" stroke="currentColor" stroke-width="1.2" />
</svg>
<style>
  .embleme {
    flex-shrink: 0;
    overflow: visible;
  }
</style>
