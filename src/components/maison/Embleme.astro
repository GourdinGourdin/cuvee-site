---
/**
 * Emblème Cuvée : une bouteille de type bordelaise, capsule dorée, étiquette au « C »,
 * sous une voûte de cave en arc fin. Grille 40 × 64 ; la couleur suit `currentColor`
 * (bordeaux sur fond clair, crème sur fond sombre) ; seule la capsule reste dorée.
 * `anime` : l'arc se trace puis la bouteille apparaît (sans effet si le mouvement est réduit).
 * Charte : docs/logo.md
 */
interface Props {
  taille?: number;
  class?: string;
  anime?: boolean;
}
const { taille = 18, class: classe = '', anime = false } = Astro.props;
---
<svg
  width={taille}
  height={Math.round(taille * 1.6)}
  viewBox="0 0 40 64"
  aria-hidden="true"
  focusable="false"
  class:list={['embleme', anime && 'embleme-anime', classe]}
>
  <path class="e-arc" d="M3 62V23A17 17 0 0 1 37 23V62" pathLength="1" fill="none" stroke="currentColor" stroke-width="1.2" />
  <path class="e-arc e-arc2" d="M6.5 62V23.5A13.5 13.5 0 0 1 33.5 23.5V62" pathLength="1" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.55" />
  <g class="e-bouteille">
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M18.4 15h3.2v10c0 4 4.4 4.6 4.4 10.5V57q0 2-2 2h-8q-2 0-2-2V35.5c0-5.9 4.4-6.5 4.4-10.5zM14.9 40h10.2v11.5H14.9z"
    />
    <path d="M20 43.1a2.3 2.3 0 1 0 0 4.6M16.9 49.3h6.2" fill="none" stroke="currentColor" stroke-width="0.8" />
    <path class="e-capsule" d="M17.6 13.4h4.8v2h-.5v6.2h-3.8v-6.2h-.5z" fill="#a88a4a" />
  </g>
  <path class="e-sol" d="M1 62h38" stroke="currentColor" stroke-width="1.2" />
</svg>
<style>
  .embleme {
    flex-shrink: 0;
    overflow: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    .embleme-anime .e-arc {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: e-trace 1.4s cubic-bezier(0.5, 0, 0.2, 1) 0.1s forwards;
    }
    .embleme-anime .e-arc2 {
      animation-delay: 0.35s;
    }
    .embleme-anime .e-sol {
      transform-origin: 50% 50%;
      animation: e-fondu 0.8s ease-out 0.1s both;
    }
    .embleme-anime .e-bouteille {
      animation: e-monte 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.9s both;
    }
    .embleme-anime .e-capsule {
      animation: e-fondu 0.7s ease-out 1.7s both;
    }
  }
  @keyframes e-trace {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes e-fondu {
    from {
      opacity: 0;
    }
  }
  @keyframes e-monte {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
  }
</style>
