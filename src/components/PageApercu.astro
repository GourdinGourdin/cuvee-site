---
/** Aperçu de l’accueil : trois cartes vers les autres pages. */
const cartes = [
  {
    n: 'I',
    titre: 'Comment ça marche',
    texte: 'De la facture reçue au bon de commande prêt à valider : le parcours, des exemples et ce que vous gardez en main.',
    href: '/comment-ca-marche',
    lien: 'Voir le fonctionnement',
  },
  {
    n: 'II',
    titre: 'Le programme pilote',
    texte: 'Ce que nous proposons aux premiers lieux, ce que nous attendons d’eux, et l’inscription.',
    href: '/pilote',
    lien: 'Découvrir le pilote',
  },
  {
    n: 'III',
    titre: 'Équipe et questions',
    texte: 'Qui construit Cuvée et pourquoi, puis les réponses aux questions que l’on nous pose avant de s’inscrire.',
    href: '/equipe',
    lien: 'Rencontrer l’équipe',
  },
];
---
<section aria-labelledby="apercu-titre" class="py-20 lg:py-28">
  <div class="conteneur">
    <div class="max-w-3xl" data-reveal>
      <p class="surtitre flex items-center gap-3 text-bordeaux">
        <span>N° 3</span><span class="h-px w-8 bg-dore" aria-hidden="true"></span><span>La suite</span>
      </p>
      <h2 id="apercu-titre" class="mt-4 text-[2rem] leading-[1.1] font-medium tracking-[-0.015em] sm:text-[2.6rem] lg:text-5xl">
        Pour aller plus loin.
      </h2>
    </div>
    <ul role="list" class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        cartes.map((c, i) => (
          <li class="flex" data-reveal data-reveal-delai={String(i)}>
            <a
              href={c.href}
              class="group papier flex w-full flex-col p-6 text-encre transition-transform duration-300 hover:-translate-y-1 sm:p-8"
            >
              <span class="chiffres text-sm text-dore">{c.n}</span>
              <h3 class="mt-3 text-2xl leading-snug font-medium">{c.titre}</h3>
              <p class="mt-3 flex-1 text-encre-douce">{c.texte}</p>
              <span class="mt-6 font-semibold text-bordeaux">
                {c.lien} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
