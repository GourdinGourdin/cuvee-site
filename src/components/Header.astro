---
import Logo from './Logo.astro';
import { navigation, lienInscription } from '../data/site';

interface Props {
  simple?: boolean;
}
const { simple = false } = Astro.props;
const chemin = Astro.url.pathname.replace(/\/+$/, '') || '/';
const actif = (href: string) => (href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(href + '/'));
const romain = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---
<header class="entete-site" data-entete>
  <div class="entete-fond" aria-hidden="true"></div>
  <div class="conteneur entete-barre">
    <a href="/" class="relative z-10 inline-flex min-h-11 items-center rounded-sm" aria-label="Cuvée, retour à l’accueil" data-menu-focus>
      <Logo />
    </a>

    {
      simple ? (
        <a href="/" class="lien lien-seul text-[0.975rem]">
          Retour à l’accueil
        </a>
      ) : (
        <>
          <nav aria-label="Navigation principale" class="hidden lg:block" data-nav-desktop>
            <ul role="list" class="nav-liste flex items-center gap-8 text-[0.975rem]">
              {navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="onglet inline-block py-2 text-encre-douce transition-colors hover:text-bordeaux aria-[current=page]:font-semibold aria-[current=page]:text-bordeaux"
                    aria-current={actif(item.href) ? 'page' : undefined}
                  >
                    {item.libelle}
                  </a>
                </li>
              ))}
              <li class="nav-indicateur" aria-hidden="true" data-indicateur></li>
            </ul>
          </nav>

          <div class="relative z-10 flex items-center gap-2">
            <details class="menu-mobile lg:hidden" data-menu>
              <summary class="btn btn-contour btn-petit list-none [&::-webkit-details-marker]:hidden" data-menu-focus>
                <span class="menu-libelle-ouvrir">Menu</span>
                <span class="menu-libelle-fermer">Fermer</span>
              </summary>
              <nav aria-label="Navigation principale" class="menu-panneau">
                <div class="menu-interieur conteneur">
                  <p class="surtitre text-bordeaux menu-surtitre">Sommaire</p>
                  <ol role="list" class="menu-liste">
                    {navigation.map((item, i) => (
                      <li style={`--i:${i}`}>
                        <a href={item.href} aria-current={actif(item.href) ? 'page' : undefined} data-menu-lien data-menu-focus>
                          <span class="menu-num" aria-hidden="true">{romain[i]}</span>
                          <span class="menu-titre">{item.libelle}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                  <a href={lienInscription} class="btn btn-primaire menu-cta" data-menu-lien data-menu-focus>
                    Rejoindre le programme pilote
                  </a>
                  <p class="menu-note">Cuvée est en construction, avec des lieux indépendants.</p>
                </div>
              </nav>
            </details>
            <a href={lienInscription} class="btn btn-primaire btn-petit" data-menu-focus>
              <span class="sm:hidden">Le pilote</span>
              <span class="hidden sm:inline">Rejoindre le pilote</span>
            </a>
          </div>
        </>
      )
    }
  </div>
  <div class="entete-filet" aria-hidden="true"></div>
</header>
