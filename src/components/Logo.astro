---
interface Props {
  clair?: boolean;
  class?: string;
}
const { clair = false, class: classe = '' } = Astro.props;
const trait = clair ? '#f5efe3' : '#6e1f2f';
const vin = clair ? '#8c2c40' : '#6e1f2f';
const corps =
  'M10.2 5H13.8V14C13.8 18.2 18.6 19.6 18.6 26.5V43.2Q18.6 45.4 16.4 45.4H7.6Q5.4 45.4 5.4 43.2V26.5C5.4 19.6 10.2 18.2 10.2 14Z';
const id = clair ? 'cc-clair' : 'cc-fonce';
---
<span class:list={['logo-cuvee inline-flex items-center gap-2.5', classe]}>
  <svg width="22" height="44" viewBox="0 0 24 48" aria-hidden="true" class="logo-bouteille shrink-0 overflow-visible">
    <defs>
      <clipPath id={id}><path d={corps} /></clipPath>
    </defs>
    <g clip-path={`url(#${id})`}>
      <rect class="logo-vin" x="0" y="22" width="24" height="26" fill={vin} />
    </g>
    <path class="logo-contour" d={corps} pathLength="1" fill="none" stroke={trait} stroke-width="1.5" stroke-linejoin="round" />
    <rect x="9.4" y="1.6" width="5.2" height="7" rx="1" fill="#a88a4a" />
    <rect x="8.6" y="7.6" width="6.8" height="1.3" fill="#a88a4a" />
    <rect x="7.4" y="28" width="9.2" height="11.6" rx="0.6" fill="#f5efe3" stroke="#a88a4a" stroke-width="0.5" />
    <text
      x="12"
      y="37"
      text-anchor="middle"
      font-family="Fraunces Variable, Georgia, serif"
      font-size="10.5"
      font-style="italic"
      font-weight="600"
      fill="#6e1f2f">C</text
    >
  </svg>
  <span class:list={['font-serif text-[1.6rem] leading-none font-semibold tracking-tight', clair ? 'text-creme' : 'text-encre']}
    >Cuvée</span
  >
</span>
<style>
  .logo-bouteille { transform-origin: 50% 100%; transition: transform 0.5s ease; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .logo-cuvee:hover .logo-bouteille { transform: rotate(-4deg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo-contour { stroke-dasharray: 1; stroke-dashoffset: 1; animation: logo-trace 1.1s ease-out 0.15s forwards; }
    .logo-vin { transform: translateY(26px); animation: logo-monte 1.4s cubic-bezier(0.22, 0.7, 0.2, 1) 0.9s forwards; }
  }
  @keyframes logo-trace { to { stroke-dashoffset: 0; } }
  @keyframes logo-monte { to { transform: translateY(0); } }
</style>
