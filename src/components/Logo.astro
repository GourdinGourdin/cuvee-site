---
/**
 * Logotype Cuvée : emblème + mot CUVÉE en Outfit, capitales espacées.
 * `ligne` : emblème à gauche du mot (en-tête). `pile` : emblème au-dessus du mot (pied de page, couverture).
 * `clair` : à utiliser sur fond sombre (chai, bordeaux, image voilée) : tout passe en crème.
 * Sur fond clair : bordeaux. Charte : docs/logo.md
 */
import Embleme from './maison/Embleme.astro';
interface Props {
  variante?: 'ligne' | 'pile';
  clair?: boolean;
  class?: string;
}
const { variante = 'ligne', clair = false, class: classe = '' } = Astro.props;
const pile = variante === 'pile';
---
<span
  class:list={[
    'logo-cuvee inline-flex items-center',
    pile ? 'flex-col gap-3' : 'gap-3.5',
    clair ? 'text-creme' : 'text-bordeaux',
    classe,
  ]}
>
  <Embleme taille={pile ? 38 : 26} />
  <span
    class:list={[
      'logo-mot font-[family-name:var(--font-titre)] leading-none font-extrabold tracking-[0.32em]',
      pile ? 'text-[1.5rem]' : 'text-[1.25rem]',
      '[margin-right:-0.32em]',
    ]}>CUVÉE</span
  >
</span>
