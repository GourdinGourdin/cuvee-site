---
import { site } from '../data/site';

// TODO : renseigner PUBLIC_FORM_ENDPOINT (voir .env.example et README).
// Sans endpoint : succès simulé en local uniquement, message d’erreur en production.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const contact = site.emailContact;

const types = [
  { valeur: 'cave-a-manger', libelle: 'Cave à manger' },
  { valeur: 'bar-a-vin', libelle: 'Bar à vin' },
  { valeur: 'restaurant', libelle: 'Restaurant avec une carte des vins' },
  { valeur: 'caviste', libelle: 'Caviste (vente à emporter)' },
  { valeur: 'autre', libelle: 'Autre' },
];

const references = ['Moins de 100', '100 à 250', '250 à 400', '400 à 600', 'Plus de 600', 'Je ne sais pas'];

const caisses = [
  { valeur: 'lightspeed', libelle: 'Lightspeed' },
  { valeur: 'zelty', libelle: 'Zelty' },
  { valeur: 'laddition', libelle: "L’Addition" },
  { valeur: 'tiller', libelle: 'Tiller' },
  { valeur: 'autre', libelle: 'Un autre logiciel' },
  { valeur: 'aucune', libelle: 'Pas de logiciel de caisse / je ne sais pas' },
];
---
<div id="inscription" class="papier self-start p-5 text-encre sm:p-8" data-contact={contact}>
  <div data-form-zone>
    <h3 class="font-serif text-[1.75rem] leading-tight font-medium">Rejoindre le programme pilote</h3>
    <p class="mt-2 text-encre-douce">
      Deux minutes. Nous vous recontactons pour un premier échange, sans engagement.
    </p>
    <p class="mt-1 text-[0.875rem] text-encre-douce">Tous les champs sont obligatoires, sauf mention « facultatif ».</p>

    <form
      class="mt-7 grid gap-5 sm:grid-cols-2"
      method="POST"
      action={endpoint || undefined}
      novalidate
      data-inscription
    >
      <div>
        <label for="f-nom" class="etiquette-champ">Prénom et nom</label>
        <input id="f-nom" name="nom" type="text" autocomplete="name" required class="champ"
          aria-describedby="f-nom-erreur" data-erreur="Indiquez votre prénom et votre nom." />
        <p id="f-nom-erreur" class="message-erreur"></p>
      </div>

      <div>
        <label for="f-lieu" class="etiquette-champ">Nom de votre lieu</label>
        <input id="f-lieu" name="lieu" type="text" autocomplete="organization" required class="champ"
          aria-describedby="f-lieu-erreur" data-erreur="Indiquez le nom de votre établissement." />
        <p id="f-lieu-erreur" class="message-erreur"></p>
      </div>

      <div>
        <label for="f-type" class="etiquette-champ">Type d’établissement</label>
        <select id="f-type" name="type_etablissement" required class="champ"
          aria-describedby="f-type-erreur" data-erreur="Choisissez le type d’établissement.">
          <option value="">Choisir…</option>
          {types.map((t) => <option value={t.valeur}>{t.libelle}</option>)}
        </select>
        <p id="f-type-erreur" class="message-erreur"></p>
      </div>

      <div>
        <label for="f-ville" class="etiquette-champ">Ville</label>
        <input id="f-ville" name="ville" type="text" autocomplete="address-level2" required class="champ"
          aria-describedby="f-ville-erreur" data-erreur="Indiquez votre ville." />
        <p id="f-ville-erreur" class="message-erreur"></p>
      </div>

      <div>
        <label for="f-references" class="etiquette-champ">Nombre de références, environ</label>
        <select id="f-references" name="references" required class="champ"
          aria-describedby="f-references-erreur" data-erreur="Choisissez une fourchette, même approximative.">
          <option value="">Choisir…</option>
          {references.map((r) => <option value={r}>{r}</option>)}
        </select>
        <p id="f-references-erreur" class="message-erreur"></p>
      </div>

      <div>
        <label for="f-caisse" class="etiquette-champ">Logiciel de caisse</label>
        <select id="f-caisse" name="caisse" required class="champ"
          aria-describedby="f-caisse-erreur" data-erreur="Choisissez votre logiciel de caisse." data-caisse>
          <option value="">Choisir…</option>
          {caisses.map((c) => <option value={c.valeur}>{c.libelle}</option>)}
        </select>
        <p id="f-caisse-erreur" class="message-erreur"></p>
      </div>

      <div class="sm:col-span-2" hidden data-caisse-autre>
        <label for="f-caisse-autre" class="etiquette-champ">Lequel ?</label>
        <input id="f-caisse-autre" name="caisse_autre" type="text" class="champ"
          aria-describedby="f-caisse-autre-erreur" data-erreur="Indiquez le nom de votre logiciel de caisse." />
        <p id="f-caisse-autre-erreur" class="message-erreur"></p>
      </div>

      <div>
        <label for="f-email" class="etiquette-champ">Email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required class="champ"
          aria-describedby="f-email-erreur" data-erreur="Indiquez votre adresse email." />
        <p id="f-email-erreur" class="message-erreur"></p>
      </div>

      <div>
        <label for="f-tel" class="etiquette-champ">
          Téléphone <span class="font-normal text-encre-douce">(facultatif)</span>
        </label>
        <input id="f-tel" name="telephone" type="tel" autocomplete="tel" class="champ" aria-describedby="f-tel-aide" />
        <p id="f-tel-aide" class="mt-1 text-[0.85rem] text-encre-douce">Si vous préférez un coup de fil.</p>
      </div>

      <div class="sm:col-span-2">
        <label for="f-temps" class="etiquette-champ">
          Qu’est-ce qui vous prend le plus de temps avec votre cave aujourd’hui ?{' '}
          <span class="font-normal text-encre-douce">(facultatif)</span>
        </label>
        <textarea id="f-temps" name="ce_qui_prend_du_temps" rows="3" class="champ"></textarea>
      </div>

      <!-- Champs cachés : test de message et provenance -->
      <input type="hidden" name="variante_titre" value="a" data-variante />
      <input type="hidden" name="utm_source" value="" data-utm="utm_source" />
      <input type="hidden" name="utm_medium" value="" data-utm="utm_medium" />
      <input type="hidden" name="utm_campaign" value="" data-utm="utm_campaign" />
      <input type="hidden" name="_subject" value="Nouvelle inscription au pilote Cuvée" />

      <!-- Piège à robots : invisible pour les visiteurs -->
      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for="f-gotcha">Ne pas remplir ce champ</label>
        <input id="f-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <p class="text-[0.85rem] leading-snug text-encre-douce sm:col-span-2">
        Vos informations servent uniquement à vous recontacter au sujet du programme pilote. Elles ne sont ni vendues ni
        utilisées à d’autres fins. Nous notons aussi la version de la page que vous avez vue, pour savoir quels messages
        parlent le mieux. <a href="/confidentialite/" class="underline underline-offset-2">En savoir plus</a>.
      </p>

      <div class="sm:col-span-2">
        <p class="message-erreur mb-4 text-[0.95rem]" role="alert" data-erreur-envoi></p>
        <button type="submit" class="btn btn-primaire w-full sm:w-auto" data-envoyer>
          Rejoindre le programme pilote
        </button>
      </div>
    </form>
  </div>

  <div hidden data-form-succes>
    <p class="surtitre text-vert">Demande reçue</p>
    <h3 class="mt-3 font-serif text-[1.9rem] leading-tight font-medium" tabindex="-1" data-succes-titre>Merci !</h3>
    <p class="mt-4 text-lg text-encre-douce">
      Votre demande est bien arrivée. Nous vous recontactons sous <mark class="a-completer"
        >[À COMPLÉTER : délai de recontact]</mark
      > pour un premier échange.
    </p>
    <p class="mt-4 text-encre-douce">
      Une question d’ici là ?
      {
        contact ? (
          <a href={`mailto:${contact}`} class="lien">{contact}</a>
        ) : (
          <mark class="a-completer">[À COMPLÉTER : email de contact]</mark>
        )
      }
    </p>
    <span class="tampon top-8 right-6" aria-hidden="true">Reçu</span>
  </div>
</div>

<script>
  const ENDPOINT: string = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
  const carte = document.getElementById('inscription');
  const formulaire = carte?.querySelector<HTMLFormElement>('[data-inscription]');

  if (carte && formulaire) {
    const zone = carte.querySelector<HTMLElement>('[data-form-zone]')!;
    const succes = carte.querySelector<HTMLElement>('[data-form-succes]')!;
    const titreSucces = carte.querySelector<HTMLElement>('[data-succes-titre]')!;
    const erreurEnvoi = formulaire.querySelector<HTMLElement>('[data-erreur-envoi]')!;
    const bouton = formulaire.querySelector<HTMLButtonElement>('[data-envoyer]')!;
    const caisse = formulaire.querySelector<HTMLSelectElement>('[data-caisse]')!;
    const blocCaisseAutre = formulaire.querySelector<HTMLElement>('[data-caisse-autre]')!;
    const champCaisseAutre = blocCaisseAutre.querySelector<HTMLInputElement>('input')!;
    const contact = carte.dataset.contact ?? '';
    const libelleBouton = bouton.textContent?.trim() ?? '';

    // Variante du titre (?v=b) et provenance (utm_*), pour comparer les messages.
    const parametres = new URLSearchParams(window.location.search);
    formulaire.querySelector<HTMLInputElement>('[data-variante]')!.value =
      document.documentElement.dataset.variante ?? 'a';
    formulaire.querySelectorAll<HTMLInputElement>('[data-utm]').forEach((champ) => {
      champ.value = parametres.get(champ.dataset.utm!) ?? '';
    });

    caisse.addEventListener('change', () => {
      const autre = caisse.value === 'autre';
      blocCaisseAutre.hidden = !autre;
      champCaisseAutre.required = autre;
      if (!autre) effacerErreur(champCaisseAutre);
    });

    const champsAValider = () =>
      Array.from(formulaire.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]'));

    function messageDe(champ: HTMLInputElement | HTMLSelectElement) {
      return document.getElementById(`${champ.id}-erreur`);
    }

    function effacerErreur(champ: HTMLInputElement | HTMLSelectElement) {
      champ.removeAttribute('aria-invalid');
      const message = messageDe(champ);
      if (message) message.textContent = '';
    }

    function verifier(champ: HTMLInputElement | HTMLSelectElement) {
      const valeur = champ.value.trim();
      let erreur = '';
      if (!valeur) erreur = champ.dataset.erreur ?? 'Ce champ est obligatoire.';
      else if (champ.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(valeur))
        erreur = 'Cette adresse email ne semble pas valide.';

      const message = messageDe(champ);
      if (erreur) {
        champ.setAttribute('aria-invalid', 'true');
        if (message) message.textContent = erreur;
      } else {
        effacerErreur(champ);
      }
      return !erreur;
    }

    // Une fois signalée, une erreur disparaît dès que le champ est corrigé.
    formulaire.addEventListener('input', (e) => {
      const champ = e.target as HTMLInputElement;
      if (champ.getAttribute('aria-invalid') === 'true') verifier(champ);
    });
    formulaire.addEventListener('change', (e) => {
      const champ = e.target as HTMLSelectElement;
      if (champ.getAttribute('aria-invalid') === 'true') verifier(champ);
    });

    function afficherSucces(donnees: FormData) {
      const prenom = String(donnees.get('nom') ?? '').trim().split(/\s+/)[0];
      titreSucces.textContent = prenom ? `Merci ${prenom} !` : 'Merci !';
      zone.hidden = true;
      succes.hidden = false;
      carte!.classList.add('est-valide');
      titreSucces.focus();
    }

    function afficherErreurEnvoi(nonConfigure: boolean) {
      const adresse = contact || '[À COMPLÉTER : email de contact]';
      erreurEnvoi.textContent = nonConfigure
        ? `Les inscriptions en ligne ne sont pas encore ouvertes. Écrivez-nous en attendant : ${adresse}`
        : `L’envoi n’a pas fonctionné. Réessayez dans un instant, ou écrivez-nous : ${adresse}`;
    }

    formulaire.addEventListener('submit', async (e) => {
      e.preventDefault();
      erreurEnvoi.textContent = '';

      const invalides = champsAValider().filter((champ) => !verifier(champ));
      if (invalides.length) {
        invalides[0].focus();
        return;
      }

      const donnees = new FormData(formulaire);
      if (donnees.get('_gotcha')) return;

      bouton.disabled = true;
      bouton.textContent = 'Envoi en cours…';

      try {
        if (!ENDPOINT) {
          if (import.meta.env.DEV) {
            // TODO : retirer une fois PUBLIC_FORM_ENDPOINT configuré. Simulation locale uniquement.
            console.info('[Cuvée] Formulaire non configuré : succès simulé (local uniquement).', Object.fromEntries(donnees));
            await new Promise((resolve) => setTimeout(resolve, 600));
            afficherSucces(donnees);
            return;
          }
          afficherErreurEnvoi(true);
          return;
        }

        const reponse = await fetch(ENDPOINT, {
          method: 'POST',
          body: donnees,
          headers: { Accept: 'application/json' },
        });
        if (!reponse.ok) throw new Error(`HTTP ${reponse.status}`);
        afficherSucces(donnees);
      } catch {
        afficherErreurEnvoi(false);
      } finally {
        bouton.disabled = false;
        bouton.textContent = libelleBouton;
      }
    });
  }
</script>
