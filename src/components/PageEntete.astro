---
/** En-tête éditorial d’une page intérieure : surtitre, grand titre, chapô, chiffre romain de l’onglet en filigrane. Le titre accepte du HTML (<em>). */
import { navigation } from '../data/site';
interface Props {
  surtitre: string;
  titre: string;
  chapo: string;
  id?: string;
}
const { surtitre, titre, chapo, id = 'page-titre' } = Astro.props;
const chemin = Astro.url.pathname.replace(/\/+$/, '') || '/';
const rang = navigation.findIndex((n) => (n.href === '/' ? chemin === '/' : chemin === n.href || chemin.startsWith(n.href + '/')));
const romain = ['I', 'II', 'III', 'IV', 'V', 'VI'][rang] ?? '';
---
<header class="entete-page border-b border-filet bg-creme pt-14 pb-12 lg:pt-20 lg:pb-16">
  {romain && <span class="entete-chiffre" aria-hidden="true">{romain}</span>}
  <div class="conteneur relative">
    <div class="max-w-3xl">
      <p class="surtitre flex items-center gap-3 text-bordeaux" data-reveal>
        <span>{surtitre}</span>
        <span class="entete-filet-page h-px w-14 bg-dore" aria-hidden="true"></span>
      </p>
      <h1
        id={id}
        class="mt-5 text-[2.5rem] leading-[1.05] font-medium tracking-[-0.02em] sm:text-6xl lg:text-[4.25rem] [&_em]:text-bordeaux"
        data-reveal-lignes
        data-reveal
      >
        <Fragment set:html={titre} />
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-encre-douce sm:text-xl" data-reveal data-reveal-delai="3">
        {chapo}
      </p>
    </div>
  </div>
</header>
