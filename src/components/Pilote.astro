---
/** Contenu de la page pilote : invitation et conditions, mise en place (vidéo), déroulé, formulaire (conclusion de la page). */
import PiloteInvitation from './PiloteInvitation.astro';
import PiloteFrise from './PiloteFrise.astro';
import Formulaire from './Formulaire.astro';
import Video from './maison/Video.astro';
---
<PiloteInvitation />

<section class="media-cadre voile voile-plein sur-image sur-fond-sombre flex min-h-[60svh] items-center" style="--voile-plein: 0.72" aria-labelledby="mise-en-place-titre">
  <Video src="/media/mise-en-place.mp4" affiche="/media/mise-en-place-poster.jpg" sizes="100vw" />
  <div class="conteneur-etroit section relative z-10 w-full text-center">
    <p class="surtitre" data-reveal>La mise en place</p>
    <h2 id="mise-en-place-titre" class="mt-4" data-reveal data-reveal-delai="1">
      Rien d’engageant ne part sans votre validation
    </h2>
  </div>
</section>

<PiloteFrise />
<Formulaire />
