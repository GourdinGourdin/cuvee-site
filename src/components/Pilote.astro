---
import PiloteInvitation from './PiloteInvitation.astro';
import PiloteFrise from './PiloteFrise.astro';
import Formulaire from './Formulaire.astro';
---
<PiloteInvitation />
<PiloteFrise />
<section aria-labelledby="bon-titre" class="border-t border-filet bg-creme-fonce py-16 lg:py-24">
  <div class="conteneur">
    <div class="mx-auto max-w-3xl">
      <p class="surtitre flex items-center gap-3 text-bordeaux" data-reveal><span>Bon d’inscription</span><span class="h-px w-8 bg-dore" aria-hidden="true"></span></p>
      <h2 id="bon-titre" class="mt-4 text-[2rem] leading-[1.1] font-medium tracking-[-0.015em] sm:text-5xl" data-reveal data-reveal-delai="1">Réservez votre <em class="text-bordeaux">place</em> au pilote.</h2>
      <div class="mt-10" data-reveal data-reveal-delai="2"><Formulaire /></div>
    </div>
  </div>
</section>
