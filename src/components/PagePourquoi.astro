---
import ACompleter from './ACompleter.astro';
import Photo from './Photo.astro';

const citations = [
  { libelle: 'Le déclic', contenu: 'l’histoire personnelle : le déclic, le lieu ou la personne qui a montré le problème de la cave' },
  { libelle: 'Ce que nous avons observé', contenu: 'ce que vous avez observé chez les cavistes et sommeliers, sans chiffre inventé' },
  { libelle: 'Ce que Cuvée doit changer', contenu: 'ce que vous voulez que Cuvée change concrètement pour un lieu indépendant' },
];
---
<section aria-labelledby="pourquoi-titre" class="pourquoi section media-cadre voile voile-plein sur-image sur-fond-sombre zoom-lent">
  <Photo src="/media/mur-bouteilles.jpg" alt="" sizes="100vw" />

  <div class="conteneur relative z-10">
    <p class="surtitre" data-reveal>Pourquoi nous</p>
    <h2 id="pourquoi-titre" class="mt-4" data-reveal data-reveal-delai="1">Pourquoi nous faisons ça</h2>

    <blockquote class="pourquoi-phrase mt-8" data-reveal data-reveal-delai="2">
      <p>Un outil qui se met au point dans de vrais lieux, avec les gens qui les font tourner.</p>
    </blockquote>

    <ol role="list" class="mt-12 grid gap-8 lg:mt-16 lg:grid-cols-3 lg:gap-12">
      {
        citations.map((c, i) => (
          <li class="pourquoi-carte" data-reveal data-reveal-delai={String(i + 1)}>
            <p class="chapitre-num text-dore-clair">{['I', 'II', 'III'][i]}</p>
            <h3 class="mt-2">{c.libelle}</h3>
            <p class="texte-courant mt-4"><ACompleter texte={c.contenu} /></p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .pourquoi { --voile-plein: 0.8; }
  .pourquoi .pourquoi-phrase p {
    max-width: 28ch;
    font-family: var(--font-titre);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.25;
    text-wrap: balance;
    color: var(--color-creme);
  }
  .pourquoi .pourquoi-carte {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-dore);
  }
</style>
