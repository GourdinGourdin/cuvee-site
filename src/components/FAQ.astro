---
import { faq, themes } from '../data/faq';
import { avecPlaceholders } from '../lib/texte';
import { site, lienInscription } from '../data/site';

const contact = site.emailContact;
const compte = (t: string) => faq.filter((q) => q.theme === t).length;
---
<section id="faq" aria-labelledby="faq-titre" class="py-14 lg:py-24">
  <div class="conteneur grid gap-10 lg:grid-cols-[minmax(0,19rem)_minmax(0,1fr)] lg:gap-16">
    <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Rechercher et filtrer les questions">
      <h2 id="faq-titre" class="font-serif text-2xl font-medium">Trouver une réponse</h2>

      <div class="mt-4">
        <label for="faq-recherche" class="etiquette-champ">Rechercher une question</label>
        <input id="faq-recherche" type="search" class="champ faq-recherche" placeholder="caisse, prix, données…" autocomplete="off" />
      </div>

      <div class="mt-5" role="group" aria-labelledby="faq-themes-libelle">
        <p id="faq-themes-libelle" class="surtitre text-encre-douce">Par thème</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" class="faq-filtre" data-theme="" aria-pressed="true">Tout <span class="chiffres">{faq.length}</span></button>
          {themes.map((t) => <button type="button" class="faq-filtre" data-theme={t} aria-pressed="false">{t} <span class="chiffres">{compte(t)}</span></button>)}
        </div>
      </div>

      <p class="mt-4 min-h-[1.5rem] text-[0.9rem] text-encre-douce" role="status" aria-live="polite" data-faq-statut></p>

      <nav class="mt-6 hidden border-t border-filet pt-4 lg:block" aria-label="Sommaire des questions">
        <ol role="list" class="grid gap-1">
          {faq.map((q, i) => (
            <li data-toc={String(i)}><a href={`#q-${i + 1}`} class="faq-toc flex gap-3 py-1 text-[0.9rem] leading-snug text-encre-douce hover:text-bordeaux"><span class="chiffres text-bordeaux">{String(i + 1).padStart(2, '0')}</span><span>{q.question}</span></a></li>
          ))}
        </ol>
      </nav>
    </aside>

    <div>
      <div class="border-t-2 border-encre" data-reveal data-faq-liste>
        {
          faq.map((item, i) => (
            <details id={`q-${i + 1}`} class="faq-item group border-b border-filet" data-theme={item.theme} data-index={String(i)}>
              <summary class="faq-question flex items-start gap-4 py-5 font-serif text-xl leading-snug font-medium transition-colors hover:text-bordeaux sm:text-[1.35rem]">
                <span class="chiffres mt-2 shrink-0 text-[0.8rem] text-bordeaux" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="grow">{item.question}</span>
                <span class="faq-signe relative mt-3 h-3.5 w-3.5 shrink-0 text-bordeaux" aria-hidden="true" />
              </summary>
              <div class="faq-reponse grid gap-3 pr-8 pb-6 pl-9 text-encre-douce">
                <p class="surtitre text-bordeaux">{item.theme}</p>
                {item.reponse.map((paragraphe) => (
                  <p set:html={avecPlaceholders(paragraphe)} />
                ))}
              </div>
            </details>
          ))
        }
      </div>

      <p class="mt-8 hidden border border-dashed border-bordure p-5 text-encre-douce" data-faq-vide>
        Aucune question ne correspond à cette recherche. Écrivez-nous plutôt ci-dessous.
      </p>

      <div class="faq-ecrire papier mt-10 p-6 sm:p-8" data-reveal>
        <p class="surtitre text-bordeaux">Votre question n’est pas là ?</p>
        <p class="mt-3 font-serif text-2xl leading-snug font-medium">Écrivez-nous directement, nous répondons nous-mêmes.</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
          {contact ? (
            <a href={`mailto:${contact}`} class="btn btn-primaire w-full sm:w-auto">{contact}</a>
          ) : (
            <p><mark class="a-completer">[À COMPLÉTER : email de contact]</mark></p>
          )}
          <a href={lienInscription} class="lien lien-seul">ou posez-la dans le formulaire du pilote</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .faq-filtre {
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-bordure);
    border-radius: 999px;
    background: transparent;
    color: var(--color-encre);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .faq-filtre .chiffres { font-size: 0.75rem; opacity: 0.8; margin-left: 0.15rem; }
  .faq-filtre:hover { border-color: var(--color-bordeaux); color: var(--color-bordeaux); }
  .faq-filtre[aria-pressed="true"] { background: var(--color-bordeaux); border-color: var(--color-bordeaux); color: var(--color-creme); }
  .faq-toc { transition: translate 0.25s ease, color 0.2s ease; }
  .faq-toc:hover { translate: 4px 0; }
  .faq-item[hidden], [data-faq-liste] [hidden] { display: none; }
  [data-toc][hidden] { display: none; }
  .faq-item:target { background: var(--color-bordeaux-clair); }

  /* Ouverture animée : navigateurs récents (::details-content + interpolate-size) ; ailleurs, l’ouverture reste instantanée. */
  @supports (interpolate-size: allow-keywords) {
    .faq-item { interpolate-size: allow-keywords; }
    .faq-item::details-content {
      block-size: 0;
      overflow: clip;
      opacity: 0;
      transition: block-size 0.35s ease, opacity 0.3s ease, content-visibility 0.35s allow-discrete;
    }
    .faq-item[open]::details-content { block-size: auto; opacity: 1; }
  }
  .faq-item .faq-signe { transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1.2); }
  .faq-item[open] .faq-signe { transform: rotate(135deg); }
  .faq-item[open] .faq-signe::after { transform: rotate(90deg); }
  .faq-question {
    background-image: linear-gradient(var(--color-bordeaux), var(--color-bordeaux));
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0% 2px;
    transition: background-size 0.35s ease, color 0.2s ease;
  }
  .faq-item[open] .faq-question, .faq-question:hover { background-size: 100% 2px; }
  .faq-item[open] .faq-question { color: var(--color-bordeaux); }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content, .faq-item .faq-signe, .faq-toc, .faq-filtre { transition: none !important; }
  }
</style>

<script>
  const liste = document.querySelector<HTMLElement>('[data-faq-liste]');
  if (liste) {
    const items = Array.from(liste.querySelectorAll<HTMLDetailsElement>('.faq-item'));
    const tocs = Array.from(document.querySelectorAll<HTMLElement>('[data-toc]'));
    const boutons = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq-filtre'));
    const recherche = document.getElementById('faq-recherche') as HTMLInputElement;
    const statut = document.querySelector<HTMLElement>('[data-faq-statut]')!;
    const vide = document.querySelector<HTMLElement>('[data-faq-vide]')!;
    const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const textes = items.map((d) => norm(d.textContent ?? ''));
    let theme = '';

    function filtrer() {
      const mots = norm(recherche.value).split(/\s+/).filter(Boolean);
      let n = 0;
      items.forEach((d, i) => {
        const ok = (!theme || d.dataset.theme === theme) && mots.every((m) => textes[i].includes(m));
        d.hidden = !ok;
        if (tocs[i]) tocs[i].hidden = !ok;
        if (ok) n++;
      });
      vide.classList.toggle('hidden', n > 0);
      statut.textContent = recherche.value || theme ? `${n} question${n > 1 ? 's' : ''} affichée${n > 1 ? 's' : ''} sur ${items.length}` : '';
    }

    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        theme = b.dataset.theme ?? '';
        boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        filtrer();
      }),
    );
    recherche.addEventListener('input', filtrer);

    // Un lien du sommaire ou une ancre ouvre la question visée.
    const ouvrirCible = () => {
      const cible = document.getElementById(location.hash.slice(1));
      if (cible instanceof HTMLDetailsElement) cible.open = true;
    };
    window.addEventListener('hashchange', ouvrirCible);
    ouvrirCible();
  }
</script>
