---
import TitreSection from './TitreSection.astro';
import { faq } from '../data/faq';
import { avecPlaceholders } from '../lib/texte';
---
<section id="faq" aria-labelledby="faq-titre" class="py-20 lg:py-28">
  <div class="conteneur grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
    <div>
      <TitreSection numero="8" libelle="Questions" id="faq-titre" titre="Avant de vous inscrire." />
      <p class="mt-6 max-w-md text-lg text-encre-douce">
        Une question qui n’est pas ici ? Posez-la dans le formulaire, nous répondrons lors du premier échange.
      </p>
      <a href="#inscription" class="lien lien-seul mt-3">Aller au formulaire</a>
    </div>

    <div class="border-t-2 border-encre">
      {
        faq.map((item) => (
          <details class="faq-item group border-b border-filet">
            <summary class="flex items-start justify-between gap-6 py-5 font-serif text-xl leading-snug font-medium transition-colors hover:text-bordeaux sm:text-[1.35rem]">
              <span>{item.question}</span>
              <span class="faq-signe relative mt-3 h-3.5 w-3.5 shrink-0 text-bordeaux" aria-hidden="true" />
            </summary>
            <div class="grid gap-3 pr-8 pb-6 text-encre-douce">
              {item.reponse.map((paragraphe) => (
                <p set:html={avecPlaceholders(paragraphe)} />
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
