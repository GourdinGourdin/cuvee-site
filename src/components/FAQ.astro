---
import { faq, themes } from '../data/faq';
import { avecPlaceholders } from '../lib/texte';
import { site, lienInscription } from '../data/site';

const contact = site.emailContact;
// Chaque question garde son numéro d’origine (ancre #q-N), les groupes suivent l’ordre des thèmes.
const indexees = faq.map((q, i) => ({ ...q, i }));
const groupes = themes.map((t) => ({ theme: t, questions: indexees.filter((q) => q.theme === t) }));
const slug = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
---
<section id="faq" aria-label="Questions fréquentes" class="faq section bg-creme">
  <div class="conteneur grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] lg:gap-24">
    <aside class="faq-nav min-w-0 lg:sticky lg:top-28 lg:self-start" aria-label="Rechercher et filtrer les questions">
      <p class="surtitre hidden lg:block" data-reveal>Les thèmes</p>

      <div class="faq-recherche-bloc" data-reveal>
        <label for="faq-recherche" class="sr-only">Rechercher une question</label>
        <svg class="faq-loupe" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4.5 4.5" /></svg>
        <input id="faq-recherche" type="search" class="faq-recherche" placeholder="Caisse, prix, données…" autocomplete="off" />
      </div>

      <div class="faq-themes" role="group" aria-label="Filtrer par thème" data-reveal data-reveal-delai="1">
        <button type="button" class="faq-theme" data-theme="" aria-pressed="true"><span>Tout</span><span class="faq-compte">{faq.length}</span></button>
        {groupes.map((g) => <button type="button" class="faq-theme" data-theme={g.theme} aria-pressed="false"><span>{g.theme}</span><span class="faq-compte">{g.questions.length}</span></button>)}
      </div>

      <p class="petit mt-4 min-h-6" role="status" aria-live="polite" data-faq-statut></p>
    </aside>

    <div data-faq-liste>
      {
        groupes.map((g) => (
          <section class="faq-groupe" aria-labelledby={`faq-g-${slug(g.theme)}`} data-groupe={g.theme}>
            <h2 id={`faq-g-${slug(g.theme)}`} class="faq-groupe-titre" data-reveal>{g.theme}</h2>
            <div>
              {g.questions.map((item, k) => (
                <details id={`q-${item.i + 1}`} class="faq-item" data-theme={item.theme}>
                  <summary class="faq-question">
                    <h3 class="faq-intitule">{item.question}</h3>
                    <span class="faq-signe" aria-hidden="true" />
                  </summary>
                  <div class="faq-reponse">
                    {item.reponse.map((paragraphe) => (
                      <p class="texte-courant" set:html={avecPlaceholders(paragraphe)} />
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))
      }

      <p class="faq-vide hidden" data-faq-vide>
        Aucune question ne correspond à cette recherche. Écrivez-nous plutôt ci-dessous.
      </p>
    </div>
  </div>
</section>

<section aria-labelledby="autre-titre" class="faq-autre section-serree bg-creme">
  <div class="conteneur">
    <div class="fiche faq-autre-fiche">
      <div>
        <h2 id="autre-titre" data-reveal>Une autre question&nbsp;?</h2>
        <p class="texte-courant mt-4" data-reveal data-reveal-delai="1">Écrivez-nous directement, nous répondons nous-mêmes.</p>
      </div>
      <div class="faq-autre-actions" data-reveal data-reveal-delai="2">
        {
          contact ? (
            <a href={`mailto:${contact}`} class="lien faq-email">{contact}</a>
          ) : (
            <p class="faq-email"><mark class="a-completer">[À COMPLÉTER : email de contact]</mark></p>
          )
        }
        <a href={lienInscription} class="btn btn-contour">Poser ma question via le formulaire</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---- Navigation : recherche + thèmes ---- */
  .faq-recherche-bloc { position: relative; margin-top: var(--space-5); }
  .faq-loupe { position: absolute; left: 0; top: 50%; translate: 0 -50%; color: var(--color-bordeaux); pointer-events: none; }
  .faq-recherche {
    display: block;
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 0.25rem 0.5rem 2rem;
    border: 0;
    border-bottom: 1px solid var(--color-encre-douce);
    border-radius: 0;
    background: transparent;
    color: var(--color-encre);
    font: inherit;
    font-size: 1rem;
    transition: border-color var(--duree-2) ease, box-shadow var(--duree-2) ease;
  }
  .faq-recherche::placeholder { color: var(--color-encre-douce); opacity: 0.85; }
  .faq-recherche:hover { border-bottom-color: var(--color-bordeaux); }
  .faq-recherche:focus-visible { outline: none; border-bottom-color: var(--color-bordeaux); box-shadow: 0 1px 0 var(--color-bordeaux); }
  .faq-recherche-bloc:focus-within { outline: 2px solid var(--color-bordeaux); outline-offset: 4px; }
  .faq-recherche::-webkit-search-cancel-button { cursor: pointer; }

  /* Mobile : puces qui passent à la ligne (aucun défilement, aucun débordement) */
  .faq-themes { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .faq-theme {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-filet);
    border-radius: var(--rayon);
    background: transparent;
    color: var(--color-encre-douce);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--duree-1) ease, border-color var(--duree-1) ease, background-color var(--duree-1) ease;
  }
  .faq-compte { font-weight: 400; letter-spacing: 0.08em; opacity: 0.85; }
  .faq-theme:hover { color: var(--color-bordeaux); border-color: var(--color-bordeaux); }
  .faq-theme:active { background: var(--color-bordeaux-clair); }
  .faq-theme:focus-visible { outline: 2px solid var(--color-bordeaux); outline-offset: 3px; }
  .faq-theme[aria-pressed="true"] { color: var(--color-bordeaux); border-color: var(--color-bordeaux); background: var(--color-bordeaux-clair); }

  @media (min-width: 64rem) {
    .faq-themes { flex-direction: column; flex-wrap: nowrap; gap: 0; margin-top: var(--space-5); border-left: 1px solid var(--color-filet); }
    .faq-theme {
      position: relative;
      justify-content: space-between;
      padding: 0 0 0 var(--space-4);
      border: 0;
      border-radius: 0;
      background: transparent !important;
    }
    .faq-theme::after {
      content: "";
      position: absolute;
      left: -1px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--color-bordeaux);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform var(--duree-3) var(--ease-sortie);
    }
    .faq-theme[aria-pressed="true"]::after { transform: scaleY(1); }
    .faq-theme:focus-visible { outline-offset: -2px; }
  }

  /* ---- Groupes ---- */
  .faq-groupe + .faq-groupe { margin-top: var(--space-9); }
  .faq-groupe[hidden], .faq-item[hidden] { display: none; }
  .faq-groupe-titre { font-size: clamp(1.375rem, 2.4vw, 1.75rem); margin-bottom: var(--space-4); }

  /* ---- Accordéons ---- */
  .faq-item { border-bottom: 1px solid var(--color-filet); scroll-margin-top: 7.5rem; transition: background-color var(--duree-3) ease; }
  .faq-groupe-titre + div > .faq-item:first-child { border-top: 1px solid var(--color-filet); }
  .faq-item:target { background: var(--color-bordeaux-clair); }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 3.5rem;
    padding: var(--space-4) 0;
    cursor: pointer;
    list-style: none;
    color: var(--color-encre);
    transition: color var(--duree-1) ease;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::marker { content: ""; }
  .faq-intitule { margin: 0; font-size: clamp(1.0625rem, 1.6vw, 1.25rem); }
  .faq-question:hover, .faq-item[open] .faq-question { color: var(--color-bordeaux); }
  .faq-question:focus-visible { outline: 2px solid var(--color-bordeaux); outline-offset: 3px; }

  /* plus qui devient moins, sans cadre */
  .faq-signe { position: relative; flex: none; width: 1.5rem; height: 1.5rem; color: var(--color-bordeaux); }
  .faq-signe::before, .faq-signe::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.875rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate var(--duree-2) var(--ease-sortie);
  }
  .faq-signe::after { rotate: 90deg; }
  .faq-item[open] .faq-signe::after { rotate: 0deg; }

  .faq-reponse { display: grid; gap: var(--space-4); max-width: 42rem; padding: 0 var(--space-8) var(--space-6) 0; }

  /* Ouverture fluide en hauteur : navigateurs récents ; ailleurs, la réponse apparaît en fondu. */
  @media (prefers-reduced-motion: no-preference) {
    .faq-item[open] .faq-reponse { animation: faq-entree var(--duree-3) var(--ease-sortie) both; }
    @supports (interpolate-size: allow-keywords) {
      .faq-item { interpolate-size: allow-keywords; }
      .faq-item::details-content {
        block-size: 0;
        overflow: clip;
        transition: block-size var(--duree-3) var(--ease-sortie), content-visibility var(--duree-3) allow-discrete;
      }
      .faq-item[open]::details-content { block-size: auto; }
    }
  }
  @keyframes faq-entree {
    from { opacity: 0; translate: 0 -0.5rem; }
    to { opacity: 1; translate: 0 0; }
  }

  .faq-vide { margin-top: var(--space-5); padding: var(--space-5); border: 1px dashed var(--color-dore); color: var(--color-encre-douce); }
  .faq-vide.hidden { display: none; }

  /* ---- Autre question ---- */
  .faq-autre-fiche { display: grid; gap: var(--space-6); align-items: center; padding: var(--space-6); }
  .faq-autre-actions { display: grid; gap: var(--space-4); justify-items: start; }
  .faq-email { font-size: 1.125rem; word-break: break-word; }
  @media (min-width: 48rem) {
    .faq-autre-fiche { grid-template-columns: 1fr auto; gap: var(--space-9); padding: var(--space-8); }
    .faq-autre-actions { justify-items: end; }
  }

  @media (max-width: 40rem) {
    .faq-reponse { padding-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item, .faq-question, .faq-signe::before, .faq-signe::after, .faq-theme, .faq-theme::after { transition: none !important; }
  }
</style>

<script>
  const liste = document.querySelector<HTMLElement>('[data-faq-liste]');
  if (liste) {
    const groupes = Array.from(liste.querySelectorAll<HTMLElement>('.faq-groupe'));
    const items = Array.from(liste.querySelectorAll<HTMLDetailsElement>('.faq-item'));
    const boutons = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq-theme'));
    const recherche = document.getElementById('faq-recherche') as HTMLInputElement;
    const statut = document.querySelector<HTMLElement>('[data-faq-statut]')!;
    const vide = document.querySelector<HTMLElement>('[data-faq-vide]')!;
    const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const textes = items.map((d) => norm(d.textContent ?? ''));
    let theme = '';

    function filtrer() {
      const mots = norm(recherche.value).split(/\s+/).filter(Boolean);
      let n = 0;
      items.forEach((d, i) => {
        const ok = (!theme || d.dataset.theme === theme) && mots.every((m) => textes[i].includes(m));
        d.hidden = !ok;
        if (ok) n++;
      });
      groupes.forEach((g) => {
        g.hidden = !g.querySelector('.faq-item:not([hidden])');
      });
      vide.classList.toggle('hidden', n > 0);
      statut.textContent = recherche.value || theme ? `${n} question${n > 1 ? 's' : ''} affichée${n > 1 ? 's' : ''} sur ${items.length}` : '';
    }

    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        theme = b.dataset.theme ?? '';
        boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        filtrer();
      }),
    );
    recherche.addEventListener('input', filtrer);

    // Une ancre (#q-3) ouvre la question visée.
    const ouvrirCible = () => {
      const cible = document.getElementById(location.hash.slice(1));
      if (cible instanceof HTMLDetailsElement) cible.open = true;
    };
    window.addEventListener('hashchange', ouvrirCible);
    ouvrirCible();
  }
</script>
