---
/** Cachet bordeaux, à plat : posé une seule fois, sur le message de confirmation du formulaire. */
interface Props { taille?: number; class?: string; }
const { taille = 72, class: classe = '' } = Astro.props;
---
<svg class:list={['sceau', classe]} viewBox="0 0 100 100" width={taille} height={taille} aria-hidden="true" focusable="false">
  <circle cx="50" cy="50" r="48" fill="#6e1f2f" />
  <circle cx="50" cy="50" r="40" fill="none" stroke="#e9ddbf" stroke-opacity="0.45" stroke-width="1.5" />
  <text x="50" y="64" text-anchor="middle" font-size="40" font-weight="800" fill="#f5e9e4" style="font-family: var(--font-titre)">C</text>
</svg>

<style is:global>
  .sceau { display: block; margin-inline: auto; }
</style>
