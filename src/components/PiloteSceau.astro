---
/** Sceau de cire bordeaux, dessiné. En deux moitiés qui s’écartent à l’ouverture (classe .sceau-ouvre sur un parent). */
interface Props { taille?: number; class?: string; }
const { taille = 96, class: classe = '' } = Astro.props;
const id = 's' + Math.random().toString(36).slice(2, 7);
const contour = 'M50 4c8 0 11 6 18 7 7 1 14-2 18 4 4 6 0 12 2 19 2 7 9 11 7 18-2 7-9 8-12 14-3 6-1 14-8 18-7 4-13-1-20 0-7 1-11 7-18 5-7-2-8-9-13-13-5-4-13-3-15-10-2-7 5-11 6-18 1-7-4-13 0-19 4-6 11-4 17-7 6-3 8-12 15-12z';
---
<span class:list={['sceau relative inline-block', classe]} style={`width:${taille}px;height:${taille}px`} aria-hidden="true">
  {['g', 'd'].map((cote) => (
    <svg class={`sceau-moitie sceau-${cote} absolute inset-0`} viewBox="0 0 100 100" width={taille} height={taille}>
      <defs>
        <radialGradient id={`${id}${cote}`} cx="35%" cy="30%" r="80%">
          <stop offset="0" stop-color="#8d2d40" />
          <stop offset="0.6" stop-color="#6e1f2f" />
          <stop offset="1" stop-color="#4a1220" />
        </radialGradient>
      </defs>
      <path d={contour} fill={`url(#${id}${cote})`} />
      <circle cx="50" cy="50" r="31" fill="none" stroke="#e9ddbf" stroke-opacity="0.28" stroke-width="1.6" />
      <circle cx="50" cy="50" r="27" fill="none" stroke="#2c0a12" stroke-opacity="0.35" stroke-width="1" />
      <text x="50" y="61" text-anchor="middle" font-size="30" font-weight="800" letter-spacing="1" fill="#e9ddbf" fill-opacity="0.85" style="font-family: var(--font-titre)">C</text>
    </svg>
  ))}
</span>

<style is:global>
  .sceau-g { clip-path: polygon(0 0, 52% 0, 47% 30%, 54% 55%, 48% 80%, 52% 100%, 0 100%); }
  .sceau-d { clip-path: polygon(52% 0, 100% 0, 100% 100%, 52% 100%, 48% 80%, 54% 55%, 47% 30%); }
  .sceau { filter: drop-shadow(0 6px 6px rgb(31 10 14 / 0.35)); }
  @media (prefers-reduced-motion: no-preference) {
    html.anim .sceau-ouvre.est-visible .sceau-g { animation: sceau-g 1.1s cubic-bezier(0.3, 0.7, 0.2, 1) 0.5s both; }
    html.anim .sceau-ouvre.est-visible .sceau-d { animation: sceau-d 1.1s cubic-bezier(0.3, 0.7, 0.2, 1) 0.5s both; }
  }
  @keyframes sceau-g { 0% { transform: none; } 30% { transform: translateX(1px) rotate(1deg); } 100% { transform: translate(-3px, 2px) rotate(-4deg); } }
  @keyframes sceau-d { 0% { transform: none; } 30% { transform: translateX(-1px) rotate(-1deg); } 100% { transform: translate(3px, 1px) rotate(3deg); } }
</style>
