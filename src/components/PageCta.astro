---
/** Appel en bas de page vers le pilote : même esprit que maison/Appel.astro (bordeaux + photo en deux colonnes). */
import { lienInscription } from '../data/site';
interface Props {
  titre?: string;
  texte?: string;
  image?: string;
}
const {
  titre = 'Prêt à essayer avec nous ?',
  texte = 'Quelques lieux, quelques mois, et une équipe qui construit l’outil avec vous. L’inscription prend deux minutes.',
  image = '/media/casiers.jpg',
} = Astro.props;
---
<section class="cta-page grid bg-bordeaux text-creme lg:grid-cols-2" aria-labelledby="page-cta-titre" data-page-cta>
  <div class="flex flex-col items-center justify-center px-6 py-24 text-center sm:px-12 lg:py-32">
    <h2 id="page-cta-titre" class="max-w-xl text-[clamp(1.8rem,3.4vw,2.8rem)]" data-reveal>{titre}</h2>
    <span class="signature mt-2 !text-dore-clair" data-reveal data-reveal-delai="1">deux minutes, pas plus</span>
    <p class="mt-8 max-w-md text-creme/85" data-reveal data-reveal-delai="2">{texte}</p>
    <a href={lienInscription} class="btn btn-creme mt-10" data-reveal data-reveal-delai="3">Rejoindre le programme pilote</a>
  </div>
  <div class="media-cadre zoom-lent min-h-[56vh] lg:min-h-[70vh]" data-reveal="rideau">
    <img src={image} alt="" loading="lazy" decoding="async" />
  </div>
</section>
