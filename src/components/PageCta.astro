---
/** Appel en bas de page vers le pilote. */
import { lienInscription } from '../data/site';
interface Props {
  titre?: string;
  texte?: string;
}
const {
  titre = 'Prêt à essayer avec nous ?',
  texte = 'Quelques lieux, quelques mois, et une équipe qui construit l’outil avec vous. L’inscription prend deux minutes.',
} = Astro.props;
---
<section aria-labelledby="page-cta-titre" class="sur-fond-sombre bg-bordeaux py-16 text-creme lg:py-20" data-page-cta>
  <div class="conteneur flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl" data-reveal>
      <h2 id="page-cta-titre" class="text-[1.9rem] leading-[1.1] font-medium sm:text-4xl">{titre}</h2>
      <p class="mt-4 text-lg text-creme-sourde">{texte}</p>
    </div>
    <a href={lienInscription} class="btn btn-creme w-full sm:w-auto" data-reveal data-reveal-delai="1">
      Rejoindre le programme pilote
    </a>
  </div>
</section>
