---
import TitreSection from './TitreSection.astro';

// Données inventées pour l’illustration : aucun vrai domaine, aucun vrai client.
const facture = [
  { lu: 'Gamay, Vin de France 2023', qte: 12, ok: true },
  { lu: 'Picpoul de Pinet 2023', qte: 12, ok: true },
  { lu: 'Corbières rouge 2021', qte: 6, ok: true },
  { lu: '« CHAB 1ER 22 x6 »', qte: 6, ok: false, proposition: 'Chablis premier cru 2022 ?' },
];

const dormantes = [
  {
    vin: 'Côtes-du-Rhône blanc 2021',
    bouteilles: 18,
    jours: 112,
    piste: 'Au verre',
    suggestion: 'Le proposer au verre cette semaine.',
  },
  {
    vin: 'Bourgogne pinot noir 2020',
    bouteilles: 9,
    jours: 97,
    piste: "À l’ardoise",
    suggestion: "L’inscrire à l’ardoise en suggestion du moment.",
  },
  {
    vin: 'Muscadet sur lie 2022',
    bouteilles: 24,
    jours: 130,
    piste: 'Au comptoir',
    suggestion: 'Le placer en évidence au comptoir, pour la vente à emporter.',
  },
];
---
<section id="exemples" aria-labelledby="exemples-titre" class="border-y border-filet bg-creme-fonce py-20 lg:py-28">
  <div class="conteneur">
    <TitreSection
      numero="4"
      libelle="Concrètement"
      id="exemples-titre"
      titre="Ce que vous verriez passer dans la semaine."
    >
      <p class="mt-5 max-w-2xl text-lg text-encre-douce">
        Trois exemples de propositions, en plus de la commande du haut de page. Les vins, les domaines et les chiffres
        sont inventés ; les boutons ne déclenchent rien.
      </p>
    </TitreSection>

    <div class="mt-12 grid gap-6 lg:grid-cols-3 lg:items-start">
      <!-- 1. Facture lue (mardi) : ticket au bord cranté -->
      <article class="papier bord-crante flex flex-col" data-demo aria-labelledby="ex-facture">
        <header class="flex items-center justify-between gap-3 border-b border-dashed border-filet px-5 py-3">
          <p class="surtitre text-bordeaux">Facture lue</p>
          <p class="cachet text-encre-douce">Exemple</p>
        </header>
        <div class="flex-1 px-5 pt-5 pb-7">
          <h3 id="ex-facture" class="text-xl leading-snug font-medium">Facture de Négociant B</h3>
          <p class="chiffres mt-1 text-[0.8rem] text-encre-douce">Reçue en photo mardi à 10 h 14 · 4 lignes lues</p>
          <ul role="list" class="mt-4">
            {
              facture.map((f) => (
                <li class="ligne-pointillee flex items-start gap-3 py-2.5 first:pt-1">
                  {f.ok ? (
                    <svg width="18" height="18" viewBox="0 0 18 18" class="mt-1 shrink-0 text-vert" role="img" aria-label="Reconnue">
                      <path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="1.8" />
                    </svg>
                  ) : (
                    <span
                      class="mt-0.5 grid h-[18px] w-[18px] shrink-0 place-items-center rounded-full border-[1.5px] border-bordeaux font-serif text-[0.75rem] font-semibold text-bordeaux"
                      role="img"
                      aria-label="À confirmer"
                    >
                      ?
                    </span>
                  )}
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline justify-between gap-3">
                      <span class:list={['font-semibold', !f.ok && 'chiffres text-[0.875rem]']}>{f.lu}</span>
                      <span class="chiffres shrink-0 text-[0.875rem] text-encre-douce" aria-label={`${f.qte} bouteilles`}>
                        × {f.qte}
                      </span>
                    </div>
                    {f.proposition && (
                      <p class="mt-1 text-[0.95rem] leading-snug">
                        Cuvée propose : <span class="font-semibold">{f.proposition}</span>
                      </p>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="mt-3 text-[0.9rem] text-encre-douce">3 lignes ajoutées au stock, 1 à confirmer par vous.</p>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <button
              type="button"
              class="btn btn-primaire btn-mini"
              data-demo-action="valider"
              data-demo-message="Confirmé : la ligne serait ajoutée au stock. Ici, c’est une démonstration."
            >
              Oui, c’est bien ça
            </button>
            <button
              type="button"
              class="btn btn-contour btn-mini"
              data-demo-action="corriger"
              data-demo-message="Vous choisiriez la bonne référence dans votre cave."
            >
              Corriger
            </button>
          </div>
          <p class="mt-3 min-h-[1.25rem] text-[0.875rem] text-vert" role="status" data-demo-statut></p>
        </div>
        <span class="tampon top-1/2 right-6" aria-hidden="true">Confirmé</span>
      </article>

      <!-- 2. Bouteilles qui dorment (mercredi) : fiche de cave perforée -->
      <article class="papier flex flex-col" data-demo aria-labelledby="ex-dormantes">
        <div class="perforation" aria-hidden="true"></div>
        <header class="flex items-center justify-between gap-3 border-b border-filet px-5 py-3">
          <p class="surtitre text-bordeaux">Bouteilles qui dorment</p>
          <p class="cachet text-encre-douce">Exemple</p>
        </header>
        <div class="flex-1 px-5 pt-5 pb-6">
          <h3 id="ex-dormantes" class="text-xl leading-snug font-medium">
            3 références sans vente depuis plus de 90 jours
          </h3>
          <p class="chiffres mt-1 text-[0.8rem] text-encre-douce">
            Mercredi à 8 h 30 · 51 bouteilles, 462 € au prix d’achat
          </p>
          <ul role="list" class="mt-4">
            {
              dormantes.map((d) => (
                <li class="ligne-pointillee py-3 first:pt-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="font-semibold">{d.vin}</span>
                    <span class="chiffres shrink-0 text-[0.875rem] text-encre-douce" aria-label={`${d.bouteilles} bouteilles`}>
                      × {d.bouteilles}
                    </span>
                  </div>
                  <p class="chiffres text-[0.8rem] text-encre-douce">Dernière vente il y a {d.jours} jours</p>
                  <p class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[0.95rem] leading-snug">
                    <span class="cachet text-bordeaux">{d.piste}</span>
                    <span>{d.suggestion}</span>
                  </p>
                </li>
              ))
            }
          </ul>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <button
              type="button"
              class="btn btn-primaire btn-mini"
              data-demo-action="valider"
              data-demo-message="Idées retenues. Ici, c’est une démonstration : rien n’a changé dans votre cave."
            >
              Retenir ces idées
            </button>
            <button
              type="button"
              class="btn btn-contour btn-mini"
              data-demo-action="plus-tard"
              data-demo-message="Mis de côté : Cuvée vous le reproposerait plus tard."
            >
              Plus tard
            </button>
          </div>
          <p class="mt-3 min-h-[1.25rem] text-[0.875rem] text-vert" role="status" data-demo-statut></p>
        </div>
        <span class="tampon top-1/2 right-6" aria-hidden="true">Retenu</span>
      </article>

      <!-- 3. Livraison en retard (jeudi) : lettre sur papier ligné -->
      <article class="papier flex flex-col" data-demo aria-labelledby="ex-relance">
        <header class="flex items-center justify-between gap-3 border-b border-filet px-5 py-3">
          <p class="surtitre text-bordeaux">Livraison en retard</p>
          <p class="cachet text-encre-douce">Exemple</p>
        </header>
        <div class="flex-1 px-5 pt-5 pb-6">
          <h3 id="ex-relance" class="text-xl leading-snug font-medium">Domaine C · Languedoc</h3>
          <p class="chiffres mt-1 text-[0.8rem] text-encre-douce">
            Jeudi à 9 h 00 · commande du 22 sept., promise le 29. Toujours rien reçu.
          </p>
          <p class="mt-4 text-[0.95rem] text-encre-douce">Message préparé, à relire avant envoi :</p>
          <blockquote class="papier-ligne mt-2 border-l-2 border-bordeaux/40 pl-4 text-[1rem]">
            Bonjour, notre commande du 22 septembre (36 bouteilles, 6 cartons) devait arriver le 29 et nous n’avons rien
            reçu. Pouvez-vous nous donner une date de livraison ? Merci.
          </blockquote>
          <p class="mt-3 text-[0.875rem] text-encre-douce">
            Envoi par WhatsApp à votre contact au domaine, après votre validation.
          </p>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <button
              type="button"
              class="btn btn-primaire btn-mini"
              data-demo-action="valider"
              data-demo-message="Relance validée : elle partirait maintenant. Ici, c’est une démonstration."
            >
              Envoyer la relance
            </button>
            <button
              type="button"
              class="btn btn-contour btn-mini"
              data-demo-action="modifier"
              data-demo-message="Vous pourriez réécrire le message avec vos mots avant l’envoi."
            >
              Modifier le message
            </button>
          </div>
          <p class="mt-3 min-h-[1.25rem] text-[0.875rem] text-vert" role="status" data-demo-statut></p>
        </div>
        <span class="tampon top-1/2 right-6" aria-hidden="true">Validé</span>
      </article>
    </div>
  </div>
</section>
