---
import TitreSection from './TitreSection.astro';

// Données inventées pour l’illustration : aucun vrai domaine, aucun vrai client.
const facture = [
  { lu: 'Gamay, Vin de France 2023', qte: 12, ok: true },
  { lu: 'Picpoul de Pinet 2023', qte: 12, ok: true },
  { lu: 'Corbières rouge 2021', qte: 6, ok: true },
  { lu: '« CHAB 1ER 22 x6 »', qte: 6, ok: false, proposition: 'Chablis premier cru 2022 ?' },
];

const dormantes = [
  {
    vin: 'Côtes-du-Rhône blanc 2021',
    bouteilles: 18,
    jours: 112,
    piste: 'Au verre',
    suggestion: 'Le proposer au verre cette semaine.',
  },
  {
    vin: 'Bourgogne pinot noir 2020',
    bouteilles: 9,
    jours: 97,
    piste: "À l’ardoise",
    suggestion: "L’inscrire à l’ardoise en suggestion du moment.",
  },
  {
    vin: 'Muscadet sur lie 2022',
    bouteilles: 24,
    jours: 130,
    piste: 'Au comptoir',
    suggestion: 'Le placer en évidence au comptoir, pour la vente à emporter.',
  },
];

const jours = [
  { cle: 'mardi', nom: 'Mardi', sujet: 'Facture lue' },
  { cle: 'mercredi', nom: 'Mercredi', sujet: 'Bouteilles qui dorment' },
  { cle: 'jeudi', nom: 'Jeudi', sujet: 'Livraison en retard' },
];
---
<section id="exemples" aria-labelledby="exemples-titre" class="exemples sur-fond-sombre section bg-chai text-creme">
  <div class="conteneur">
    <TitreSection
      libelle="Concrètement"
      id="exemples-titre"
      titre="Ce que vous verriez passer dans la semaine."
      chapo="Trois exemples de propositions, en plus de la commande présentée sur l’accueil. Les vins, les domaines et les chiffres sont inventés ; les boutons ne déclenchent rien."
      sombre
    />

    <!-- Sélecteur de jour : affiché par le script sur mobile seulement (sans JavaScript, les trois fiches restent visibles). -->
    <div class="onglets-jours mt-12 lg:hidden" role="tablist" aria-label="Exemples par jour" data-onglets hidden>
      {
        jours.map((j, i) => (
          <button
            type="button"
            role="tab"
            id={`onglet-${j.cle}`}
            class="onglet-jour"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-onglet={i}
          >
            <span class="surtitre">{j.nom}</span>
            <span class="onglet-sous">{j.sujet}</span>
          </button>
        ))
      }
    </div>

    <p class="petit mt-12 hidden text-creme/85 lg:block" id="consigne-fiches" data-reveal data-reveal-delai="5">
      Cliquez sur une fiche (ou sélectionnez-la au clavier, Entrée) pour la mettre en avant. Échap, ou un clic ailleurs, la repose.
    </p>
    <div class="table-ex mt-6 lg:mt-6">
    <div class="grille-exemples grid gap-6 lg:grid-cols-3 lg:items-stretch" data-grille-exemples>
      <!-- 1. Facture lue (mardi) : ticket au bord cranté -->
      <article class="papier fiche flex flex-col carte-ex" tabindex="0" aria-describedby="consigne-fiches" data-demo data-reveal data-reveal-delai="1" aria-labelledby="ex-facture">
        <header class="flex items-center justify-between gap-3 border-b border-filet px-5 py-4">
          <p class="surtitre text-bordeaux">Facture lue</p>
          <p class="cachet text-encre-douce">Exemple</p>
        </header>
        <div class="flex flex-1 flex-col px-5 pt-6 pb-6">
          <h3 id="ex-facture">Facture de Négociant B</h3>
          <p class="petit mt-2 text-encre-douce">Reçue en photo mardi à 10 h 14 · 4 lignes lues</p>
          <ul role="list" class="mt-5">
            {
              facture.map((f) => (
                <li class="ligne-pointillee flex items-start gap-3 py-2.5 first:pt-1">
                  {f.ok ? (
                    <svg width="18" height="18" viewBox="0 0 18 18" class="mt-1 shrink-0 text-vert" role="img" aria-label="Reconnue">
                      <path d="M3.5 9.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="1.8" />
                    </svg>
                  ) : (
                    <span
                      class="mt-0.5 grid h-[18px] w-[18px] shrink-0 place-items-center rounded-full border-[1.5px] border-bordeaux text-[0.75rem] font-semibold text-bordeaux"
                      role="img"
                      aria-label="À confirmer"
                    >
                      ?
                    </span>
                  )}
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline justify-between gap-3">
                      <span class:list={['font-semibold', !f.ok && 'nombre text-[0.875rem]']}>{f.lu}</span>
                      <span class="nombre shrink-0 text-[0.875rem] text-encre-douce" aria-label={`${f.qte} bouteilles`}>
                        × {f.qte}
                      </span>
                    </div>
                    {f.proposition && (
                      <p class="mt-1 text-[1rem] leading-snug">
                        Cuvée propose : <span class="font-semibold">{f.proposition}</span>
                      </p>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="mt-3 text-[0.9rem] text-encre-douce">3 lignes ajoutées au stock, 1 à confirmer par vous.</p>
          <div class="mt-auto flex flex-wrap gap-3 pt-6">
            <button
              type="button"
              class="btn btn-primaire btn-mini"
              data-demo-action="valider"
              data-demo-message="Confirmé : la ligne serait ajoutée au stock. Ici, c’est une démonstration."
            >
              Oui, c’est bien ça
            </button>
            <button
              type="button"
              class="btn btn-contour btn-mini"
              data-demo-action="corriger"
              data-demo-message="Vous choisiriez la bonne référence dans votre cave."
            >
              Corriger
            </button>
          </div>
          <p class="mt-3 min-h-[1.5rem] text-[0.875rem] text-vert" role="status" data-demo-statut></p>
        </div>
        <span class="tampon top-1/2 right-5" aria-hidden="true">Confirmé</span>
      </article>

      <!-- 2. Bouteilles qui dorment (mercredi) : fiche de cave perforée -->
      <article class="papier fiche flex flex-col carte-ex" tabindex="0" aria-describedby="consigne-fiches" data-demo data-reveal data-reveal-delai="2" aria-labelledby="ex-dormantes">
        <header class="flex items-center justify-between gap-3 border-b border-filet px-5 py-4">
          <p class="surtitre text-bordeaux">Bouteilles qui dorment</p>
          <p class="cachet text-encre-douce">Exemple</p>
        </header>
        <div class="flex flex-1 flex-col px-5 pt-6 pb-6">
          <h3 id="ex-dormantes">
            3 références sans vente depuis plus de 90 jours
          </h3>
          <p class="petit mt-2 text-encre-douce">
            Mercredi à 8 h 30 · 51 bouteilles, 462 € au prix d’achat
          </p>
          <ul role="list" class="mt-5">
            {
              dormantes.map((d) => (
                <li class="ligne-pointillee py-3 first:pt-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="font-semibold">{d.vin}</span>
                    <span class="nombre shrink-0 text-[0.875rem] text-encre-douce" aria-label={`${d.bouteilles} bouteilles`}>
                      × {d.bouteilles}
                    </span>
                  </div>
                  <p class="nombre text-[0.875rem] text-encre-douce">Dernière vente il y a {d.jours} jours</p>
                  <p class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[1rem] leading-snug">
                    <span class="cachet text-bordeaux">{d.piste}</span>
                    <span>{d.suggestion}</span>
                  </p>
                </li>
              ))
            }
          </ul>
          <div class="mt-auto flex flex-wrap gap-3 pt-6">
            <button
              type="button"
              class="btn btn-primaire btn-mini"
              data-demo-action="valider"
              data-demo-message="Idées retenues. Ici, c’est une démonstration : rien n’a changé dans votre cave."
            >
              Retenir ces idées
            </button>
            <button
              type="button"
              class="btn btn-contour btn-mini"
              data-demo-action="plus-tard"
              data-demo-message="Mis de côté : Cuvée vous le reproposerait plus tard."
            >
              Plus tard
            </button>
          </div>
          <p class="mt-3 min-h-[1.5rem] text-[0.875rem] text-vert" role="status" data-demo-statut></p>
        </div>
        <span class="tampon top-1/2 right-5" aria-hidden="true">Retenu</span>
      </article>

      <!-- 3. Livraison en retard (jeudi) : lettre sur papier ligné -->
      <article class="papier fiche flex flex-col carte-ex" tabindex="0" aria-describedby="consigne-fiches" data-demo data-reveal data-reveal-delai="3" aria-labelledby="ex-relance">
        <header class="flex items-center justify-between gap-3 border-b border-filet px-5 py-4">
          <p class="surtitre text-bordeaux">Livraison en retard</p>
          <p class="cachet text-encre-douce">Exemple</p>
        </header>
        <div class="flex flex-1 flex-col px-5 pt-6 pb-6">
          <h3 id="ex-relance">Domaine C · Languedoc</h3>
          <p class="petit mt-2 text-encre-douce">
            Jeudi à 9 h 00 · commande du 22 sept., promise le 29. Toujours rien reçu.
          </p>
          <p class="mt-4 text-[1rem] text-encre-douce">Message préparé, à relire avant envoi :</p>
          <blockquote class="papier-ligne mt-2 border-l-2 border-bordeaux/40 pl-4 text-[1rem]">
            Bonjour, notre commande du 22 septembre (36 bouteilles, 6 cartons) devait arriver le 29 et nous n’avons rien
            reçu. Pouvez-vous nous donner une date de livraison ? Merci.
          </blockquote>
          <p class="mt-3 text-[0.875rem] text-encre-douce">
            Envoi par WhatsApp à votre contact au domaine, après votre validation.
          </p>
          <div class="mt-auto flex flex-wrap gap-3 pt-6">
            <button
              type="button"
              class="btn btn-primaire btn-mini"
              data-demo-action="valider"
              data-demo-message="Relance validée : elle partirait maintenant. Ici, c’est une démonstration."
            >
              Envoyer la relance
            </button>
            <button
              type="button"
              class="btn btn-contour btn-mini"
              data-demo-action="modifier"
              data-demo-message="Vous pourriez réécrire le message avec vos mots avant l’envoi."
            >
              Modifier le message
            </button>
          </div>
          <p class="mt-3 min-h-[1.5rem] text-[0.875rem] text-vert" role="status" data-demo-statut></p>
        </div>
        <span class="tampon top-1/2 right-5" aria-hidden="true">Validé</span>
      </article>
    </div>
    </div>
  </div>
</section>

<style is:global>
  /* Fiches : papier posé sur fond sombre. Même gabarit, mêmes hauteurs ; le contenu passe en Outfit, les étiquettes en Josefin. */
  .carte-ex {
    padding: 0;
    color: var(--color-encre);
    cursor: pointer;
    transition:
      translate var(--duree-2) var(--ease-sortie),
      box-shadow var(--duree-2) ease,
      opacity var(--duree-2) ease;
  }
  .carte-ex .nombre {
    font-variant-numeric: tabular-nums;
  }
  .carte-ex .btn {
    cursor: pointer;
  }
  .carte-ex :is(button, a) {
    position: relative;
    z-index: 1;
  }
  /* survol : la fiche se soulève (ombre niveau 2) */
  @media (hover: hover) {
    .carte-ex:hover {
      translate: 0 -4px;
      box-shadow: var(--ombre-2);
    }
  }
  /* focus clavier sur la fiche : anneau doré clair (2 px, décalé de 3 px) */
  .carte-ex:focus-visible {
    outline: 2px solid var(--color-dore-clair);
    outline-offset: 3px;
  }
  /* fiche en main (clic, ou Entrée au clavier) ou boutons au focus : elle se soulève et le reste s’efface un peu */
  .carte-ex.est-pris,
  .carte-ex:focus-within {
    translate: 0 -6px;
    box-shadow: var(--ombre-2);
    border-color: var(--color-dore);
    z-index: 3;
  }
  .carte-ex:active {
    translate: 0 -2px;
  }
  @media (min-width: 64rem) {
    .table-ex:has(.est-pris) .carte-ex:not(.est-pris) {
      opacity: 0.75;
    }
  }
  .carte-ex.est-valide {
    border-color: var(--color-vert);
  }

  /* Tampon « Confirmé / Retenu / Validé » : il tombe sur la fiche */
  .carte-ex .tampon {
    background: var(--color-papier);
  }
  .est-valide .tampon {
    animation: tampon-tombe 0.4s var(--ease-sortie) forwards;
  }
  @keyframes tampon-tombe {
    from { opacity: 0; transform: rotate(-4deg) scale(1.8); }
    to { opacity: 0.95; transform: rotate(-11deg) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .carte-ex { transition: none; }
    .est-valide .tampon { animation: none; opacity: 0.95; transform: rotate(-11deg); }
  }

  /* Sélecteur d’onglets (mobile), sur fond sombre */
  .onglets-jours {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid color-mix(in srgb, var(--color-creme) 30%, transparent);
  }
  .onglets-jours[hidden] { display: none; }
  .onglet-jour {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-2) var(--space-3);
    text-align: left;
    color: var(--creme-85);
    cursor: pointer;
    transition: color var(--duree-1) ease, background-color var(--duree-1) ease;
  }
  .onglet-jour .surtitre { letter-spacing: 0.12em; font-size: 0.75rem; color: inherit; }
  .onglet-jour::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 3px;
    background: var(--color-dore-clair);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duree-2) var(--ease-sortie);
  }
  .onglet-jour[aria-selected="true"] { color: var(--color-creme); }
  .onglet-jour[aria-selected="true"]::after { transform: scaleX(1); }
  .onglet-jour:focus-visible { outline: 2px solid var(--color-dore-clair); outline-offset: -3px; }
  .onglet-sous { font-size: 0.875rem; line-height: 1.25; }
  .onglet-jour:hover { background: color-mix(in srgb, var(--color-creme) 8%, transparent); }

  @media (max-width: 63.99rem) {
    .grille-exemples[data-onglets-actifs] > article[data-actif="false"] { display: none; }
    .grille-exemples[data-onglets-actifs] { margin-top: var(--space-5); }
    .grille-exemples[data-onglets-actifs] > article[data-actif="true"] { animation: carte-entre var(--duree-3) var(--ease-sortie) both; }
    .carte-ex { cursor: default; }
  }
  @keyframes carte-entre {
    from { opacity: 0; translate: 0 10px; }
  }
</style>

<script>
  import '../scripts/demo.ts';
</script>
