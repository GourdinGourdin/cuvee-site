---
import TitreSection from './TitreSection.astro';

const etapes = [
  {
    titre: 'Vous gardez votre caisse et vos factures',
    texte:
      "Cuvée se connecte à votre caisse pour suivre ce qui se vend. Pour ce qui entre, il lit vos factures, en photo ou en PDF, et vous soumet les lignes douteuses. L’inventaire se tient à jour.",
    detail: "Caisses visées en premier : Lightspeed, Zelty, L’Addition.",
  },
  {
    titre: 'Cuvée suit la cave pour vous',
    texte:
      'Il compare ce qui sort et ce qui reste, voit venir les ruptures, repère les références qui ne bougent plus et garde un œil sur les livraisons attendues.',
    detail: 'Vous fixez les seuils : stock minimum par référence, délai avant alerte.',
  },
  {
    titre: 'Rien ne part avant votre feu vert',
    texte:
      'Vous recevez des propositions : une commande prête, une idée pour écouler un carton, une relance à un domaine. Vous validez, vous modifiez ou vous refusez.',
    detail: 'Une fois validés, commandes et relances partent par email ou WhatsApp.',
  },
];
---
<section id="fonctionnement" aria-labelledby="fonctionnement-titre" class="py-20 lg:py-28">
  <div class="conteneur">
    <TitreSection
      numero="3"
      libelle="Comment ça marche"
      id="fonctionnement-titre"
      titre="Ça part de ce que vous avez déjà."
    >
      <p class="mt-5 max-w-2xl text-lg text-encre-douce">
        L’idée : ne pas vous faire changer de caisse, ni tout ressaisir. Cuvée est en construction ; voici comment il
        est conçu.
      </p>
    </TitreSection>

    <ol role="list" class="fil-etapes mt-14 grid gap-12 lg:grid-cols-3 lg:gap-10" data-fil>
      {
        etapes.map((etape, i) => (
          <li class="fil-etape relative pl-9 lg:pl-0" data-reveal data-reveal-delai={String(i + 1)}>
            {/* Segment de fil : vertical sur mobile, horizontal sur grand écran. Il se dessine au scroll. */}
            {i < etapes.length - 1 && (
              <svg class="fil-v" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <line x1="1" y1="0" x2="1" y2="100" pathLength="1" vector-effect="non-scaling-stroke" />
              </svg>
            )}
            <span class="fil-point" aria-hidden="true" />
            <div class="fil-entete relative flex items-end gap-4 border-b border-filet pb-4">
              <span class="fil-numero font-serif text-[5.5rem] leading-[0.78] font-light text-bordeaux italic" aria-hidden="true">
                {i + 1}
              </span>
              <span class="surtitre pb-1 text-encre-douce">Étape {i + 1} sur 3</span>
              {i < etapes.length - 1 && (
                <svg class="fil-h" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <line x1="0" y1="1" x2="100" y2="1" pathLength="1" vector-effect="non-scaling-stroke" />
                </svg>
              )}
            </div>
            <h3 class="mt-5 text-2xl leading-snug font-medium">{etape.titre}</h3>
            <p class="mt-3 text-encre-douce">{etape.texte}</p>
            <p class="mt-4 flex gap-2 text-[0.92rem] leading-snug">
              <svg width="16" height="16" viewBox="0 0 16 16" class="mt-0.5 shrink-0 text-vert" aria-hidden="true">
                <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.8" />
              </svg>
              <span>{etape.detail}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .fil-etape .fil-v,
  .fil-etape .fil-h {
    position: absolute;
    pointer-events: none;
    overflow: visible;
  }
  .fil-etape line {
    stroke: var(--color-bordeaux);
    stroke-width: 2px;
    stroke-dasharray: 1;
    /* sans JavaScript, le fil est entièrement tracé */
    stroke-dashoffset: calc(1 - var(--p, 1));
    stroke-linecap: round;
  }
  /* fil vertical (mobile) : de la pastille à la pastille suivante */
  .fil-etape .fil-v {
    left: 0.45rem;
    top: 0.6rem;
    width: 2px;
    height: calc(100% + 3rem);
  }
  .fil-etape .fil-h {
    display: none;
  }
  .fil-point {
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    border: 2px solid var(--color-bordeaux);
    background: var(--color-creme);
    transition: background-color 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  }
  .fil-actif .fil-point.fil-allume {
    background: var(--color-bordeaux);
    transform: scale(1.15);
  }
  .fil-numero {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .fil-etape:hover .fil-numero {
    transform: translateY(-3px) rotate(-3deg);
  }
  @media (min-width: 64rem) {
    .fil-etape .fil-v {
      display: none;
    }
    .fil-point {
      display: none;
    }
    .fil-etape .fil-h {
      display: block;
      left: 0;
      bottom: -1px;
      height: 2px;
      width: calc(100% + 2.5rem);
    }
    .fil-etape .fil-entete {
      /* le filet de base reste visible sous le fil bordeaux */
      border-color: var(--color-filet);
    }
    .fil-etape .fil-entete::before {
      content: "";
      position: absolute;
      left: 0;
      bottom: -5px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--color-bordeaux);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fil-etape line {
      stroke-dashoffset: 0 !important;
    }
  }
</style>

<script>
  const liste = document.querySelector<HTMLElement>('[data-fil]');
  if (liste && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const etapes = Array.from(liste.querySelectorAll<HTMLElement>('.fil-etape'));
    liste.classList.add('fil-actif');
    let attente = false;
    const maj = () => {
      attente = false;
      const r = liste.getBoundingClientRect();
      const vh = window.innerHeight;
      // le fil avance quand la liste monte vers le milieu de l’écran
      const p = Math.min(1, Math.max(0, (vh * 0.78 - r.top) / Math.max(r.height, 1)));
      etapes.forEach((li, i) => {
        const seg = Math.min(1, Math.max(0, p * etapes.length - i));
        li.style.setProperty('--p', seg.toFixed(3));
        li.querySelector('.fil-point')?.classList.toggle('fil-allume', p * etapes.length > i + 0.02);
      });
    };
    const demande = () => {
      if (!attente) {
        attente = true;
        requestAnimationFrame(maj);
      }
    };
    maj();
    addEventListener('scroll', demande, { passive: true });
    addEventListener('resize', demande);
  }
</script>
