---
/** Les trois étapes : un média et un texte par ligne, en alternance, sur la grille de 12 colonnes. */
import TitreSection from './TitreSection.astro';
import Photo from './Photo.astro';
import Video from './maison/Video.astro';

const etapes = [
  {
    surtitre: 'Étape I · Ce qui entre',
    titre: 'Vous gardez votre caisse et vos factures',
    texte:
      "Cuvée se connecte à votre caisse pour suivre ce qui se vend. Pour ce qui entre, il lit vos factures, en photo ou en PDF, et vous soumet les lignes douteuses. L’inventaire se tient à jour.",
    detail: "Caisses visées en premier : Lightspeed, Zelty, L’Addition.",
    video: 'carnet',
  },
  {
    surtitre: 'Étape II · Ce qui reste',
    titre: 'Cuvée suit la cave pour vous',
    texte:
      'Il compare ce qui sort et ce qui reste, voit venir les ruptures, repère les références qui ne bougent plus et garde un œil sur les livraisons attendues.',
    detail: 'Vous fixez les seuils : stock minimum par référence, délai avant alerte.',
    image: 'casiers',
  },
  {
    surtitre: 'Étape III · Ce qui part',
    titre: 'Rien ne part avant votre feu vert',
    texte:
      'Vous recevez des propositions : une commande prête, une idée pour écouler un carton, une relance à un domaine. Vous validez, vous modifiez ou vous refusez.',
    detail: 'Une fois validés, commandes et relances partent par email ou WhatsApp.',
    video: 'livraison',
  },
];
---
<section id="fonctionnement" aria-labelledby="fonctionnement-titre" class="section bg-creme">
  <div class="conteneur">
    <TitreSection
      libelle="Le fonctionnement"
      id="fonctionnement-titre"
      titre="Ça part de ce que vous avez déjà."
      chapo="L’idée : ne pas vous faire changer de caisse, ni tout ressaisir. Cuvée est en construction ; voici comment il est conçu."
    />

    <ol role="list" class="etapes mt-12 lg:mt-16">
      {
        etapes.map((e, i) => (
          <li class:list={['etape', i % 2 === 1 && 'etape-alt']}>
            <div class="etape-media media-cadre zoom-lent" data-reveal="rideau">
              {e.video ? (
                <Video src={`/media/${e.video}.mp4`} affiche={`/media/${e.video}-poster.jpg`} sizes="(min-width: 1024px) 50vw, 100vw" />
              ) : (
                <Photo src={`/media/${e.image}.jpg`} alt="" sizes="(min-width: 1024px) 50vw, 100vw" />
              )}
            </div>

            <div class="etape-texte">
              <p class="surtitre" data-reveal>{e.surtitre}</p>
              <h3 class="mt-4" data-reveal data-reveal-delai="1">{e.titre}</h3>
              <p class="texte-courant mt-4" data-reveal data-reveal-delai="2">{e.texte}</p>
              <p class="etape-detail petit mt-6 border-t border-dore pt-4 font-semibold text-encre" data-reveal data-reveal-delai="3">{e.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  .etapes {
    display: grid;
    gap: var(--space-8);
  }
  .etape {
    display: grid;
    gap: var(--space-5);
  }
  .etape-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--rayon);
  }
  .etape-texte {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 64rem) {
    .etapes {
      gap: var(--space-9);
    }
    .etape {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
      align-items: center;
    }
    .etape-media {
      grid-column: 1 / span 6;
      grid-row: 1;
    }
    .etape-texte {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .etape-alt .etape-media {
      grid-column: 7 / span 6;
    }
    .etape-alt .etape-texte {
      grid-column: 1 / span 5;
    }
  }
</style>
