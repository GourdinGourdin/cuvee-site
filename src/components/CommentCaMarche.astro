---
import FonctionnementTitre from './FonctionnementTitre.astro';
import FonctionnementScene from './FonctionnementScene.astro';

const etapes = [
  {
    titre: 'Vous gardez votre caisse et vos factures',
    texte:
      "Cuvée se connecte à votre caisse pour suivre ce qui se vend. Pour ce qui entre, il lit vos factures, en photo ou en PDF, et vous soumet les lignes douteuses. L’inventaire se tient à jour.",
    detail: "Caisses visées en premier : Lightspeed, Zelty, L’Addition.",
  },
  {
    titre: 'Cuvée suit la cave pour vous',
    texte:
      'Il compare ce qui sort et ce qui reste, voit venir les ruptures, repère les références qui ne bougent plus et garde un œil sur les livraisons attendues.',
    detail: 'Vous fixez les seuils : stock minimum par référence, délai avant alerte.',
  },
  {
    titre: 'Rien ne part avant votre feu vert',
    texte:
      'Vous recevez des propositions : une commande prête, une idée pour écouler un carton, une relance à un domaine. Vous validez, vous modifiez ou vous refusez.',
    detail: 'Une fois validés, commandes et relances partent par email ou WhatsApp.',
  },
];
---
<section id="fonctionnement" aria-labelledby="fonctionnement-titre" class="fct-section py-20 lg:py-28" data-scrolly>
  <div class="conteneur">
    <FonctionnementTitre numero="01" libelle="Le fonctionnement" id="fonctionnement-titre" titre="Ça part de ce que vous avez déjà.">
      <p class="mt-5 max-w-2xl text-lg text-encre-douce" data-reveal data-reveal-delai="2">
        L’idée : ne pas vous faire changer de caisse, ni tout ressaisir. Cuvée est en construction ; voici comment il
        est conçu.
      </p>
    </FonctionnementTitre>

    <div class="fct-scrolly mt-14 lg:mt-20">
      <div class="fct-scene-col" aria-hidden="true">
        <div class="fct-stage">
          <span class="fct-stage-num" data-stage-num>1</span>
          <div class="fct-stage-scenes">
            {[1, 2, 3].map((n) => <FonctionnementScene n={n as 1 | 2 | 3} />)}
          </div>
        </div>
      </div>

      <ol role="list" class="fct-etapes">
        {
          etapes.map((etape, i) => (
            <li class="fct-etape" data-etape={i}>
              <div class="fct-etape-inline lg:hidden" aria-hidden="true">
                <FonctionnementScene n={(i + 1) as 1 | 2 | 3} />
              </div>
              <div class="flex items-end gap-4 border-b border-filet pb-4" data-reveal>
                <span class="fct-num font-serif text-[4.5rem] leading-[0.78] font-light text-bordeaux italic sm:text-[5.5rem]" aria-hidden="true">{i + 1}</span>
                <span class="surtitre pb-1 text-encre-douce">Étape {i + 1} sur 3</span>
              </div>
              <h3 class="mt-5 text-2xl leading-snug font-medium sm:text-[1.7rem]" data-reveal data-reveal-delai="1">{etape.titre}</h3>
              <p class="mt-3 text-encre-douce" data-reveal data-reveal-delai="2">{etape.texte}</p>
              <p class="mt-4 flex gap-2 text-[0.92rem] leading-snug" data-reveal data-reveal-delai="3">
                <svg width="16" height="16" viewBox="0 0 16 16" class="mt-0.5 shrink-0 text-vert" aria-hidden="true">
                  <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.8" />
                </svg>
                <span>{etape.detail}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style is:global>
  .fct-scrolly { display: block; }
  .fct-scene-col { display: none; }
  .fct-etapes { display: grid; gap: 4rem; }
  .fct-etape-inline {
    max-width: 22rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--color-creme-fonce);
    border: 1px solid var(--color-filet);
    border-radius: 2px;
  }
  .fct-etape { position: relative; }
  @media (min-width: 64rem) {
    .scrolly-js .fct-etape-inline { display: none; }
    .scrolly-js .fct-scrolly { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4.5rem; align-items: start; }
    .scrolly-js .fct-scene-col { display: block; position: sticky; top: 7rem; }
    .fct-stage {
      position: relative;
      padding: 2.25rem;
      background: var(--color-creme-fonce);
      border: 1px solid var(--color-filet);
      outline: 1px solid var(--color-dore);
      outline-offset: -9px;
    }
    .fct-stage-num {
      position: absolute; top: 0.6rem; right: 1.4rem;
      font-family: var(--font-serif); font-style: italic; font-weight: 300;
      font-size: 4rem; line-height: 1; color: var(--color-bordeaux); opacity: 0.85;
    }
    .fct-stage-scenes { display: grid; }
    .fct-stage-scenes > .scene { grid-area: 1 / 1; opacity: 0; transition: opacity 0.5s ease; }
    .fct-stage-scenes > .scene.est-active { opacity: 1; }
    .scrolly-js .fct-etapes { gap: 0; }
    .scrolly-js .fct-etape { min-height: 26rem; padding-top: 1rem; }
    .scrolly-js .fct-etape:last-child { min-height: 0; padding-bottom: 6rem; }
    .scrolly-js .fct-etape .fct-num { opacity: 0.3; transition: opacity 0.5s ease; }
    .scrolly-js .fct-etape.est-courante .fct-num { opacity: 1; }
    .scrolly-js .fct-etape::before {
      content: ""; position: absolute; left: -2.25rem; top: 0; bottom: 0; width: 1px; background: var(--color-filet);
    }
    .scrolly-js .fct-etape.est-courante::before { background: var(--color-dore); width: 2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fct-stage-scenes > .scene { transition: none; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-scrolly]');
  if (section && 'IntersectionObserver' in window) {
    const etapes = Array.from(section.querySelectorAll<HTMLElement>('.fct-etape'));
    const stage = Array.from(section.querySelectorAll<SVGElement>('.fct-stage-scenes .scene'));
    const inline = Array.from(section.querySelectorAll<SVGElement>('.fct-etape-inline .scene'));
    const num = section.querySelector<HTMLElement>('[data-stage-num]');
    section.classList.add('scrolly-js');
    const activer = (i: number) => {
      etapes.forEach((e, k) => e.classList.toggle('est-courante', k === i));
      stage.forEach((s, k) => s.classList.toggle('est-active', k === i));
      if (num) num.textContent = String(i + 1);
    };
    activer(0);
    // bande de lecture au centre de l’écran
    const obs = new IntersectionObserver(
      (entrees) => {
        for (const e of entrees) if (e.isIntersecting) activer(etapes.indexOf(e.target as HTMLElement));
      },
      { rootMargin: '-40% 0px -45% 0px' },
    );
    etapes.forEach((e) => obs.observe(e));
    // mobile : chaque scène se joue une fois en entrant
    const obsInline = new IntersectionObserver(
      (entrees) => {
        for (const e of entrees) if (e.isIntersecting) { e.target.classList.add('est-active'); obsInline.unobserve(e.target); }
      },
      { threshold: 0.4 },
    );
    inline.forEach((s) => obsInline.observe(s));
  }
</script>
