---
import BonDeCommande from './BonDeCommande.astro';
import ACompleter from './ACompleter.astro';
---
<section aria-labelledby="hero-titre" class="hero relative overflow-hidden">
  <!-- halo bordeaux très discret -->
  <div class="pointer-events-none absolute -top-32 -right-40 h-[34rem] w-[34rem] rounded-full bg-bordeaux/[0.06] blur-3xl" aria-hidden="true"></div>

  <div class="conteneur relative pt-6 pb-16 sm:pt-9 lg:pb-24">
    <!-- bandeau de magazine -->
    <div class="surtitre flex items-center gap-3 border-b border-encre pb-3 text-encre-douce" data-reveal>
      <span class="text-bordeaux">Cuvée</span>
      <span class="h-px flex-1 bg-dore" aria-hidden="true"></span>
      <span class="hidden sm:inline">Caves à manger &amp; bars à vin</span>
      <span class="sm:hidden">Programme pilote</span>
    </div>

    <div class="mt-9 grid gap-14 lg:mt-14 lg:grid-cols-[minmax(0,1.12fr)_minmax(0,0.88fr)] lg:gap-16">
      <div>
        <p class="surtitre text-bordeaux" data-reveal>Pour les caves à manger et les bars à vin</p>

        <!-- Test de message : ?v=b affiche la variante B (voir le script dans Base.astro). -->
        <h1
          id="hero-titre"
          class="hero-titre mt-5 text-[2.5rem] leading-[1.03] font-light tracking-[-0.025em] sm:text-[4rem] lg:text-[4.75rem]"
        >
          <span class="titre-a">
            Moins de bouteilles qui <em class="font-normal text-bordeaux">dorment</em>, moins d’heures sur les commandes.
          </span>
          <span class="titre-b">
            Et si vos commandes aux domaines étaient prêtes <em class="font-normal text-bordeaux">dès le lundi matin</em> ?
          </span>
        </h1>

        <div class="mt-8 grid gap-8 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-8">
          <span class="hidden w-px bg-dore sm:block" aria-hidden="true"></span>
          <div>
            <p class="max-w-xl text-lg leading-relaxed text-encre-douce sm:text-xl" data-reveal data-reveal-delai="1">
              Cuvée est un assistant de cave conçu pour suivre votre stock à partir de votre caisse et de vos factures,
              repérer les bouteilles qui ne tournent plus et préparer vos commandes aux domaines. Vous relisez, vous
              validez : rien ne part sans vous.
            </p>

            <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-7" data-reveal data-reveal-delai="2">
              <a href="/pilote#inscription" class="btn btn-primaire w-full sm:w-auto" data-hero-cta>Rejoindre le programme pilote</a>
              <a href="/comment-ca-marche#exemples" class="lien lien-seul">Voir un exemple concret</a>
            </div>

            <p class="mt-8 flex max-w-xl gap-3 border-t border-filet pt-5 text-[0.95rem] leading-snug text-encre-douce" data-reveal data-reveal-delai="3">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-vert" aria-hidden="true"></span>
              <span>
                Cuvée est en construction. Nous cherchons <ACompleter texte="nombre" /> bars à vin et caves à manger pour
                le mettre au point avec nous, pendant le service.
              </span>
            </p>
          </div>
        </div>
      </div>

      <div class="relative lg:pt-4" data-scene>
        <!-- La bouteille « s’ouvre » : sans JS ou en mouvement réduit, elle reste décorative et le bon est directement lisible. -->
        <div class="bouteille" data-bouteille>
          <svg viewBox="0 0 560 130" class="bouteille-svg" role="presentation" aria-hidden="true" focusable="false">
            <path
              class="verre"
              d="M26 21H318C352 21 366 52 396 54H478V76H396C366 78 352 109 318 109H26Q12 109 12 95V35Q12 21 26 21Z"
            />
            <path class="reflet" d="M34 33H300" />
            <g>
              <rect x="104" y="29" width="142" height="72" fill="#fbf8f2" stroke="#a88a4a" stroke-width="1" />
              <rect x="109" y="34" width="132" height="62" fill="none" stroke="#a88a4a" stroke-width="0.5" />
              <text x="175" y="52" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="6.5" letter-spacing="1.8" fill="#51473f">ÉDITION PILOTE</text>
              <text x="175" y="76" text-anchor="middle" font-family="Fraunces Variable, Georgia, serif" font-size="25" font-style="italic" fill="#6e1f2f">Cuvée</text>
              <text x="175" y="89" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="5.5" letter-spacing="1.4" fill="#51473f">ASSISTANT DE CAVE</text>
            </g>
            <g class="rouleau">
              <rect x="262" y="56" width="84" height="18" rx="9" fill="#fbf8f2" stroke="#a88a4a" stroke-width="1" />
              <path d="M272 60h60M272 65h48M272 70h56" stroke="#d6c8ae" stroke-width="1" />
              <rect x="294" y="55" width="6" height="20" fill="#6e1f2f" />
            </g>
            <g class="bouchon">
              <rect x="462" y="58" width="36" height="14" fill="#c9b182" />
              <rect x="498" y="53" width="20" height="24" rx="3" fill="#d8c598" stroke="#a88a4a" stroke-width="1" />
              <path d="M504 58v14M510 56v18" stroke="#a88a4a" stroke-width="0.6" />
            </g>
            <rect x="468" y="47" width="14" height="34" rx="2" fill="#a88a4a" />
            <g class="capsule-haut">
              <rect x="482" y="47" width="22" height="34" rx="2" fill="#a88a4a" />
              <path d="M486 52v24" stroke="#e9ddbf" stroke-width="1" />
            </g>
            <path class="decoupe" d="M482 45v38" />
          </svg>
          <button type="button" class="ouvrir" data-ouvrir aria-expanded="false" aria-controls="bon-hero" hidden>
            <span class="ouvrir-pastille" aria-hidden="true"></span>
            <span data-ouvrir-texte>Ouvrir la bouteille</span>
          </button>
        </div>

        <div class="bon-enveloppe relative z-10" id="bon-hero">
          <BonDeCommande />
        </div>
        <p class="surtitre mt-8 text-center text-bordeaux/80 lg:text-right" aria-hidden="true">Fig. 1 — Exemple de proposition</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-titre {
    animation: monter 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes monter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .bouteille {
    position: relative;
    margin: 0 auto 1.25rem;
    max-width: 28rem;
  }
  @media (min-width: 1024px) {
    .bouteille {
      max-width: none;
      margin-bottom: 1.5rem;
    }
    .ouvrir { margin-top: 0.5rem; }
  }
  .bouteille-svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .bouteille-svg :global(*) {
    transform-box: fill-box;
  }
  .verre {
    fill: rgb(251 248 242 / 0.35);
    stroke: #51473f;
    stroke-width: 1.3;
  }
  .reflet {
    fill: none;
    stroke: #fff;
    stroke-opacity: 0.8;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .decoupe {
    fill: none;
    stroke: #6e1f2f;
    stroke-width: 1;
    stroke-dasharray: 38;
    stroke-dashoffset: 38;
    opacity: 0;
  }
  .ouvrir {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    padding: 0.4rem 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-bordeaux);
    cursor: pointer;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--color-dore);
  }
  .ouvrir[hidden] { display: none; }
  .ouvrir:hover { color: var(--color-bordeaux-fonce); }
  .ouvrir-pastille {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-dore);
  }

  /* Le bon reste visible tant que le script n’a pas pris la main (html.anim n’existe jamais en mouvement réduit). */
  :global(html.anim) [data-scene]:not([data-etat]) .bon-enveloppe { opacity: 0; }
  [data-etat='ferme'] .bon-enveloppe { opacity: 0; }
  [data-etat='ferme'] .ouvrir-pastille { animation: respirer 2.4s ease-in-out infinite; }
  @keyframes respirer {
    50% { transform: scale(1.7); opacity: 0.5; }
  }

  /* --t0 : moment où le papier est entièrement déroulé (le bon s’écrit ensuite) */
  [data-scene] { --t0: 3.3s; }
  [data-etat='joue'] .decoupe { animation: decouper 0.9s ease-in-out 0.3s both; }
  [data-etat='joue'] .capsule-haut { animation: capsule 0.9s ease-in 1.3s both; }
  [data-etat='joue'] .bouchon { animation: bouchon 1.5s cubic-bezier(0.5, 0, 0.3, 1) 1.5s both; }
  [data-etat='joue'] .rouleau { animation: rouleau 1.3s cubic-bezier(0.4, 0, 0.2, 1) 2.3s both; }
  [data-etat='joue'] .bon-enveloppe { animation: derouler 1.4s cubic-bezier(0.3, 0.6, 0.2, 1) 2.9s both; }
  [data-etat='fini'] .capsule-haut,
  [data-etat='fini'] .bouchon,
  [data-etat='fini'] .rouleau { opacity: 0; }

  @keyframes decouper {
    0% { stroke-dashoffset: 38; opacity: 1; }
    80% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes capsule {
    to { transform: translate(10px, -16px) rotate(14deg); opacity: 0; }
  }
  @keyframes bouchon {
    0% { transform: translate(0, 0); opacity: 1; }
    25% { transform: translate(4px, 0); }
    70% { transform: translate(40px, -6px) rotate(-4deg); opacity: 1; }
    100% { transform: translate(52px, -10px) rotate(-6deg); opacity: 0; }
  }
  @keyframes rouleau {
    0% { transform: translateX(0); opacity: 1; }
    70% { transform: translateX(150px); opacity: 1; }
    100% { transform: translateX(176px) translateY(8px); opacity: 0; }
  }
  @keyframes derouler {
    from {
      opacity: 0;
      clip-path: inset(0 -14px 100% -14px);
      transform: translateY(-14px);
    }
    15% { opacity: 1; }
    to {
      opacity: 1;
      clip-path: inset(-14px -14px -18px -14px);
      transform: none;
    }
  }
</style>

<script>
  import '../scripts/accueil-bouteille.ts';
</script>
