---
import Base from '../layouts/Base.astro';
import EnTete from '../components/maison/EnTete.astro';
import PiedDePage from '../components/maison/PiedDePage.astro';
import { navigation } from '../data/site';
---
<Base titre="Page introuvable · Cuvée" description="Cette page n’existe pas.">
  <EnTete />
  <main id="contenu">
    <section class="media-cadre voile sur-image relative isolate flex min-h-[100svh] flex-col text-creme" aria-labelledby="page-titre">
      <img src="/media/cave-voutee.jpg" alt="" fetchpriority="high" decoding="async" />
      <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-5 pt-32 pb-20 text-center sm:px-8">
        <p class="surtitre text-creme/90" data-reveal>Erreur 404</p>
        <h1 id="page-titre" class="mt-6 max-w-3xl text-[clamp(2rem,5vw,4rem)]" data-reveal-lignes>
          Cette référence n’est pas en cave.
        </h1>
        <span class="signature mt-4" data-reveal data-reveal-delai="3">introuvable</span>
        <p class="mt-8 max-w-md text-lg text-creme/90" data-reveal data-reveal-delai="4">
          La page que vous cherchez n’existe pas ou a été déplacée.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal data-reveal-delai="5">
          <a href="/" class="btn btn-primaire">Retour à l’accueil</a>
        </div>
        <nav class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-1" aria-label="Autres pages" data-reveal data-reveal-delai="6">
          {navigation.filter((n) => n.href !== '/').map((n) => <a href={n.href} class="lien-cap text-creme/90">{n.libelle}</a>)}
        </nav>
      </div>
    </section>
  </main>
  <PiedDePage />
</Base>

<style>
  section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(42 34 32 / 0.3);
    pointer-events: none;
  }
</style>
