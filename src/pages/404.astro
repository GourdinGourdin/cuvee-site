---
import Base from '../layouts/Base.astro';
import EnTete from '../components/maison/EnTete.astro';
import PiedDePage from '../components/maison/PiedDePage.astro';
---
<Base titre="Page introuvable · Cuvée" description="Cette page n’existe pas.">
  <EnTete />
  <main id="contenu" class="entete-page">
   <span class="entete-chiffre" aria-hidden="true">404</span>
   <div class="conteneur relative py-20 lg:py-28">
    <p class="surtitre flex items-center gap-3 text-bordeaux" data-reveal><span>Erreur 404</span><span class="entete-filet-page h-px w-14 bg-dore" aria-hidden="true"></span></p>
    <h1 class="mt-5 max-w-2xl text-[2.5rem] leading-[1.05] font-medium tracking-[-0.02em] sm:text-6xl" data-reveal-lignes data-reveal>
      Cette référence n’est pas <em class="text-bordeaux">en cave</em>.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-encre-douce">La page que vous cherchez n’existe pas ou a été déplacée.</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/" class="btn btn-primaire">Retour à l’accueil</a>
      <a href="/comment-ca-marche" class="lien lien-seul">Comment ça marche</a>
      <a href="/pilote" class="lien lien-seul">Le pilote</a>
      <a href="/questions" class="lien lien-seul">Questions</a>
    </div>
   </div>
  </main>
  <PiedDePage />
</Base>
