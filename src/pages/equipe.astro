---
import Base from '../layouts/Base.astro';
import EnTete from '../components/maison/EnTete.astro';
import PiedDePage from '../components/maison/PiedDePage.astro';
import CtaMobile from '../components/CtaMobile.astro';
import PageEntete from '../components/PageEntete.astro';
import Equipe from '../components/Equipe.astro';
import PagePourquoi from '../components/PagePourquoi.astro';
import PageCta from '../components/PageCta.astro';
---
<Base titre="L’équipe · Cuvée" description="Qui construit Cuvée, et pourquoi : l’équipe derrière l’assistant de cave pour bars à vin et caves à manger.">
  <EnTete />
  <main id="contenu">
    <PageEntete surtitre="L’équipe" titre="Qui construit Cuvée" signature="des personnes, pas un logo" chapo="Un projet porté par des personnes, pas par un logo. Voici qui nous sommes et ce qui nous pousse." image="/media/comptoir-soir.jpg" numero="IV" vt="media-equipe" />
    <Equipe />
    <PagePourquoi />
    <PageCta />
  </main>
  <PiedDePage />
  <CtaMobile />
</Base>

