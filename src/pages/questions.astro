---
import Base from '../layouts/Base.astro';
import EnTete from '../components/maison/EnTete.astro';
import PiedDePage from '../components/maison/PiedDePage.astro';
import CtaMobile from '../components/CtaMobile.astro';
import PageEntete from '../components/PageEntete.astro';
import PageCta from '../components/PageCta.astro';
import FAQ from '../components/FAQ.astro';
---
<Base titre="Questions fréquentes sur le pilote et la cave · Cuvée" description="Données, tarif, intégration à la caisse, contrôle des commandes : les réponses franches aux questions à poser avant de rejoindre le pilote Cuvée.">
  <EnTete />
  <main id="contenu">
    <PageEntete surtitre="Questions" titre="Ce que l’on nous demande avant de s’inscrire" chapo="Données, caisse, tarif, contrôle : les réponses franches, y compris sur ce que Cuvée ne fait pas encore." image="/media/cave-futs.jpg" numero="V" />
    <FAQ />
    <PageCta image="/media/mur-bouteilles.jpg" />
  </main>
  <PiedDePage />
  <CtaMobile />
</Base>

