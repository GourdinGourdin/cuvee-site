---
import Base from '../layouts/Base.astro';
import EnTete from '../components/maison/EnTete.astro';
import PiedDePage from '../components/maison/PiedDePage.astro';
import CtaMobile from '../components/CtaMobile.astro';
import PageEntete from '../components/PageEntete.astro';
import Pilote from '../components/Pilote.astro';
---
<Base titre="Le programme pilote : rejoignez les premiers lieux · Cuvée" description="Rejoignez le programme pilote de Cuvée, assistant de cave pour bars à vin et caves à manger : ce que nous proposons, ce que nous attendons, inscription.">
  <EnTete />
  <main id="contenu">
    <PageEntete
      surtitre="Programme pilote"
      titre="Construire Cuvée avec les premiers lieux"
      chapo="Nous cherchons quelques bars à vin et caves à manger indépendants pour essayer Cuvée, dire ce qui manque et façonner le produit."
      image="/media/assiette-ardoise.jpg"
      numero="III"
      vt="media-pilote"
    />
    <Pilote />
  </main>
  <PiedDePage />
  <CtaMobile />
</Base>
