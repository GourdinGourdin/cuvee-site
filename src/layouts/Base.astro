---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource-variable/outfit/wght.css';
import '@fontsource-variable/josefin-sans/wght.css';
import '@fontsource/mr-dafoe/400.css';
import '../styles/global.css';
import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import sourceSansWoff2 from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import { site } from '../data/site';

interface Props {
  titre?: string;
  description?: string;
}

const { titre = site.titre, description = site.description } = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site);
const imageOg = new URL('/og-image.png', Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!site.indexable && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cuvée : moins de bouteilles qui dorment, moins d’heures sur les commandes." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5e9e4" />

    <script is:inline>
      // Test de message : ?v=b affiche le second titre du hero. Posé avant le rendu, sans clignotement.
      document.documentElement.dataset.variante =
        new URLSearchParams(window.location.search).get('v') === 'b' ? 'b' : 'a';
    </script>

    <script is:inline>
      // Animations : classe posée seulement si JS actif et mouvement autorisé. Sans elle, tout reste visible.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim');
        // filet de sécurité : si le script d'animation n'a pas démarré, on rend tout visible
        setTimeout(function () {
          if (!document.documentElement.classList.contains('anim-pret')) document.documentElement.classList.remove('anim');
        }, 3000);
      }
    </script>

    <link rel="preload" href={frauncesWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSansWoff2} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-creme font-sans text-encre antialiased">
    <a href="#contenu" class="lien-evitement">Aller au contenu</a>
    <slot />
    <script>
      import '../scripts/animations.ts';
    </script>
  </body>
</html>
