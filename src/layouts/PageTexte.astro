---
import Base from './Base.astro';
import EnTete from '../components/maison/EnTete.astro';
import PiedDePage from '../components/maison/PiedDePage.astro';
import PageEntete from '../components/PageEntete.astro';

interface Props {
  titre: string;
  description: string;
  surtitre: string;
  /** titre de l’onglet et des moteurs de recherche (par défaut : « titre · Cuvée ») */
  titreSeo?: string;
}
const { titre, description, surtitre, titreSeo } = Astro.props;
---
<Base titre={titreSeo ?? `${titre} · Cuvée`} description={description}>
  <EnTete />
  <main id="contenu">
    <PageEntete surtitre={surtitre} titre={titre} image="/media/cave-voutee.jpg" compact />
    <div class="section bg-creme">
      <div class="conteneur-etroit lecture">
        <slot />
      </div>
    </div>
  </main>
  <PiedDePage />
</Base>

<style>
  /* Mise en page de texte long : mesure ≤ 65ch, titres de la charte (h2 un cran plus petit que sur les pages
     de présentation, pour que les intitulés longs des mentions légales tiennent sur une à deux lignes). */
  .lecture {
    color: var(--color-encre-douce);
  }
  .lecture :global(h2) {
    position: relative;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem);
    max-width: 30ch;
    text-wrap: balance;
  }
  .lecture :global(h2)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3.5rem;
    height: 2px;
    background: var(--color-dore);
  }
  .lecture :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
  }
  .lecture :global(h2:first-child)::before {
    display: none;
  }
  .lecture :global(h3) {
    margin-top: var(--space-6);
  }
  .lecture :global(h2 + p),
  .lecture :global(h2 + ul),
  .lecture :global(h3 + p),
  .lecture :global(h3 + ul) {
    margin-top: var(--space-4);
  }
  .lecture :global(p),
  .lecture :global(ul),
  .lecture :global(ol) {
    max-width: 65ch;
    margin-top: var(--space-4);
  }
  .lecture :global(ul) {
    list-style: none;
    padding-left: var(--space-5);
  }
  .lecture :global(li) {
    position: relative;
  }
  .lecture :global(li)::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: 0.85em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-dore-texte);
  }
  .lecture :global(li + li) {
    margin-top: var(--space-2);
  }
  .lecture :global(a) {
    color: var(--color-bordeaux);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-dore-texte);
    text-underline-offset: 0.22em;
    transition: text-decoration-color var(--duree-2) ease;
  }
  .lecture :global(a:hover),
  .lecture :global(a:focus-visible) {
    text-decoration-color: currentColor;
  }
  .lecture :global(strong) {
    color: var(--color-encre);
    font-weight: 600;
  }
</style>
